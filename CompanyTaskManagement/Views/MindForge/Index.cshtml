</div>

@section Scripts {
<script>
// ============================================================
// GAME 1: MEMORY MATCH
// ============================================================
const memEmojis = ['🚀','💡','🎯','🔥','⚡','🎨','🌟','💎'];
let memFlipped = [], memMatched = 0, memMoves = 0, memLock = false;

function initMemory() {
    const emojis = [...memEmojis, ...memEmojis].sort(() => Math.random() - 0.5);
    memFlipped = []; memMatched = 0; memMoves = 0; memLock = false;
    document.getElementById('memScore').textContent = 'Pairs: 0';
    document.getElementById('memMoves').textContent = 'Moves: 0';
    document.getElementById('memMsg').textContent = '';
    const cards = document.querySelectorAll('#memoryGrid .mem-card');
    cards.forEach((card, i) => {
        const emoji = emojis[i];
        card.dataset.emoji = emoji;
        card.className = 'mem-card';
        card.querySelector('.mem-back').textContent = emoji;
    });
}

function memFlip(card) {
    if (memLock || card.classList.contains('flipped') || card.classList.contains('matched')) return;
    card.classList.add('flipped');
    memFlipped.push(card);
    if (memFlipped.length === 2) {
        memLock = true; memMoves++;
        document.getElementById('memMoves').textContent = 'Moves: ' + memMoves;
        if (memFlipped[0].dataset.emoji === memFlipped[1].dataset.emoji) {
            memFlipped.forEach(c => c.classList.add('matched'));
            memMatched++;
            document.getElementById('memScore').textContent = 'Pairs: ' + memMatched;
            memFlipped = []; memLock = false;
            if (memMatched === memEmojis.length) {
                const calcScore = Math.max(100, 300 - (memMoves * 5));
                document.getElementById('memMsg').innerHTML = '🎉 Done in ' + memMoves + ' moves! <strong>+' + calcScore + ' pts</strong>';
                submitScoreToDatabase('MemoryMatch', calcScore, memMoves * 2);
            }
        } else {
            setTimeout(() => {
                memFlipped.forEach(c => c.classList.remove('flipped'));
                memFlipped = []; memLock = false;
            }, 900);
        }
    }
}

// ============================================================
// GAME 2: WORD SCRAMBLE
// ============================================================
const wordList = [
    {word:'DEVELOPER', hint:'Someone who writes code'},
    {word:'DEADLINE', hint:'When work must be done'},
    {word:'PROJECT', hint:'A planned undertaking'},
    {word:'MEETING', hint:'Team discussion session'},
    {word:'FEEDBACK', hint:'Reaction to someone\'s work'},
    {word:'STRATEGY', hint:'Plan of action for goals'},
    {word:'AGILE', hint:'Flexible software method'},
    {word:'DATABASE', hint:'Where data is stored'},
    {word:'PIPELINE', hint:'CI/CD workflow term'},
    {word:'FRONTEND', hint:'The visible part of an app'},
    {word:'BACKEND',  hint:'The server-side logic'},
    {word:'EMPLOYEE', hint:'Person working for company'},
    {word:'MANAGER',  hint:'Team leader role'},
    {word:'SPRINT',   hint:'Short work cycle in Agile'},
    {word:'DEPLOYMENT',hint:'Releasing software to servers'},
    {word:'ALGORITHM', hint:'Step-by-step problem solution'},
];
let wordIndex = 0, wordScore = 0, wordOrder = [];

function initWord() {
    wordOrder = [...wordList].sort(() => Math.random() - 0.5);
    wordIndex = 0; wordScore = 0;
    document.getElementById('wordScore').textContent = 'Score: 0';
    nextWord();
}

function nextWord() {
    if (wordIndex >= wordOrder.length) wordIndex = 0;
    const {word, hint} = wordOrder[wordIndex++];
    document.getElementById('wordHint').textContent = `💡 Hint: ${hint}`;
    document.getElementById('scrambledWord').textContent = scramble(word);
    document.getElementById('scrambledWord').dataset.answer = word;
    const inp = document.getElementById('wordInput');
    inp.value = '';
    inp.className = 'word-input mb-3';
    document.getElementById('wordMsg').textContent = '';
    inp.focus();
}

function scramble(w) {
    let a = w.split('');
    do { a.sort(() => Math.random() - 0.5); } while (a.join('') === w);
    return a.join(' ');
}

function checkWord() {
    const inp = document.getElementById('wordInput');
    const guess = inp.value.trim().toUpperCase();
    const answer = document.getElementById('scrambledWord').dataset.answer;
    const msg = document.getElementById('wordMsg');
    if (guess === answer) {
        inp.className = 'word-input mb-3 correct';
        msg.innerHTML = `<span class="text-success">✅ Correct! The word was <strong>${answer}</strong></span>`;
        wordScore += 100;
        document.getElementById('wordScore').textContent = `Score: ${wordScore}`;
        document.getElementById('scrambledWord').classList.add('celebrate');
        submitScoreToDatabase('WordScramble', 100, 15);
        setTimeout(() => { document.getElementById('scrambledWord').classList.remove('celebrate'); nextWord(); }, 1400);
    } else {
        inp.className = 'word-input mb-3 wrong';
        msg.innerHTML = `<span class="text-danger">❌ Try again!</span>`;
        setTimeout(() => { inp.className = 'word-input mb-3'; msg.textContent = ''; }, 800);
    }
}

document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('wordInput').addEventListener('keydown', e => { if (e.key === 'Enter') checkWord(); });
});

// ============================================================
// GAME 3: .NET CODE CHALLENGE
// ============================================================
const dotnetQs = [
  { code: `<span class="kw">var</span> nums = <span class="kw">new</span> <span class="cls">List</span>&lt;<span class="kw">int</span>&gt; { 1, 2, 3, 4, 5 };
<span class="kw">var</span> result = nums.<span class="cls">Where</span>(x => x % 2 == 0).<span class="cls">Sum</span>();
