};
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(r);`, answer:'mid', options:['mid','low','high','Error'], explain:'10 < 15 matches "mid".' },
  { code: `<span class="kw">var</span> nums = <span class="cls">Enumerable</span>.<span class="cls">Range</span>(<span class="num">1</span>, <span class="num">5</span>);
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(nums.<span class="cls">Average</span>());`, answer:'3', options:['3','2.5','4','15'], explain:'(1+2+3+4+5)/5 = 3.' },
  { code: `<span class="kw">string</span> s = <span class="str">"abcdef"</span>;
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(s.<span class="cls">Substring</span>(<span class="num">2</span>, <span class="num">3</span>));`, answer:'cde', options:['cde','bcd','cdef','abc'], explain:'Substring(2,3): start at index 2, length 3 = "cde".' },
  { code: `<span class="kw">int</span>? val = <span class="kw">null</span>;
<span class="kw">int</span> result = val ?? <span class="num">42</span>;
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(result);`, answer:'42', options:['42','0','null','Error'], explain:'?? returns 42 when val is null.' },
  { code: `<span class="kw">var</span> words = <span class="kw">new</span>[] { <span class="str">"hi"</span>, <span class="str">"hello"</span>, <span class="str">"hey"</span> };
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(<span class="kw">string</span>.<span class="cls">Join</span>(<span class="str">"-"</span>, words));`, answer:'hi-hello-hey', options:['hi-hello-hey','hi hello hey','hihellohey','hi,hello,hey'], explain:'string.Join joins with "-" separator.' },
  { code: `<span class="kw">var</span> stk = <span class="kw">new</span> <span class="cls">Stack</span>&lt;<span class="kw">int</span>&gt;();
stk.<span class="cls">Push</span>(<span class="num">1</span>); stk.<span class="cls">Push</span>(<span class="num">2</span>); stk.<span class="cls">Push</span>(<span class="num">3</span>);
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(stk.<span class="cls">Pop</span>());`, answer:'3', options:['3','1','2','0'], explain:'Stack is LIFO — Pop returns last pushed = 3.' },
  { code: `<span class="kw">var</span> q = <span class="kw">new</span> <span class="cls">Queue</span>&lt;<span class="kw">string</span>&gt;();
q.<span class="cls">Enqueue</span>(<span class="str">"A"</span>); q.<span class="cls">Enqueue</span>(<span class="str">"B"</span>);
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(q.<span class="cls">Dequeue</span>());`, answer:'A', options:['A','B','null','Error'], explain:'Queue is FIFO — Dequeue returns first = "A".' },
  { code: `<span class="kw">var</span> nums = <span class="kw">new</span> <span class="cls">List</span>&lt;<span class="kw">int</span>&gt; { 5, 3, 9, 1 };
nums.<span class="cls">Sort</span>();
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(nums[<span class="num">0</span>]);`, answer:'1', options:['1','5','3','9'], explain:'After Sort(), first element is 1.' },
  { code: `<span class="kw">bool</span> r = <span class="str">"hello"</span>.<span class="cls">StartsWith</span>(<span class="str">"he"</span>) && <span class="str">"world"</span>.<span class="cls">EndsWith</span>(<span class="str">"ld"</span>);
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(r);`, answer:'True', options:['True','False','Error','null'], explain:'Both conditions true → True.' },
  { code: `<span class="kw">var</span> nums = <span class="cls">Enumerable</span>.<span class="cls">Range</span>(<span class="num">1</span>, <span class="num">10</span>);
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(nums.<span class="cls">Count</span>(x => x % 3 == 0));`, answer:'3', options:['3','4','2','10'], explain:'Multiples of 3 in 1-10: 3,6,9 → 3.' },
  { code: `<span class="kw">string</span> s = <span class="str">"  trim me  "</span>;
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(s.<span class="cls">Trim</span>().<span class="cls">Length</span>);`, answer:'7', options:['7','11','9','6'], explain:'"trim me" has 7 chars after trim.' },
  { code: `<span class="kw">int</span> a = <span class="num">5</span>, b = <span class="num">2</span>;
<span class="cls">Console</span>.<span class="cls">WriteLine</span>($<span class="str">"{a / b} rem {a % b}"</span>);`, answer:'2 rem 1', options:['2 rem 1','2.5 rem 0','2 rem 0','3 rem 1'], explain:'Integer division: 5/2=2, 5%2=1.' },
  { code: `<span class="kw">var</span> nums = <span class="kw">new</span> <span class="cls">List</span>&lt;<span class="kw">int</span>&gt; { 1, 2, 3 };
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(nums.<span class="cls">Select</span>(x => x * x).<span class="cls">Max</span>());`, answer:'9', options:['9','6','3','8'], explain:'Squares: 1,4,9 → Max = 9.' },
  { code: `<span class="kw">var</span> a = <span class="kw">new</span>[] { 1, 2, 3 };
