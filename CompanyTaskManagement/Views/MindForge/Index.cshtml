@model CompanyTaskManagement.ViewModels.MindForgePageViewModel
@{
    ViewData["Title"] = "MindForge – Employee Brain Games";
}
<style>
    :root {
        --mf-primary: #4f46e5;
        --mf-primary-dark: #4338ca;
        --mf-accent: #f59e0b;
        --mf-glow: rgba(99,102,241,0.28);
        --mf-card-bg: var(--bs-body-bg);
    }

    .mf-hero {
        background: linear-gradient(135deg, #312e81 0%, #4338ca 50%, #6366f1 100%);
        border-radius: 18px;
        position: relative;
        overflow: hidden;
        color: white;
        border: 1.5px solid #818cf8;
        box-shadow: 0 16px 36px -4px rgba(99, 102, 241, 0.35);
    }
    .mf-hero::before {
        content: '';
        position: absolute;
        top: -80px; right: -80px;
        width: 320px; height: 320px;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
        pointer-events: none;
    }
    .mf-hero::after {
        content: '';
        position: absolute;
        bottom: -60px; left: -60px;
        width: 240px; height: 240px;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
        pointer-events: none;
    }

    .game-card {
        border-radius: 18px;
        border: 1.5px solid rgba(99,102,241,0.18);
        background: var(--mf-card-bg);
        box-shadow: 0 6px 20px -2px rgba(99,102,241,0.08), 0 2px 8px -1px rgba(0,0,0,0.04);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 480px;
    }
    .game-card:hover { 
        transform: translateY(-4px); 
        box-shadow: 0 16px 36px -4px rgba(99,102,241,0.22); 
        border-color: #6366f1; 
    }

    .game-header {
        background: linear-gradient(135deg, #312e81 0%, #4338ca 50%, #6366f1 100%);
        color: white;
        padding: 0.85rem 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 2px solid #818cf8;
        min-height: 68px;
    }
    .game-header-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(4px);
        flex-shrink: 0;
    }

    .game-card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.25rem 1.35rem;
    }
    .game-card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .game-card-footer {
        margin-top: auto;
        padding-top: 0.85rem;
        border-top: 1px solid rgba(99, 102, 241, 0.12);
        width: 100%;
    }

    /* ===== MEMORY GAME ===== */
    .memory-grid { 
        display: grid; 
        grid-template-columns: repeat(4, 56px); 
        grid-template-rows: repeat(4, 56px);
        gap: 8px; 
        width: fit-content;
        margin: 0 auto; 
    }
    .mem-card {
        width: 56px;
        height: 56px;
        cursor: pointer;
        perspective: 800px;
        display: block;
    }
    .mem-card-inner {
        width: 56px;
        height: 56px;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 10px;
    }
    .mem-card.flipped .mem-card-inner,
    .mem-card.matched .mem-card-inner { transform: rotateY(180deg); }
    .mem-card.matched .mem-back { box-shadow: 0 0 0 2.5px #10b981; }
    .mem-front, .mem-back {
        position: absolute;
        width: 56px;
        height: 56px;
        border-radius: 10px;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        user-select: none;
    }
    .mem-front { 
        background: linear-gradient(135deg, #6366f1, #4338ca); 
        color: white;
        box-shadow: 0 3px 10px rgba(99,102,241,0.3);
    }
    .mem-front::after { content: '?'; font-size: 1.25rem; font-weight: 900; opacity: 0.85; color: #fff; }
    .mem-back { 
        background: #fff;
        transform: rotateY(180deg);
        border: 2px solid #e0e7ff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }
    [data-bs-theme="dark"] .mem-back { background: #1e1b4b; border-color: rgba(99,102,241,0.3); }

    /* ===== WORD SCRAMBLE ===== */
    .scrambled-word {
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: 0.35rem;
        color: #4f46e5;
        font-family: 'JetBrains Mono', monospace;
        text-shadow: 0 2px 10px rgba(79, 70, 229, 0.15);
    }
    [data-bs-theme="dark"] .scrambled-word {
        color: #818cf8;
        text-shadow: 0 2px 10px rgba(129, 140, 248, 0.3);
    }
    .word-input {
        font-size: 1rem;
        text-align: center;
        letter-spacing: 0.15rem;
        font-family: 'JetBrains Mono', monospace;
        border-radius: 10px;
        border: 2px solid #6366f1;
        padding: 0.45rem 0.85rem;
        max-width: 290px;
        margin: 0 auto;
        width: 100%;
        transition: border-color 0.2s, box-shadow 0.2s;
        background: var(--mf-card-bg);
        color: inherit;
    }
    .word-input:focus { outline: none; border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,0.2); }
    .word-input.correct { border-color: #10b981; background: rgba(16,185,129,0.08); }
    .word-input.wrong { border-color: #ef4444; background: rgba(239,68,68,0.08); animation: shake 0.4s; }

    /* ===== .NET CODE CHALLENGE ===== */
    .dotnet-code-block {
        background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
        border-radius: 10px;
        padding: 0.5rem 0.85rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.76rem;
        color: #1e1b4b;
        line-height: 1.45;
        text-align: left;
        border: 1.5px solid #a5b4fc;
        box-shadow: 0 2px 8px rgba(99,102,241,0.06);
        white-space: pre;
        overflow-x: auto;
        height: 75px;
        max-height: 75px;
    }
    [data-bs-theme="dark"] .dotnet-code-block {
        background: rgba(99,102,241,0.12);
        color: #c7d2fe;
        border-color: rgba(99,102,241,0.35);
    }
    .dotnet-code-block .kw  { color: #4338ca; font-weight: bold; }
    .dotnet-code-block .str { color: #b45309; }
    .dotnet-code-block .num { color: #c2410c; }
    .dotnet-code-block .cls { color: #1d4ed8; font-weight: bold; }
    [data-bs-theme="dark"] .dotnet-code-block .kw  { color: #a5b4fc; }
    [data-bs-theme="dark"] .dotnet-code-block .str { color: #fde047; }
    [data-bs-theme="dark"] .dotnet-code-block .num { color: #fb923c; }
    [data-bs-theme="dark"] .dotnet-code-block .cls { color: #93c5fd; }
    .dotnet-opt-btn {
        width: 100%; text-align: left;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        border: 1.5px solid rgba(99,102,241,0.22);
        background: var(--mf-card-bg);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.76rem;
        cursor: pointer;
        transition: all 0.15s;
        font-weight: 600;
    }
    .dotnet-opt-btn:hover:not(:disabled) { border-color: #4f46e5; background: rgba(99,102,241,0.08); transform: translateX(3px); }
    .dotnet-opt-btn.opt-correct { border-color: #10b981 !important; background: rgba(16,185,129,0.12) !important; color: #047857 !important; }
    .dotnet-opt-btn.opt-wrong   { border-color: #ef4444 !important; background: rgba(239,68,68,0.12) !important; color: #ef4444 !important; }
    .dotnet-timer-bar { height: 5px; border-radius: 99px; background: linear-gradient(90deg,#6366f1,#a5b4fc); transition: width 1s linear; }

    /* ===== TIC TAC TOE ===== */
    .ttt-board {
        display: grid;
        grid-template-columns: repeat(3, 58px);
        grid-template-rows: repeat(3, 58px);
        gap: 10px;
        width: fit-content;
        margin: 0.5rem auto;
    }
    .ttt-cell {
        width: 58px;
        height: 58px;
        min-width: 58px;
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        font-weight: 900;
        border-radius: 12px;
        background: rgba(99, 102, 241, 0.08);
        border: 2px solid rgba(99, 102, 241, 0.25);
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
        color: #4f46e5;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    }
    [data-bs-theme="dark"] .ttt-cell {
        background: rgba(99, 102, 241, 0.18) !important;
        border-color: rgba(99, 102, 241, 0.4) !important;
        color: #a5b4fc !important;
    }
    .ttt-cell:hover:not(.taken) {
        background: rgba(99, 102, 241, 0.2) !important;
        border-color: #6366f1 !important;
        transform: scale(1.06);
    }
    .ttt-cell.taken { cursor: default; }
    .ttt-cell.win-cell {
        background: rgba(16, 185, 129, 0.25) !important;
        border-color: #10b981 !important;
        color: #10b981 !important;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.4) !important;
    }

    /* ===== SCORE BADGES ===== */
    .score-badge {
        background: linear-gradient(135deg, #6366f1, #4338ca);
        color: white;
        border-radius: 50px;
        padding: 0.22rem 0.75rem;
        font-weight: 700;
        font-family: 'Plus Jakarta Sans', system-ui, monospace;
        font-size: 0.76rem;
        box-shadow: 0 2px 6px rgba(99,102,241,0.25);
    }
    .btn-mf {
        background: linear-gradient(135deg, #6366f1, #4338ca);
        color: white;
        border: none;
        border-radius: 9px;
        padding: 0.38rem 1rem;
        font-weight: 700;
        font-size: 0.8rem;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .btn-mf:hover { opacity: 0.95; transform: translateY(-1px); color: white; box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35); }
    .btn-mf-gold {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white; border: none; border-radius: 9px;
        padding: 0.38rem 1rem; font-weight: 700;
        font-size: 0.8rem;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .btn-mf-gold:hover { opacity: 0.95; transform: translateY(-1px); color: white; box-shadow: 0 6px 16px rgba(245, 158, 11, 0.35); }

    @@keyframes shake {
        0%,100%{transform:translateX(0)} 25%{transform:translateX(-8px)} 75%{transform:translateX(8px)}
    }
    @@keyframes bounce { 0%,100%{transform:scale(1)} 50%{transform:scale(1.12)} }
    .celebrate { animation: bounce 0.5s ease 3; }
</style>

<!-- ===== HERO ===== -->
<div class="mf-hero mb-4 p-3.5 p-lg-4">
    <div class="row align-items-center position-relative" style="z-index:2;">
        <div class="col-12 col-lg-8">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge text-dark fw-bold px-2.5 py-1 rounded-pill shadow-xs" style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);"><i class="bi bi-controller me-1"></i>MindForge</span>
                <span class="badge rounded-pill px-2.5 py-1 shadow-sm" style="background: rgba(255,255,255,0.18); color: #ffffff; font-weight: 700; border: 1px solid rgba(255,255,255,0.35);">Brain Recharge Zone</span>
            </div>
            <h2 class="fw-black text-white mb-1.5" style="font-family:'Outfit',sans-serif; font-size:clamp(1.35rem, 2.2vw, 1.75rem);">
                🧠 MindForge – Recharge Your Brain
            </h2>
            <p class="text-white opacity-90 mb-0" style="max-width: 640px; font-size: 0.88rem; line-height: 1.5;">
                Take a quick break and flex your mind with puzzles, word games &amp; more. Built for the Auxinzio team to refresh, refocus &amp; have fun.
            </p>
        </div>
        <div class="col-12 col-lg-4 text-lg-end mt-3 mt-lg-0">
            <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                <span class="badge px-2.5 py-1.5 rounded-pill shadow-sm" style="background: rgba(255,255,255,0.18); color: #ffffff; font-weight: 700; border: 1px solid rgba(255,255,255,0.35); font-size: 0.82rem;">
                    <i class="bi bi-lightning-charge-fill me-1 text-warning"></i>4 Games
                </span>
                <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill fw-bold shadow-xs" style="font-size: 0.82rem;">
                    <i class="bi bi-stars me-1"></i>No logins needed
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ===== GAME GRID ===== -->
<div class="row g-4 align-items-stretch">

    <!-- ===== GAME 1: MEMORY MATCH ===== -->
    <div class="col-12 col-lg-6 d-flex">
        <div class="game-card w-100">
            <div class="game-header">
                <div class="game-header-icon">
                    <i class="bi bi-grid-3x3-gap-fill fs-5 text-warning"></i>
                </div>
                <div>
                    <div class="fw-bold fs-5">Memory Match</div>
                    <div class="opacity-75 small">Flip cards &amp; find matching pairs</div>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="score-badge" id="memScore">Pairs: 0</span>
                    <span class="score-badge" id="memMoves">Moves: 0</span>
                </div>
            </div>
            <div class="game-card-body">
                <div class="game-card-content py-2 d-flex align-items-center justify-content-center">
                    <div class="memory-grid" id="memoryGrid">
                        <div class="mem-card" data-emoji="" data-index="0" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="1" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="2" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="3" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="4" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="5" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="6" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="7" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="8" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="9" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="10" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="11" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="12" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="13" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="14" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                        <div class="mem-card" data-emoji="" data-index="15" onclick="memFlip(this)"><div class="mem-card-inner"><div class="mem-front"></div><div class="mem-back"></div></div></div>
                    </div>
                </div>
                <div class="game-card-footer d-flex justify-content-between align-items-center">
                    <div id="memMsg" class="small fw-semibold" style="color:#10b981;"></div>
                    <button class="btn-mf ms-auto" onclick="initMemory()"><i class="bi bi-arrow-clockwise me-1"></i>New Game</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== GAME 2: WORD SCRAMBLE ===== -->
    <div class="col-12 col-lg-6 d-flex">
        <div class="game-card w-100">
            <div class="game-header">
                <div class="game-header-icon">
                    <i class="bi bi-alphabet fs-5 text-info"></i>
                </div>
                <div>
                    <div class="fw-bold fs-5">Word Scramble</div>
                    <div class="opacity-75 small">Unscramble the hidden word</div>
                </div>
                <div class="ms-auto">
                    <span class="score-badge" id="wordScore">Score: 0</span>
                </div>
            </div>
            <div class="game-card-body text-center">
                <div class="game-card-content py-2">
                    <div class="mb-2">
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill small fw-semibold" id="wordHint">💡 Hint: ...</span>
                    </div>
                    <div class="scrambled-word my-2" id="scrambledWord">------</div>
                    <div class="my-2">
                        <input class="word-input" id="wordInput" type="text" placeholder="Type your answer..." autocomplete="off" maxlength="20" />
                    </div>
                    <div id="wordMsg" class="fw-bold mt-1" style="min-height:1.4rem;"></div>
                </div>
                <div class="game-card-footer d-flex gap-2 justify-content-center">
                    <button class="btn-mf px-4" onclick="checkWord()"><i class="bi bi-check-lg me-1"></i>Submit</button>
                    <button class="btn-mf-gold px-3" onclick="nextWord()"><i class="bi bi-skip-forward-fill me-1"></i>Skip</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== GAME 3: .NET CODE CHALLENGE ===== -->
    <div class="col-12 col-lg-6 d-flex">
        <div class="game-card w-100">
            <div class="game-header">
                <div class="game-header-icon">
                    <i class="bi bi-braces fs-5" style="color:#c4b5fd;"></i>
                </div>
                <div>
                    <div class="fw-bold fs-5">.NET Code Challenge</div>
                    <div class="opacity-75 small">What does this C# code output?</div>
                </div>
                <div class="ms-auto d-flex gap-2 align-items-center">
                    <span class="score-badge" id="dotnetScore">Score: 0</span>
                    <span class="score-badge" id="dotnetStreak" style="background:linear-gradient(135deg,#d97706,#f59e0b);">🔥 0</span>
                </div>
            </div>
            <div class="game-card-body">
                <div class="game-card-content py-1">
                    <div style="background:rgba(109,40,217,0.1);border-radius:99px;height:5px;margin-bottom:0.5rem;">
                        <div class="dotnet-timer-bar" id="dotnetTimerBar" style="width:100%;"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1.5">
                        <span class="small text-muted fw-bold" id="dotnetQNum">Q 1 / 20</span>
                        <span class="small fw-bold px-2 py-0.5 rounded-pill bg-primary bg-opacity-10 text-primary" id="dotnetTimerLabel">⏱ 30s</span>
                    </div>
                    <div class="dotnet-code-block mb-2" id="dotnetCode"></div>
                    <div class="d-grid gap-1 mb-1.5" id="dotnetOptions"></div>
                    <div class="fw-bold text-center" id="dotnetMsg" style="min-height:1.3rem;font-size:0.85rem;"></div>
                </div>
                <div class="game-card-footer d-flex justify-content-between align-items-center">
                    <span class="small text-muted fst-italic text-truncate pe-2" id="dotnetExplain" style="max-width: 75%;"></span>
                    <button class="btn-mf ms-auto" onclick="dotnetNext()" id="dotnetNextBtn" style="display:none;padding:0.35rem 0.9rem;font-size:0.8rem;">Next <i class="bi bi-arrow-right ms-1"></i></button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== GAME 4: TIC TAC TOE ===== -->
    <div class="col-12 col-lg-6 d-flex">
        <div class="game-card w-100">
            <div class="game-header">
                <div class="game-header-icon">
                    <i class="bi bi-hash fs-5 text-success"></i>
                </div>
                <div>
                    <div class="fw-bold fs-5">Tic-Tac-Toe</div>
                    <div class="opacity-75 small">You're X — beat the AI!</div>
                </div>
                <div class="ms-auto">
                    <span class="score-badge" id="tttScore">W:0 D:0 L:0</span>
                </div>
            </div>
            <div class="game-card-body text-center">
                <div class="game-card-content py-1">
                    <div class="mb-2">
                        <span id="tttStatus" class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill fw-semibold" style="font-size: 0.8rem;">Your turn – click a square!</span>
                    </div>
                    <div class="ttt-board my-2" id="tttBoard">
                        <div class="ttt-cell" id="ttt-0" onclick="tttClick(0)"></div>
                        <div class="ttt-cell" id="ttt-1" onclick="tttClick(1)"></div>
