// INIT ALL GAMES (ROBUST IMMEDIATE & EVENT DRIVEN)
// ============================================================
function runAllInits() {
    try { initMemory(); } catch(e){ console.error("Error initializing Memory game:", e); }
    try { initWord(); } catch(e){ console.error("Error initializing Word game:", e); }
    try { initDotnet(); } catch(e){ console.error("Error initializing .NET game:", e); }
    try { initTTT(); } catch(e){ console.error("Error initializing TTT game:", e); }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runAllInits);
} else {
    runAllInits();
}
window.addEventListener('load', runAllInits);
