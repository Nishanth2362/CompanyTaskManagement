<span class="cls">Console</span>.<span class="cls">WriteLine</span>(a.<span class="cls">Intersect</span>(b).<span class="cls">Single</span>());`, answer:'3', options:['3','1','5','Error'], explain:'Intersection of {1,2,3} and {3,4,5} = {3}.' },
  { code: `<span class="kw">var</span> hs = <span class="kw">new</span> <span class="cls">HashSet</span>&lt;<span class="kw">int</span>&gt; { 1, 2, 3 };
hs.<span class="cls">Add</span>(<span class="num">2</span>);
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(hs.<span class="cls">Count</span>);`, answer:'3', options:['3','4','2','Error'], explain:'HashSet ignores duplicate 2 — count stays 3.' },
  { code: `<span class="kw">var</span> list = <span class="kw">new</span> <span class="cls">List</span>&lt;<span class="kw">string</span>&gt; { <span class="str">"cat"</span>, <span class="str">"dog"</span>, <span class="str">"ape"</span> };
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(list.<span class="cls">OrderBy</span>(x => x).<span class="cls">First</span>());`, answer:'ape', options:['ape','cat','dog','zoo'], explain:'Alphabetical: ape < cat < dog, so First = ape.' },
  { code: `<span class="kw">var</span> d = <span class="kw">new</span> <span class="cls">Dictionary</span>&lt;<span class="kw">string</span>,<span class="kw">int</span>&gt;
    { {<span class="str">"a"</span>,1}, {<span class="str">"b"</span>,2} };
<span class="cls">Console</span>.<span class="cls">WriteLine</span>(d.<span class="cls">ContainsKey</span>(<span class="str">"c"</span>));`, answer:'False', options:['False','True','0','Exception'], explain:'Key "c" not present → False.' },
];

let dnIdx = 0, dnScore = 0, dnStreak = 0, dnTimer, dnSecs, dnOrder = [], dnAnswered = false;

function initDotnet() {
    dnOrder = [...dotnetQs].sort(() => Math.random() - 0.5);
    dnIdx = 0; dnScore = 0; dnStreak = 0;
    document.getElementById('dotnetScore').textContent = 'Score: 0';
    document.getElementById('dotnetStreak').textContent = '🔥 0';
    dotnetLoad();
}

function dotnetLoad() {
    clearInterval(dnTimer);
    if (dnIdx >= dnOrder.length) dnIdx = 0;
    const q = dnOrder[dnIdx];
    document.getElementById('dotnetQNum').textContent = `Q ${dnIdx + 1} / ${dnOrder.length}`;
    document.getElementById('dotnetCode').innerHTML = q.code;
    document.getElementById('dotnetMsg').textContent = '';
    document.getElementById('dotnetExplain').textContent = '';
    document.getElementById('dotnetNextBtn').style.display = 'none';
    dnAnswered = false;
    const opts = [...q.options].sort(() => Math.random() - 0.5);
    const ctr = document.getElementById('dotnetOptions');
    ctr.innerHTML = '';
    opts.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = 'dotnet-opt-btn';
        btn.textContent = opt;
        btn.onclick = () => dotnetAnswer(opt, q.answer, q.explain);
        ctr.appendChild(btn);
    });
    dnSecs = 30;
    document.getElementById('dotnetTimerLabel').textContent = `⏱ ${dnSecs}s`;
    const bar = document.getElementById('dotnetTimerBar');
    bar.style.transition = 'none'; bar.style.width = '100%';
    setTimeout(() => { bar.style.transition = `width ${dnSecs}s linear`; bar.style.width = '0%'; }, 50);
    dnTimer = setInterval(() => {
        dnSecs--;
        document.getElementById('dotnetTimerLabel').textContent = `⏱ ${dnSecs}s`;
        if (dnSecs <= 0) { clearInterval(dnTimer); if (!dnAnswered) dotnetAnswer(null, q.answer, q.explain); }
    }, 1000);
}

function dotnetAnswer(chosen, correct, explain) {
    if (dnAnswered) return;
    dnAnswered = true;
    clearInterval(dnTimer);
    document.getElementById('dotnetTimerBar').style.transition = 'none';
    document.querySelectorAll('.dotnet-opt-btn').forEach(b => {
        b.disabled = true;
        if (b.textContent === correct) b.classList.add('opt-correct');
        else if (b.textContent === chosen) b.classList.add('opt-wrong');
    });
    if (chosen === correct) {
        const points = 100 + (dnStreak * 25);
        dnScore += points; dnStreak++;
        document.getElementById('dotnetMsg').innerHTML = `<span style="color:#10b981">✅ Correct! (+${points} pts)</span>`;
        submitScoreToDatabase('DotNetQuiz', points, 30);
    } else {
        dnStreak = 0;
        document.getElementById('dotnetMsg').innerHTML = chosen
            ? '<span style="color:#ef4444">❌ Wrong!</span>'
            : '<span style="color:#f59e0b">⏰ Time\'s up!</span>';
    }
    document.getElementById('dotnetScore').textContent = `Score: ${dnScore}`;
    document.getElementById('dotnetStreak').textContent = `🔥 ${dnStreak}`;
    document.getElementById('dotnetExplain').textContent = explain;
    document.getElementById('dotnetNextBtn').style.display = 'inline-block';
    dnIdx++;
}

function dotnetNext() { dotnetLoad(); }

// ============================================================
// GAME 4: TIC-TAC-TOE vs AI
// ============================================================
let tttBoard2 = Array(9).fill(''), tttActive = true, tttW=0, tttD=0, tttL=0;

const tttWins = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];

function initTTT() {
    tttBoard2 = Array(9).fill(''); tttActive = true;
    document.querySelectorAll('.ttt-cell').forEach(c => { c.textContent=''; c.className='ttt-cell'; });
    document.getElementById('tttStatus').textContent = 'Your turn – click a square!';
}

function tttClick(i) {
    if (!tttActive || tttBoard2[i]) return;
    tttBoard2[i] = 'X';
    document.getElementById(`ttt-${i}`).textContent = 'X';
    document.getElementById(`ttt-${i}`).classList.add('taken');
    const res = tttCheck(tttBoard2);
    if (res) { endTTT(res, 'X'); return; }
    if (tttBoard2.every(v=>v)) { endTTT('draw'); return; }
    document.getElementById('tttStatus').textContent = '🤖 AI thinking...';
    setTimeout(aiTTT, 300);
}

function aiTTT() {
    const best = minimax(tttBoard2, 'O');
    tttBoard2[best.idx] = 'O';
    const cell = document.getElementById(`ttt-${best.idx}`);
    cell.textContent = 'O'; cell.classList.add('taken');
    const res = tttCheck(tttBoard2);
    if (res) { endTTT(res, 'O'); return; }
    if (tttBoard2.every(v=>v)) { endTTT('draw'); return; }
    document.getElementById('tttStatus').textContent = 'Your turn – click a square!';
}

function minimax(board, player) {
    const check = tttCheck(board);
    if (check === 'X') return {score: -10};
    if (check === 'O') return {score: 10};
    if (board.every(v=>v)) return {score: 0};
    const moves = [];
    for (let i=0;i<9;i++) {
        if (!board[i]) {
            const nb = [...board]; nb[i] = player;
            const score = minimax(nb, player==='O'?'X':'O').score;
            moves.push({idx:i, score});
        }
    }
    return player==='O' ? moves.reduce((a,b)=>a.score>b.score?a:b) : moves.reduce((a,b)=>a.score<b.score?a:b);
}

function tttCheck(b) {
    for (const [a,c,d] of tttWins) if (b[a] && b[a]===b[c] && b[a]===b[d]) return b[a];
    return null;
}

function endTTT(winner, mark) {
    tttActive = false;
    if (winner === 'draw') {
        document.getElementById('tttStatus').textContent = "🤝 It's a draw!";
        tttD++;
    } else if (mark === 'X') {
        document.getElementById('tttStatus').textContent = '🎉 You Win!';
        tttW++;
        submitScoreToDatabase('Tic-Tac-Toe', 150, 30);
        tttWins.filter(([a,b,c])=>tttBoard2[a]===mark && tttBoard2[b]===mark && tttBoard2[c]===mark)
            .forEach(([a,b,c])=>{ [a,b,c].forEach(i=>document.getElementById(`ttt-${i}`).classList.add('win-cell')); });
    } else {
        document.getElementById('tttStatus').textContent = '🤖 AI Wins! Try again!';
        tttL++;
        tttWins.filter(([a,b,c])=>tttBoard2[a]===mark && tttBoard2[b]===mark && tttBoard2[c]===mark)
            .forEach(([a,b,c])=>{ [a,b,c].forEach(i=>document.getElementById(`ttt-${i}`).classList.add('win-cell')); });
    }
    document.getElementById('tttScore').textContent = `W:${tttW} D:${tttD} L:${tttL}`;
}



// ============================================================
// DYNAMIC DATABASE SCORE PERSISTENCE
// ============================================================
function submitScoreToDatabase(gameType, score, timeTakenSeconds) {
    fetch('/MindForge/SubmitScore', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            gameType: gameType,
            score: parseInt(score) || 100,
            timeTakenSeconds: parseInt(timeTakenSeconds) || 30
        })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            console.log('Score saved dynamically in SQL Server database!', data);
            if (typeof showToast === 'function') {
                showToast(`🏆 Score saved to Database! (+${data.savedScore} pts)`);
            }
        }
    })
    .catch(err => console.error('Error saving score to database:', err));
}

// ============================================================
// INIT ALL GAMES
// ============================================================
// Initialize all games on window load (guaranteed DOM ready)
window.addEventListener('load', function() {
    initMemory();
    initWord();
    initDotnet();
    initTTT();
});
</script>
}
