@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Upvote Doubt logic
            document.querySelectorAll('.upvote-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const doubtId = this.getAttribute('data-id');
                    const countSpan = this.querySelector('.upvote-count');
                    fetch(`/Internship/UpvoteDoubt/${doubtId}`, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            countSpan.textContent = data.upvotes;
                            btn.classList.remove('btn-outline-secondary');
                            btn.classList.add('btn-warning', 'text-dark', 'fw-bold');
                        }
                    });
                });
            });

            // YouTube URL live parser in Add Modal
            const ytUrlInput = document.getElementById('ytModalUrlInput');
            const ytPreviewContainer = document.getElementById('ytPreviewContainer');
            const ytPreviewImg = document.getElementById('ytPreviewImg');
            const ytPreviewId = document.getElementById('ytPreviewId');

            function extractYtId(url) {
                if (!url) return '';
                url = url.trim();
                const regExp = /(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/;
                const match = url.match(regExp);
                if (match && match[1]) return match[1];
                if (url.length === 11 && /^[a-zA-Z0-9_-]{11}$/.test(url)) return url;
                return '';
            }

            if (ytUrlInput && ytPreviewContainer) {
                ytUrlInput.addEventListener('input', function() {
                    const id = extractYtId(this.value);
                    if (id) {
                        ytPreviewImg.src = `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
                        ytPreviewId.textContent = id;
                        ytPreviewContainer.style.display = 'flex';
                    } else {
                        ytPreviewContainer.style.display = 'none';
                    }
                });
            }

            // Watch Video Modal handler
            const watchModal = document.getElementById('watchVideoModal');
            const watchIframe = document.getElementById('watchModalIframe');
            const watchTitle = document.getElementById('watchVideoModalLabel');
            const watchTrack = document.getElementById('watchModalTrack');

            if (watchModal && watchIframe) {
                watchModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    const videoId = button.getAttribute('data-video-id');
                    const title = button.getAttribute('data-video-title');
                    const track = button.getAttribute('data-video-track');

                    if (watchTitle && title) watchTitle.textContent = title;
                    if (watchTrack && track) watchTrack.textContent = track;
                    if (videoId) {
                        watchIframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
                    }
                });

                watchModal.addEventListener('hidden.bs.modal', function() {
                    watchIframe.src = '';
