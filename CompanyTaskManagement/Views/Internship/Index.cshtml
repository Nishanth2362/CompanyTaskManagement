                    // Select question set and shuffle, then take 25
                    const allForTrack = questionBanks[track] || defaultGenericQuestions;
                    const shuffled = allForTrack.slice().sort(() => Math.random() - 0.5);
                    currentQuestions = shuffled.slice(0, 25);

                    // Update badge count
                    const countEl = document.getElementById('quizQuestionCountText');
                    if (countEl) countEl.textContent = currentQuestions.length;

                    // Update hidden total field
                    const totalField = document.getElementById('formTotalQuestions');
                    if (totalField) totalField.value = currentQuestions.length;

                    // Render questions
                    renderQuestions(currentQuestions);

                    showStep(questionsStep);
                });
            }

            if (backToSetupBtn) {
                backToSetupBtn.addEventListener('click', function() {
                    showStep(setupStep);
                });
            }

            if (retakeQuizBtn) {
                retakeQuizBtn.addEventListener('click', function() {
                    showStep(setupStep);
                });
            }

            function renderQuestions(questions) {
                if (!questionsContainer) return;
                questionsContainer.innerHTML = '';

                questions.forEach((qObj, index) => {
                    const card = document.createElement('div');
                    card.className = 'p-3.5 rounded-3 bg-body-tertiary border border-secondary border-opacity-15 shadow-xs';

                    let optionsHtml = '';
                    qObj.options.forEach((opt, optIndex) => {
                        optionsHtml += `
                            <div class="form-check p-2.5 rounded-2 bg-body border border-secondary border-opacity-10 mb-2 transition-all">
                                <input class="form-check-input ms-0 me-2.5" type="radio" name="q_${index}" id="q_${index}_opt_${optIndex}" value="${optIndex}" required />
                                <label class="form-check-label small text-body fw-medium cursor-pointer w-100" for="q_${index}_opt_${optIndex}">
                                    ${opt}
                                </label>
                            </div>
                        `;
                    });

                    card.innerHTML = `
                        <div class="d-flex align-items-center gap-2 mb-2.5">
                            <span class="badge badge-royal-gold rounded-pill px-2.5 py-1 font-monospace">Q${index + 1}</span>
                            <span class="fw-bold text-body small">${qObj.q}</span>
                        </div>
                        <div class="options-container ps-1">
                            ${optionsHtml}
                        </div>
                    `;

                    questionsContainer.appendChild(card);
                });
            }

            if (submitQuizAnswersBtn) {
                submitQuizAnswersBtn.addEventListener('click', function() {
                    let score = 0;
                    const total = currentQuestions.length;
                    let allAnswered = true;

                    currentQuestions.forEach((qObj, index) => {
                        const selected = document.querySelector(`input[name="q_${index}"]:checked`);
                        if (!selected) {
                            allAnswered = false;
                        } else {
                            if (parseInt(selected.value, 10) === qObj.correct) {
                                score++;
                            }
                        }
                    });

                    if (!allAnswered) {
                        if (!confirm('You have unanswered questions. Do you want to submit anyway?')) {
                            return;
                        }
                    }

                    const percentage = Math.round((score / total) * 100);
                    const isPassed = percentage >= 60;

                    // Populate hidden fields
                    formInternName.value = (internNameInput.value || '').trim();
                    formInternEmail.value = (internEmailInput.value || '').trim();
                    formTopicTitle.value = (topicTitleInput.value || '').trim();
                    formTrack.value = trackSelect.value;
                    formScore.value = score;

                    // Display Score
                    if (resultScoreDisplay) resultScoreDisplay.textContent = `${score} / ${total}`;
                    if (resultPercentageBadge) {
                        resultPercentageBadge.textContent = `${percentage}%`;
                        resultPercentageBadge.className = isPassed ? 'badge badge-emerald px-3 py-1.5 fw-bold fs-6' : 'badge bg-danger text-white px-3 py-1.5 fw-bold fs-6';
                    }

                    if (isPassed) {
                        resultGradeText.textContent = percentage === 100 ? '⭐ Flawless Distinction (A+)' : '🎉 Passed with Excellence!';
                        resultIconContainer.innerHTML = '<i class="bi bi-trophy-fill text-gold display-3"></i>';
                        formFeedbackNotes.value = percentage === 100 
                            ? 'Demonstrated flawless 100% technical mastery on all assessment questions!' 
                            : `Strong grasp on core concepts (${percentage}% score). Ready for production tasks!`;
                    } else {
                        resultGradeText.textContent = '🌱 Keep Practicing & Growth Focus';
                        resultIconContainer.innerHTML = '<i class="bi bi-mortarboard text-warning display-3"></i>';
                        formFeedbackNotes.value = `Scored ${score}/${total} (${percentage}%). Review learning material and retry for distinction.`;
                    }

                    showStep(resultStep);
                });
            }
        });
    </script>
}
