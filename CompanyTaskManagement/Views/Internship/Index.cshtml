@{
    ViewData["Title"] = "Internship Learning Academy & Team";
    var materials = ViewBag.Materials as List<CompanyTaskManagement.Models.InternStudyMaterial> ?? new List<CompanyTaskManagement.Models.InternStudyMaterial>();
    var doubts = ViewBag.Doubts as List<CompanyTaskManagement.Models.InternDoubt> ?? new List<CompanyTaskManagement.Models.InternDoubt>();
    var members = ViewBag.Members as List<CompanyTaskManagement.Models.InternshipMember> ?? new List<CompanyTaskManagement.Models.InternshipMember>();
    var youTubeVideos = ViewBag.YouTubeVideos as List<CompanyTaskManagement.Models.InternYouTubeReference> ?? new List<CompanyTaskManagement.Models.InternYouTubeReference>();
    var testResults = ViewBag.TestResults as List<CompanyTaskManagement.Models.InternTestResult> ?? new List<CompanyTaskManagement.Models.InternTestResult>();
    var tracks = ViewBag.Tracks as List<string> ?? new List<string>();
    var activeTab = ViewBag.ActiveTab as string ?? "youtube";
    var selectedTrack = ViewBag.SelectedTrack as string ?? "all";
    var selectedDoubtStatus = ViewBag.SelectedDoubtStatus as string ?? "all";
    var search = ViewBag.Search as string;
    var employees = ViewBag.Employees as List<CompanyTaskManagement.Models.Employee> ?? new List<CompanyTaskManagement.Models.Employee>();
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<!-- Internship Academy Hero Banner -->
<div class="internship-hero-card mb-4 p-4 p-lg-4.5 text-white position-relative overflow-hidden">
    <div class="row align-items-center g-4 position-relative" style="z-index: 2;">
        <div class="col-12">
            <div class="d-flex align-items-center flex-wrap gap-2 mb-2.5">
                <span class="badge bg-warning text-dark fw-bold px-3 py-1.5"><i class="bi bi-mortarboard-fill me-1"></i> Auxinzio Academy</span>
                <span class="badge hero-badge-glass px-3 py-1.5 font-monospace">Learning &amp; Testing Hub</span>
            </div>
            <h2 class="h2 fw-extrabold text-white mb-2" style="font-family: 'Outfit', sans-serif; font-size: 2rem;">
                Internship Learning &amp; Assessment Hub
            </h2>
            <p class="text-white opacity-90 mb-0" style="max-width: 680px; font-size: 0.95rem; line-height: 1.6;">
                Learn key engineering topics via YouTube &amp; guides, attend topic tests to evaluate mastery, upload assessment results, and get verified mentor guidance.
            </p>
        </div>
    </div>
    <div class="hero-decorative-circle"></div>
</div>

<!-- Quick Action Buttons -->
<div class="d-flex flex-wrap gap-2 gap-sm-3 mb-4 align-items-center">
    <button type="button" class="btn shadow-sm d-inline-flex align-items-center justify-content-center gap-2 fw-bold text-white flex-grow-1 flex-sm-grow-0" style="background-color: #0ea5e9;" data-bs-toggle="modal" data-bs-target="#takeTestModal">
        <i class="bi bi-patch-check-fill"></i>
        <span>Attend Topic Test</span>
    </button>
    <button type="button" class="btn shadow-sm d-inline-flex align-items-center justify-content-center gap-2 fw-bold text-white flex-grow-1 flex-sm-grow-0" style="background-color: #0ea5e9;" data-bs-toggle="modal" data-bs-target="#uploadTestModal">
        <i class="bi bi-cloud-arrow-up-fill"></i>
        <span>Upload Test Result</span>
    </button>
    <button type="button" class="btn shadow-sm d-inline-flex align-items-center justify-content-center gap-2 fw-bold text-white flex-grow-1 flex-sm-grow-0" style="background-color: #0ea5e9;" data-bs-toggle="modal" data-bs-target="#addYouTubeModal">
        <i class="bi bi-youtube"></i>
        <span>Add Video</span>
    </button>
    <button type="button" class="btn shadow-sm d-inline-flex align-items-center justify-content-center gap-2 fw-bold text-white flex-grow-1 flex-sm-grow-0" style="background-color: #0ea5e9;" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
        <i class="bi bi-journal-plus"></i>
        <span>Upload Material</span>
    </button>
    @if (isAdmin)
    {
        <button type="button" class="btn shadow-sm d-inline-flex align-items-center justify-content-center gap-2 fw-bold text-white flex-grow-1 flex-sm-grow-0" style="background-color: #0ea5e9;" data-bs-toggle="modal" data-bs-target="#addMemberModal">
            <i class="bi bi-person-plus-fill"></i>
            <span>Add Intern (Admin)</span>
        </button>
    }
    else
    {
        <button type="button" class="btn bg-white shadow-sm d-inline-flex align-items-center justify-content-center gap-2 opacity-75 fw-semibold flex-grow-1 flex-sm-grow-0" style="color: #0ea5e9; border: 1px solid #0ea5e9;" title="Only Administrator has permission to add or register interns" disabled>
            <i class="bi bi-lock-fill text-warning"></i>
            <span>Add Intern (Admin Only)</span>
        </button>
    }
    <button type="button" class="btn shadow-sm d-inline-flex align-items-center justify-content-center gap-2 fw-bold text-white flex-grow-1 flex-sm-grow-0" style="background-color: #0ea5e9;" data-bs-toggle="modal" data-bs-target="#askDoubtModal">
        <i class="bi bi-patch-question-fill"></i>
        <span>Raise Doubt</span>
    </button>
</div>

<!-- Success / Error Alert Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stat Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div>
                <div class="stat-number text-gold">@ViewBag.TotalTests</div>
                <div class="stat-label">Tests Completed</div>
            </div>
            <div class="stat-icon stat-icon-amber">
                <i class="bi bi-patch-check-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div>
                <div class="stat-number text-emerald">@ViewBag.AverageScore%</div>
                <div class="stat-label">Average Cohort Score</div>
            </div>
            <div class="stat-icon stat-icon-emerald">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div>
                <div class="stat-number text-danger">@ViewBag.TotalYouTubeVideos</div>
                <div class="stat-label">Learning Topics</div>
            </div>
            <div class="stat-icon" style="background: rgba(239, 68, 68, 0.12); color: #ef4444;">
                <i class="bi bi-youtube"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div>
                <div class="stat-number text-amethyst">@ViewBag.TotalMembers</div>
                <div class="stat-label">Interns &amp; Mentors</div>
            </div>
            <div class="stat-icon stat-icon-amethyst">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- Main Navigation Tabs -->
<div class="card border-0 shadow-sm mb-4 p-2 glass-card overflow-hidden">
    <div class="overflow-x-auto scrollbar-hidden">
        <ul class="nav nav-pills flex-nowrap flex-xl-wrap gap-2 text-nowrap" id="internshipNavTabs" role="tablist">
            <li class="nav-item flex-shrink-0 flex-xl-grow-1" role="presentation">
                <a class="nav-link @(activeTab == "youtube" ? "active fw-bold shadow-sm" : "") d-flex align-items-center justify-content-center gap-2 py-2.5 px-3 rounded-3" 
                   asp-action="Index" asp-route-tab="youtube">
                    <i class="bi bi-youtube text-danger fs-5"></i>
                    <span>YouTube References (@ViewBag.TotalYouTubeVideos)</span>
                </a>
            </li>
            <li class="nav-item flex-shrink-0 flex-xl-grow-1" role="presentation">
                <a class="nav-link @(activeTab == "materials" ? "active fw-bold shadow-sm" : "") d-flex align-items-center justify-content-center gap-2 py-2.5 px-3 rounded-3" 
                   asp-action="Index" asp-route-tab="materials">
                    <i class="bi bi-book-half fs-5"></i>
                    <span>Study Materials &amp; Guides (@ViewBag.TotalMaterials)</span>
                </a>
            </li>
            <li class="nav-item flex-shrink-0 flex-xl-grow-1" role="presentation">
                <a class="nav-link @(activeTab == "tests" ? "active fw-bold shadow-sm" : "") d-flex align-items-center justify-content-center gap-2 py-2.5 px-3 rounded-3" 
                   asp-action="Index" asp-route-tab="tests">
                    <i class="bi bi-patch-check-fill text-warning fs-5"></i>
                    <span>🎯 Topic Tests &amp; Results (@ViewBag.TotalTests)</span>
                </a>
            </li>
            <li class="nav-item flex-shrink-0 flex-xl-grow-1" role="presentation">
                <a class="nav-link @(activeTab == "members" ? "active fw-bold shadow-sm" : "") d-flex align-items-center justify-content-center gap-2 py-2.5 px-3 rounded-3" 
                   asp-action="Index" asp-route-tab="members">
                    <i class="bi bi-person-badge-fill fs-5"></i>
                    <span>Interns &amp; Mentors Team (@ViewBag.TotalMembers)</span>
                </a>
            </li>
            <li class="nav-item flex-shrink-0 flex-xl-grow-1" role="presentation">
                <a class="nav-link @(activeTab == "doubts" ? "active fw-bold shadow-sm" : "") d-flex align-items-center justify-content-center gap-2 py-2.5 px-3 rounded-3" 
                   asp-action="Index" asp-route-tab="doubts">
                    <i class="bi bi-question-circle-fill fs-5"></i>
                    <span>Doubt Forum &amp; Q&amp;A (@ViewBag.TotalDoubts)</span>
                    @if (ViewBag.OpenDoubts > 0)
                    {
                        <span class="badge bg-warning text-dark rounded-pill px-2 ms-1">@ViewBag.OpenDoubts open</span>
                    }
                </a>
            </li>
            <li class="nav-item flex-shrink-0 flex-xl-grow-1" role="presentation">
                <a class="nav-link @(activeTab == "roadmap" ? "active fw-bold shadow-sm" : "") d-flex align-items-center justify-content-center gap-2 py-2.5 px-3 rounded-3" 
                   asp-action="Index" asp-route-tab="roadmap">
                    <i class="bi bi-compass-fill fs-5"></i>
                    <span>90-Day Roadmap</span>
                </a>
            </li>
        </ul>
    </div>
</div>

<!-- ========================================================= -->
<!-- TAB: TOPIC TESTS & RESULTS                                -->
<!-- ========================================================= -->
@if (activeTab == "tests")
{
    <!-- Action & Filter Bar -->
    <div class="card border-0 shadow-sm mb-4 p-3 glass-card">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
            <!-- Domain Track Filter Pills -->
            <div class="d-flex flex-wrap gap-1">
                <a asp-action="Index" asp-route-tab="tests" asp-route-track="all" class="btn btn-sm @(selectedTrack == "all" ? "btn-royal-gold shadow-sm fw-bold" : "btn-dark-carbon") rounded-pill px-3">
                    All Tracks
                </a>
                @foreach (var tr in tracks)
                {
                    <a asp-action="Index" asp-route-tab="tests" asp-route-track="@tr" class="btn btn-sm @(selectedTrack == tr ? "btn-royal-gold shadow-sm fw-bold" : "btn-dark-carbon") rounded-pill px-3">
                        @tr
                    </a>
                }
            </div>

            <!-- Search and Action Buttons -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <form method="get" asp-action="Index" class="d-flex gap-1.5 flex-grow-1">
                    <input type="hidden" name="tab" value="tests" />
                    <input type="hidden" name="track" value="@selectedTrack" />
                    <div class="input-group input-group-sm rounded-pill overflow-hidden border shadow-sm bg-body p-0.5" style="min-width: 240px;">
                        <span class="input-group-text bg-transparent border-0 ps-3 pe-2"><i class="bi bi-search text-primary"></i></span>
                        <input type="text" name="search" value="@search" class="form-control border-0 shadow-none ps-0" placeholder="Search intern, topic..." />
                        @if (!string.IsNullOrWhiteSpace(search) || selectedTrack != "all")
                        {
                            <a asp-action="Index" asp-route-tab="tests" class="btn border-0 bg-transparent text-muted pe-1" title="Clear"><i class="bi bi-x-circle-fill"></i></a>
                        }
                        <button class="btn btn-royal-gold rounded-pill px-3 fw-medium" type="submit">Search</button>
                    </div>
                </form>

                <button type="button" class="btn btn-royal-gold btn-sm d-inline-flex align-items-center gap-1.5 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#takeTestModal">
                    <i class="bi bi-pencil-square"></i>
                    <span>Attend Test</span>
                </button>

                <button type="button" class="btn btn-emerald btn-sm d-inline-flex align-items-center gap-1.5 shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadTestModal">
                    <i class="bi bi-cloud-arrow-up-fill"></i>
                    <span>Upload Scorecard</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Test Results Grid & Table -->
    @if (!testResults.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center glass-card">
            <i class="bi bi-patch-question text-muted display-4 mb-3"></i>
            <h5 class="fw-bold text-body">No Assessment Results Recorded Yet</h5>
            <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">
                Interns can attend tests directly on learned topics or upload external evaluation scorecards here.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-royal-gold" data-bs-toggle="modal" data-bs-target="#takeTestModal">
                    <i class="bi bi-pencil-square me-1"></i> Attend Online Test Now
                </button>
                <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#uploadTestModal">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Test Score
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-lg glass-card overflow-hidden mb-4">
            <div class="card-header bg-body-tertiary p-3 px-4 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-award-fill text-gold fs-5"></i>
                    <h5 class="fw-bold mb-0 text-body">Internship Assessment &amp; Certification Records</h5>
                </div>
                <span class="badge badge-royal-gold rounded-pill px-3 py-1.5 font-monospace">
                    @testResults.Count Total Records
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.92rem;">
                    <thead class="table-custom text-uppercase font-monospace extra-small border-bottom border-secondary border-opacity-25">
                        <tr>
                            <th class="ps-4 py-3">Date</th>
                            <th class="py-3">Intern Name</th>
                            <th class="py-3">Assessed Topic &amp; Track</th>
                            <th class="py-3 text-center">Score / Total</th>
                            <th class="py-3 text-center">Percentage</th>
                            <th class="py-3 text-center">Grade / Status</th>
                            <th class="py-3">Mentor Notes / Feedback</th>
                            <th class="py-3 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in testResults)
                        {
                            var scoreBadgeClass = res.ScorePercentage >= 80 ? "badge-emerald" :
                                                  res.ScorePercentage >= 60 ? "badge-royal-gold" : "bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25";

                            <tr class="border-bottom border-secondary border-opacity-10">
                                <td class="ps-4 text-muted font-monospace extra-small text-nowrap">
                                    <i class="bi bi-calendar-event me-1 text-gold"></i>@res.TakenAt.ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle-sm bg-primary text-white fw-bold" style="width: 32px; height: 32px; font-size: 0.82rem;">
                                            @(!string.IsNullOrEmpty(res.InternName) ? res.InternName.Substring(0, 1) : "?")
                                        </div>
                                        <div>
                                            <strong class="d-block text-body">@res.InternName</strong>
                                            @if (!string.IsNullOrWhiteSpace(res.InternEmail))
                                            {
                                                <span class="extra-small text-muted font-monospace">@res.InternEmail</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <div class="fw-bold text-body">@res.TopicTitle</div>
                                        <span class="badge-track-pill extra-small">
                                            @res.Track
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center font-monospace fw-bold fs-6 text-body">
                                    @res.Score <span class="text-muted fs-6">/ @res.TotalQuestions</span>
                                </td>
                                <td class="text-center" style="min-width: 130px;">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <div class="task-progress-track flex-grow-1" style="width: 55px; height: 7px;">
                                            <div class="task-progress-fill" style="width: @res.ScorePercentage%;"></div>
                                        </div>
                                        <span class="fw-bold font-monospace text-gold small">@res.ScorePercentage%</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @scoreBadgeClass px-3 py-1.5 rounded-pill fw-bold">
                                        @if (res.IsPassed)
                                        {
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill me-1"></i>
                                        }
                                        @res.GradeBadge
                                    </span>
                                </td>
                                <td>
                                    <div class="small text-secondary line-clamp-2" title="@res.FeedbackNotes">
                                        @(string.IsNullOrWhiteSpace(res.FeedbackNotes) ? "Assessment successfully recorded." : res.FeedbackNotes)
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(res.CertificateProofPath))
                                    {
                                        <a href="@res.CertificateProofPath" target="_blank" class="extra-small text-emerald fw-bold text-decoration-none mt-1 d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-file-earmark-check-fill"></i> View Uploaded Proof / Certificate
                                        </a>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1.5">
                                        <button type="button" class="btn btn-outline-warning btn-sm take-test-btn" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#takeTestModal"
                                                data-topic-title="@res.TopicTitle"
                                                data-topic-track="@res.Track"
                                                title="Retake this Assessment">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>

                                        <form asp-action="DeleteTestResult" asp-route-id="@res.Id" method="post" onsubmit="return confirm('Delete this test score record?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Record">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<!-- TAB 1: STUDY MATERIALS -->
@if (activeTab == "materials")
{
    <!-- Filter Toolbar -->
    <div class="card border-0 shadow-sm mb-4 p-3.5 p-lg-4 glass-card">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
            <!-- Domain Track Filter Pills -->
            <div class="d-flex flex-wrap gap-1.5 align-items-center">
                <a asp-action="Index" asp-route-tab="materials" asp-route-track="all" class="btn btn-sm @(selectedTrack == "all" ? "btn-royal-gold shadow-sm fw-bold" : "btn-dark-carbon") rounded-pill px-3 py-1.5" style="font-size: 0.82rem;">
                    All Domains
                </a>
                @foreach (var tr in tracks)
                {
                    <a asp-action="Index" asp-route-tab="materials" asp-route-track="@tr" class="btn btn-sm @(selectedTrack == tr ? "btn-royal-gold shadow-sm fw-bold" : "btn-dark-carbon") rounded-pill px-3 py-1.5" style="font-size: 0.82rem;">
                        @tr
                    </a>
                }
            </div>

            <!-- Search Box & Action Button Group -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <form method="get" asp-action="Index" class="d-flex gap-1.5 flex-grow-1">
                    <input type="hidden" name="tab" value="materials" />
                    <input type="hidden" name="track" value="@selectedTrack" />
                    <div class="input-group input-group-sm rounded-pill overflow-hidden border shadow-sm bg-body p-0.5" style="min-width: 240px;">
                        <span class="input-group-text bg-transparent border-0 ps-3 pe-2"><i class="bi bi-search text-primary"></i></span>
                        <input type="text" name="search" value="@search" class="form-control border-0 shadow-none ps-0" placeholder="Search topics, keywords..." style="font-size: 0.84rem;" />
                        @if (!string.IsNullOrWhiteSpace(search) || selectedTrack != "all")
                        {
                            <a asp-action="Index" asp-route-tab="materials" asp-route-track="@selectedTrack" class="btn border-0 bg-transparent text-muted pe-1" title="Clear"><i class="bi bi-x-circle-fill"></i></a>
                        }
                        <button class="btn btn-royal-gold rounded-pill px-3 fw-bold" type="submit">Search</button>
                    </div>
                </form>

                <button type="button" class="btn btn-royal-gold btn-sm rounded-pill fw-bold px-3.5 py-1.5 d-inline-flex align-items-center gap-1.5 shadow-sm text-nowrap flex-shrink-0" data-bs-toggle="modal" data-bs-target="#addMaterialModal" style="font-size: 0.84rem;">
                    <i class="bi bi-journal-plus"></i>
                    <span>Upload Study Material</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Materials Grid -->
    @if (!materials.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center glass-card">
            <i class="bi bi-journal-x text-muted display-4 mb-3"></i>
            <h5 class="fw-bold">No Study Materials Found</h5>
            <p class="text-muted mb-3">No study modules match the selected track or search keyword.</p>
            <div>
                <button type="button" class="btn btn-royal-gold" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Study Material
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var mat in materials)
            {
                var diffClass = mat.Difficulty == "Beginner" ? "badge-emerald" :
                                mat.Difficulty == "Intermediate" ? "badge-royal-gold" : "bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25";

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm glass-card hover-lift transition-all p-3 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                <span class="badge @diffClass px-2.5 py-1">@mat.Difficulty</span>
                                <span class="badge bg-body-secondary text-body font-monospace px-2 py-1">
                                    <i class="bi bi-stopwatch me-1"></i>~@mat.EstimatedMinutes mins
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-cpu-fill text-gold fs-5"></i>
                                <span class="small fw-bold text-muted text-uppercase letter-spacing-1">@mat.Track</span>
                            </div>

                            <h5 class="card-title fw-bold mb-2 text-body">@mat.Title</h5>
                            <p class="card-text text-secondary small mb-3 line-clamp-3">@mat.Description</p>

                            @if (!string.IsNullOrWhiteSpace(mat.Tags))
                            {
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @foreach (var tag in mat.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="badge bg-dark bg-opacity-50 text-white-50 font-monospace small px-2 py-0.5">#@tag.Trim()</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="pt-3 border-top border-secondary border-opacity-25 d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <!-- Attend Test Button for this Topic -->
                            <button type="button" class="btn btn-sm btn-royal-gold d-inline-flex align-items-center gap-1.5 shadow-sm fw-bold take-test-btn"
                                    data-bs-toggle="modal" 
                                    data-bs-target="#takeTestModal"
                                    data-topic-title="@mat.Title"
                                    data-topic-track="@mat.Track"
                                    title="Attend interactive test on this topic">
                                <i class="bi bi-patch-check-fill"></i>
                                <span>Attend Test</span>
                            </button>

                            <div class="d-flex flex-wrap gap-1.5 align-items-center">
                                @if (!string.IsNullOrWhiteSpace(mat.FilePath))
                                {
                                    <a href="@mat.FilePath" download class="btn btn-sm btn-emerald d-inline-flex align-items-center gap-1 shadow-sm" title="Download Attached File">
                                        <i class="bi bi-file-earmark-arrow-down-fill"></i>
                                        <span>File</span>
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(mat.ResourceUrl))
                                {
                                    <a href="@mat.ResourceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
                                        <span>Docs</span>
                                        <i class="bi bi-box-arrow-up-right small"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- TAB 2: INTERNS & MENTORS TEAM ROSTER -->
@if (activeTab == "members")
{
    <!-- Filter & Add Member Toolbar -->
    <div class="card border-0 shadow-sm mb-4 p-3 glass-card">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-gold"><i class="bi bi-people-fill me-1"></i> Cohort Roster:</span>
                <span class="badge bg-secondary bg-opacity-25 text-body">@ViewBag.TotalInterns Intern(s)</span>
                <span class="badge bg-secondary bg-opacity-25 text-body">@ViewBag.TotalMentors Mentor(s)</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <form method="get" asp-action="Index" class="d-flex gap-2">
                    <input type="hidden" name="tab" value="members" />
                    <div class="input-group input-group-sm">
                        <input type="text" name="search" value="@search" class="form-control" placeholder="Search by name, role, domain..." />
                        <button class="btn btn-royal-gold" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>

                @if (isAdmin)
                {
                    <button type="button" class="btn btn-royal-gold btn-sm d-flex align-items-center gap-1.5 flex-shrink-0" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                        <i class="bi bi-person-plus-fill"></i>
                        <span>Add Intern / Mentor (Admin)</span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1.5 flex-shrink-0 opacity-75" title="Only Administrator has permission to add members" disabled>
                        <i class="bi bi-lock-fill text-danger"></i>
                        <span>Add Member (Admin Only)</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Members Grid -->
    @if (!members.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center glass-card">
            <i class="bi bi-person-x text-muted display-4 mb-3"></i>
            <h5 class="fw-bold">No Cohort Members Found</h5>
            <p class="text-muted mb-3">No interns or mentors match the current search filter.</p>
            @if (isAdmin)
            {
                <div>
                    <button type="button" class="btn btn-royal-gold" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                        <i class="bi bi-person-plus-fill me-1"></i> Add Member (Admin)
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var mem in members)
            {
                var roleClass = mem.Role.Contains("Mentor") || mem.Role.Contains("Lead") ? "badge-royal-gold" : "badge-emerald";
                var statusClass = mem.Status == "Active" ? "badge-emerald" :
                                  mem.Status == "Completed" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle";

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm glass-card hover-lift transition-all p-4 d-flex flex-column justify-content-between position-relative">
                        <div>
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle-mentor fs-5">
                                        @mem.Name.Substring(0, 1)
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0.5 text-body">@mem.Name</h5>
                                        <span class="badge @roleClass px-2 py-0.5 extra-small">@mem.Role</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3 p-2.5 rounded bg-body-tertiary">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="extra-small text-muted text-uppercase fw-bold">Domain Track</span>
                                    <span class="small fw-semibold text-body">@mem.Domain</span>
                                </div>
                                @if (!string.IsNullOrEmpty(mem.MentorName))
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="extra-small text-muted text-uppercase fw-bold">Mentor</span>
                                        <span class="small fw-semibold text-gold">@mem.MentorName</span>
                                    </div>
                                }
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="extra-small text-muted text-uppercase fw-bold">Completed Modules</span>
                                    <span class="badge bg-secondary bg-opacity-25 text-body">@mem.CompletedModulesCount modules</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(mem.Notes))
                            {
                                <p class="small text-secondary mb-3 fst-italic">"@mem.Notes"</p>
                            }
                        </div>

                        <div class="pt-3 border-top border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                            <span class="extra-small text-muted font-monospace">
                                <i class="bi bi-calendar-check me-1"></i>Joined @mem.JoinedDate.ToString("MMM yyyy")
                            </span>

                            @if (isAdmin)
                            {
                                <form asp-action="DeleteMember" method="post" onsubmit="return confirm('Remove @mem.Name from internship records?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@mem.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Member">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- TAB 3: DOUBT FORUM & Q&A -->
@if (activeTab == "doubts")
{
    <!-- Filter Toolbar -->
    <div class="card border-0 shadow-sm mb-4 p-3 glass-card">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex flex-wrap gap-1">
                <a asp-action="Index" asp-route-tab="doubts" asp-route-doubtStatus="all" class="btn btn-sm @(selectedDoubtStatus == "all" ? "btn-royal-gold shadow-sm fw-bold" : "btn-dark-carbon") rounded-pill px-3">
                    All Doubts
                </a>
                <a asp-action="Index" asp-route-tab="doubts" asp-route-doubtStatus="Open" class="btn btn-sm @(selectedDoubtStatus == "Open" ? "btn-warning text-dark shadow-sm fw-bold" : "btn-dark-carbon") rounded-pill px-3">
                    Open (@ViewBag.OpenDoubts)
                </a>
                <a asp-action="Index" asp-route-tab="doubts" asp-route-doubtStatus="Resolved" class="btn btn-sm @(selectedDoubtStatus == "Resolved" ? "btn-emerald shadow-sm fw-bold" : "btn-dark-carbon") rounded-pill px-3">
                    Resolved (@ViewBag.ResolvedDoubts)
                </a>
            </div>

            <div class="d-flex align-items-center gap-2">
                <form method="get" asp-action="Index" class="d-flex gap-2">
                    <input type="hidden" name="tab" value="doubts" />
                    <input type="hidden" name="doubtStatus" value="@selectedDoubtStatus" />
                    <div class="input-group input-group-sm">
                        <input type="text" name="search" value="@search" class="form-control" placeholder="Search doubt, author, keywords..." />
                        <button class="btn btn-royal-gold" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>

                <button type="button" class="btn btn-royal-gold btn-sm d-flex align-items-center gap-1.5 flex-shrink-0" data-bs-toggle="modal" data-bs-target="#askDoubtModal">
                    <i class="bi bi-patch-question-fill"></i>
                    <span>Raise Doubt</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Doubts List -->
    @if (!doubts.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center glass-card">
            <i class="bi bi-patch-check text-emerald display-4 mb-3"></i>
            <h5 class="fw-bold">No Technical Doubts Found</h5>
            <p class="text-muted mb-3">Everything is clear! If you encounter any technical roadblocks, post a doubt here.</p>
            <div>
                <button type="button" class="btn btn-royal-gold" data-bs-toggle="modal" data-bs-target="#askDoubtModal">
                    <i class="bi bi-patch-question-fill me-1"></i> Raise First Doubt
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var d in doubts)
            {
                var isResolved = d.Status == "Resolved" || d.Clarifications.Any(c => c.IsAcceptedSolution);
                var statusBadge = isResolved ? "badge-emerald" : "bg-warning text-dark";

                <div class="card border-0 shadow-sm glass-card p-4 hover-lift transition-all">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
                        <div class="d-flex align-items-start gap-3 flex-grow-1">
                            <div class="avatar-circle-mentor flex-shrink-0">
                                @d.InternName.Substring(0, 1)
                            </div>
                            <div class="w-100">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <span class="badge @statusBadge px-2 py-0.5 extra-small">
                                        @(isResolved ? "Resolved Solution" : "Open Doubt")
                                    </span>
                                    <span class="badge bg-secondary bg-opacity-25 text-body extra-small">@d.Domain</span>
                                    @if (d.Urgency == "Blocker / Critical")
                                    {
                                        <span class="badge bg-danger text-white extra-small">Critical Blocker</span>
                                    }
                                    <span class="extra-small text-muted font-monospace ms-auto">
                                        <i class="bi bi-clock me-1"></i>@d.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </span>
                                </div>

                                <h5 class="fw-bold mb-2">
                                    <a asp-action="DoubtDetails" asp-route-id="@d.Id" class="text-body text-decoration-none hover-gold">
                                        @d.Title
                                    </a>
                                </h5>

                                <p class="text-secondary small mb-2 line-clamp-2">@d.Description</p>

                                <div class="d-flex flex-wrap align-items-center gap-3 extra-small text-muted">
                                    <span><strong>Asked by:</strong> @d.InternName</span>
                                    <span><i class="bi bi-chat-dots-fill text-gold me-1"></i> @d.Clarifications.Count Responses</span>
                                    @if (!string.IsNullOrWhiteSpace(d.ScreenshotPath))
                                    {
                                        <div>
                                            <span class="text-warning"><i class="bi bi-image me-1"></i> Screenshot Attached</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Right Controls -->
                        <div class="d-flex flex-row flex-md-column align-items-center align-items-md-end gap-2 flex-shrink-0">
                            <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 upvote-btn" data-id="@d.Id">
                                <i class="bi bi-hand-thumbs-up-fill text-warning"></i>
                                <span class="upvote-count">@d.Upvotes</span>
                            </button>
                            <a asp-action="DoubtDetails" asp-route-id="@d.Id" class="btn btn-royal-gold btn-sm d-flex align-items-center gap-1.5 px-3">
                                <span>Clarify / Answer</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- TAB 4: 90-DAY ENGINEERING ROADMAP -->
@if (activeTab == "roadmap")
{
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm glass-card p-4 p-md-5 mb-4">
                <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-trophy-fill text-warning"></i>
                    <span>Auxinzio 90-Day Engineering Progression</span>
                </h4>
                <p class="text-muted small mb-4">A structured milestone progression designed to take interns from foundational development to autonomous production contribution.</p>

                <div class="timeline-roadmap">
                    <!-- Phase 1 -->
                    <div class="timeline-step pb-4 mb-3 border-start border-2 border-warning ps-4 position-relative">
                        <span class="badge bg-warning text-dark position-absolute start-0 top-0 translate-middle rounded-circle p-2">1</span>
                        <h5 class="fw-bold text-gold mb-1">Month 1: Foundation, Clean Code &amp; MVC Architecture</h5>
                        <p class="text-secondary small mb-2">Master C# object-oriented design, ASP.NET Core MVC request lifecycle, Dependency Injection, and Razor Views styling.</p>
                        <div class="d-flex flex-wrap gap-1">
                            <span class="badge bg-body-secondary text-body">C# 12 / .NET 10</span>
                            <span class="badge bg-body-secondary text-body">ASP.NET Core MVC</span>
                            <span class="badge bg-body-secondary text-body">Dependency Injection</span>
                            <span class="badge bg-body-secondary text-body">HTML5/CSS3 Layouts</span>
                        </div>
                    </div>

                    <!-- Phase 2 -->
                    <div class="timeline-step pb-4 mb-3 border-start border-2 border-warning ps-4 position-relative">
                        <span class="badge bg-warning text-dark position-absolute start-0 top-0 translate-middle rounded-circle p-2">2</span>
                        <h5 class="fw-bold text-gold mb-1">Month 2: Database Mastery, EF Core &amp; REST APIs</h5>
                        <p class="text-secondary small mb-2">Deep dive into SQL Server relational design, indexing, transactions, Entity Framework Core migrations, and building secure RESTful APIs.</p>
                        <div class="d-flex flex-wrap gap-1">
                            <span class="badge bg-body-secondary text-body">SQL Server</span>
                            <span class="badge bg-body-secondary text-body">EF Core Fluent API</span>
                            <span class="badge bg-body-secondary text-body">LINQ Optimization</span>
                            <span class="badge bg-body-secondary text-body">REST Services</span>
                        </div>
                    </div>

                    <!-- Phase 3 -->
                    <div class="timeline-step ps-4 position-relative">
                        <span class="badge bg-success position-absolute start-0 top-0 translate-middle rounded-circle p-2">3</span>
                        <h5 class="fw-bold text-emerald mb-1">Month 3: Production Delivery, DevOps &amp; Quality Engineering</h5>
                        <p class="text-secondary small mb-2">CI/CD pipelines, Docker containerization, unit testing with xUnit, performance profiling, and production bug triage.</p>
                        <div class="d-flex flex-wrap gap-1">
                            <span class="badge bg-body-secondary text-body">Git &amp; GitHub Actions</span>
                            <span class="badge bg-body-secondary text-body">xUnit Testing</span>
                            <span class="badge bg-body-secondary text-body">Performance Auditing</span>
                            <span class="badge bg-body-secondary text-body">Full-Stack Delivery</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mentorship & Senior Leads Column -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill text-gold"></i>
                    <span>Senior Mentors &amp; Leads</span>
                </h5>
                <p class="small text-muted mb-3">Reach out to these team leads for 1-on-1 code reviews and architecture guidance:</p>
                <div class="d-flex flex-column gap-3">
                    @foreach (var emp in employees)
                    {
                        <div class="d-flex align-items-center justify-content-between p-2.5 rounded bg-body-tertiary">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="avatar-circle-mentor">@emp.Name.Substring(0, 1)</div>
                                <div>
                                    <strong class="d-block text-body small">@emp.Name</strong>
                                    <span class="text-muted extra-small">Engineering Lead / Mentor</span>
                                </div>
                            </div>
                            <span class="badge badge-emerald px-2.5 py-1 small">Available</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- TAB 5: YOUTUBE VIDEO REFERENCES -->
@if (activeTab == "youtube")
{
    <!-- Filter Toolbar -->
    <div class="card border-0 shadow-sm mb-4 p-3 glass-card">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <input type="hidden" name="tab" value="youtube" />
            <div class="col-12 col-lg-7">
                <div class="d-flex flex-wrap gap-1">
                    <a asp-action="Index" asp-route-tab="youtube" asp-route-track="all" class="btn btn-sm @(selectedTrack == "all" ? "btn-royal-gold shadow-sm fw-bold" : "btn-dark-carbon") rounded-pill px-3">
                        All Domains
                    </a>
                    @foreach (var tr in tracks)
                    {
                        <a asp-action="Index" asp-route-tab="youtube" asp-route-track="@tr" class="btn btn-sm @(selectedTrack == tr ? "btn-royal-gold shadow-sm fw-bold" : "btn-dark-carbon") rounded-pill px-3">
                            @tr
                        </a>
                    }
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="d-flex gap-2">
                    <div class="input-group input-group-sm flex-grow-1">
                        <input type="text" name="search" value="@search" class="form-control" placeholder="Search YouTube video, mentor, tags..." />
                        <button class="btn btn-royal-gold" type="submit"><i class="bi bi-search"></i></button>
                        @if (!string.IsNullOrWhiteSpace(search) || selectedTrack != "all")
                        {
                            <a asp-action="Index" asp-route-tab="youtube" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-danger d-inline-flex align-items-center gap-1.5 px-3 text-nowrap" data-bs-toggle="modal" data-bs-target="#addYouTubeModal">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>Add Video</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

    @if (!youTubeVideos.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center glass-card">
            <i class="bi bi-youtube text-danger display-4 mb-3"></i>
            <h5 class="fw-bold">No Video References Found</h5>
            <p class="text-muted mb-3">No study videos match the selected track or search filter.</p>
            <div>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#addYouTubeModal">
                    <i class="bi bi-plus-circle me-1"></i> Add First YouTube Reference
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var video in youTubeVideos)
            {
                var diffBadge = video.Difficulty == "Beginner" ? "badge-emerald" :
                                video.Difficulty == "Intermediate" ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-danger-subtle text-danger border border-danger-subtle";

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 border-0 shadow-sm glass-card overflow-hidden d-flex flex-column justify-content-between position-relative hover-lift">
                        <div>
                            <!-- Video Thumbnail with Play Overlay -->
                            <div class="position-relative overflow-hidden" style="background: #000; border-bottom: 1.5px solid rgba(14, 165, 233, 0.2);">
                                <img src="@video.ThumbnailUrl" alt="@video.Title" class="w-100" style="height: 190px; object-fit: cover; opacity: 0.92; transition: transform 0.3s ease;" onerror="this.onerror=null; this.src='/images/it_software_cloud.jpg';" />
                                
                                <!-- Play Button Center Overlay -->
                                <button type="button" class="position-absolute top-50 start-50 translate-middle btn btn-danger rounded-circle shadow-lg d-flex align-items-center justify-content-center p-0 play-btn-overlay" 
                                        style="width: 54px; height: 54px; border: 3px solid rgba(255,255,255,0.9);"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#watchVideoModal"
                                        data-video-id="@video.YouTubeVideoId"
                                        data-video-title="@video.Title"
                                        data-video-track="@video.Track"
                                        title="Watch Video">
                                    <i class="bi bi-play-fill fs-2" style="margin-left: 3px;"></i>
                                </button>

                                <!-- Top Badges -->
                                <div class="position-absolute top-0 start-0 p-2.5 d-flex gap-1.5">
                                    <span class="badge @diffBadge extra-small fw-bold">@video.Difficulty</span>
                                </div>

                                <!-- Duration Badge -->
                                <div class="position-absolute bottom-0 end-0 p-2.5">
                                    <span class="badge bg-dark bg-opacity-85 text-white extra-small font-monospace px-2 py-1">
                                        <i class="bi bi-clock-fill me-1 text-warning"></i>@video.DurationMinutes mins
                                    </span>
                                </div>
                            </div>

                            <!-- Card Body Info -->
                            <div class="p-4">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <span class="badge-track-pill extra-small">
                                        <i class="bi bi-code-square me-1 text-primary"></i>@video.Track
                                    </span>
                                    <span class="extra-small text-muted font-monospace">
                                        <i class="bi bi-calendar3 me-1"></i>@video.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </div>

                                <h5 class="fw-bold text-body mb-2 line-clamp-2" style="font-size: 1.05rem; line-height: 1.4;" title="@video.Title">
                                    @video.Title
                                </h5>

                                <div class="d-flex align-items-center gap-1.5 small text-muted mb-3">
                                    <i class="bi bi-person-check-fill text-gold"></i>
                                    <span class="fw-semibold text-body">@(string.IsNullOrEmpty(video.ChannelOrMentorName) ? "Auxinzio Mentors" : video.ChannelOrMentorName)</span>
                                </div>

                                <p class="text-secondary small mb-3 line-clamp-3" style="line-height: 1.6;">
                                    @video.Description
                                </p>

                                @if (!string.IsNullOrWhiteSpace(video.Tags))
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @foreach (var tag in video.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <span class="badge bg-body-tertiary text-body border border-secondary border-opacity-25 extra-small">
                                                #@tag
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Card Footer Actions: Watch & Attend Topic Test -->
                        <div class="p-3 px-4 bg-body-tertiary border-top border-secondary border-opacity-25 d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-1.5">
                                <button type="button" class="btn btn-danger btn-sm d-inline-flex align-items-center gap-1.5 shadow-sm"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#watchVideoModal"
                                        data-video-id="@video.YouTubeVideoId"
                                        data-video-title="@video.Title"
                                        data-video-track="@video.Track">
                                    <i class="bi bi-play-circle-fill"></i>
                                    <span>Watch Video</span>
                                </button>

                                <button type="button" class="btn btn-royal-gold btn-sm d-inline-flex align-items-center gap-1.5 shadow-sm fw-bold take-test-btn"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#takeTestModal"
                                        data-topic-title="@video.Title"
                                        data-topic-track="@video.Track"
                                        title="Attend test on this learned topic">
                                    <i class="bi bi-patch-check-fill"></i>
                                    <span>Attend Test</span>
                                </button>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <a href="@video.YouTubeUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" title="Open directly on YouTube">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    <span class="d-none d-sm-inline">YouTube</span>
                                </a>

                                <form asp-action="DeleteYouTubeReference" asp-route-id="@video.Id" method="post" onsubmit="return confirm('Are you sure you want to remove this YouTube reference?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove Video">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- ========================================================= -->
<!-- MODAL: INTERACTIVE TOPIC ASSESSMENT QUIZ                  -->
<!-- ========================================================= -->
<div class="modal fade" id="takeTestModal" tabindex="-1" aria-labelledby="takeTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-0 shadow-lg">
            <div class="modal-header border-secondary border-opacity-25 bg-body-tertiary">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-warning text-dark fw-bold px-2.5 py-1">
                            <i class="bi bi-patch-check-fill me-1"></i> Technical Assessment
                        </span>
                        <span class="badge-track-pill" id="quizModalTrackBadge">
                            Backend .NET / C#
                        </span>
                    </div>
                    <h5 class="modal-title fw-bold text-body" id="takeTestModalLabel">
                        Attend Topic Test
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Quiz Step 1: Intern Details & Setup -->
            <div id="quizSetupStep">
                <div class="modal-body">
                    <div class="p-3 rounded-3 bg-body-tertiary border border-secondary border-opacity-15 mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-info-circle-fill text-gold"></i>
                            <span class="fw-bold small text-body">Assessment Instructions:</span>
                        </div>
                        <ul class="extra-small text-secondary mb-0 ps-3">
                            <li>Answer all 25 curated technical and coding questions related to this topic.</li>
                            <li>Instant evaluation upon submission (Passing benchmark: 60%).</li>
                            <li>Your score, percentage, and completion badge will be automatically recorded and displayed on the Hub.</li>
                        </ul>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Your Full Name / Intern ID <span class="text-danger">*</span></label>
                            <input type="text" id="quizInternNameInput" class="form-control" placeholder="e.g. Kavitha R. or Deepak Kumar" required list="internNameList" />
                            <datalist id="internNameList">
                                @foreach (var m in members)
                                {
                                    <option value="@m.Name">@m.Role - @m.Domain</option>
                                }
                            </datalist>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Email Address (Optional)</label>
                            <input type="email" id="quizInternEmailInput" class="form-control" placeholder="intern@company.com" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Topic / Module Being Tested <span class="text-danger">*</span></label>
                            <input type="text" id="quizTopicTitleInput" class="form-control fw-bold" placeholder="Select or type topic name..." required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Domain Track</label>
                            <select id="quizTrackSelect" class="form-select">
                                <option value="Backend .NET / C#">Backend .NET / C#</option>
                                <option value="SQL & Database Design">SQL &amp; Database Design</option>
                                <option value="Frontend & UI/UX">Frontend &amp; UI/UX</option>
                                <option value="Git, DevOps & Cloud">Git, DevOps &amp; Cloud</option>
                                <option value="Software Architecture">Software Architecture</option>
                                <option value="QA & Testing">QA &amp; Testing</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Pass Benchmark</label>
                            <div class="form-control bg-body-tertiary fw-semibold text-emerald">
                                <i class="bi bi-shield-check me-1"></i> 15 of 25 Correct (60% Minimum)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-royal-gold px-4 fw-bold" id="startQuizBtn">
                        <span>Begin Assessment</span>
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>

            <!-- Quiz Step 2: Interactive Questions -->
            <div id="quizQuestionsStep" style="display: none;">
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-15">
                        <div>
                            <span class="small text-muted fw-bold text-uppercase">Candidate:</span>
                            <span class="fw-bold text-gold small ms-1" id="quizDisplayInternName"></span>
                        </div>
                        <div>
                            <span class="badge bg-warning text-dark font-monospace px-2.5 py-1" id="quizQuestionCountBadge">
                                <i class="bi bi-stopwatch me-1"></i> <span id="quizQuestionCountText">25</span> Questions
                            </span>
                        </div>
                    </div>

                    <!-- Questions Container injected via JS -->
                    <div id="quizQuestionsContainer" class="d-flex flex-column gap-4">
                        <!-- Questions rendered here -->
                    </div>
                </div>

                <div class="modal-footer border-secondary border-opacity-25 justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="backToSetupBtn">
                        <i class="bi bi-arrow-left me-1"></i> Back to Setup
                    </button>
                    <button type="button" class="btn btn-emerald px-4 fw-bold shadow-sm" id="submitQuizAnswersBtn">
                        <i class="bi bi-check2-circle me-1"></i> Submit &amp; Calculate Score
                    </button>
                </div>
            </div>

            <!-- Quiz Step 3: Result Scorecard & Submission Form -->
            <div id="quizResultStep" style="display: none;">
                <form asp-action="SubmitOnlineTest" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="internName" id="formInternName" />
                    <input type="hidden" name="internEmail" id="formInternEmail" />
                    <input type="hidden" name="topicTitle" id="formTopicTitle" />
                    <input type="hidden" name="track" id="formTrack" />
                    <input type="hidden" name="score" id="formScore" />
                    <input type="hidden" name="totalQuestions" id="formTotalQuestions" value="25" />

                    <div class="modal-body text-center p-4">
                        <div id="resultIconContainer" class="mb-3">
                            <!-- Trophy or star icon -->
                        </div>

                        <h3 class="fw-extrabold mb-1 text-body" id="resultGradeText">Assessment Completed</h3>
                        <p class="text-secondary small mb-4" id="resultSubtitle">Here is your verified scorecard breakdown</p>

                        <div class="p-4 rounded-4 bg-body-tertiary border border-secondary border-opacity-25 d-inline-block text-center shadow-sm mb-4" style="min-width: 260px;">
                            <div class="extra-small text-muted text-uppercase fw-bold letter-spacing-1 mb-1">Final Score</div>
                            <div class="display-4 fw-extrabold text-gold font-monospace mb-1" id="resultScoreDisplay">5 / 5</div>
                            <div class="badge badge-royal-gold px-3 py-1 fw-bold fs-6" id="resultPercentageBadge">100%</div>
                        </div>

                        <div class="col-12 text-start">
                            <label class="form-label fw-semibold small">Mentor Feedback / Personal Learning Notes</label>
                            <textarea name="feedbackNotes" id="formFeedbackNotes" class="form-control" rows="2" placeholder="Add any takeaways or remarks..."></textarea>
                        </div>
                    </div>

                    <div class="modal-footer border-secondary border-opacity-25">
                        <button type="button" class="btn btn-outline-secondary" id="retakeQuizBtn">
                            <i class="bi bi-arrow-repeat me-1"></i> Retake
                        </button>
                        <button type="submit" class="btn btn-royal-gold px-4 fw-bold shadow-sm">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Save &amp; Upload Result to Hub
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL: UPLOAD TEST RESULT / CERTIFICATE                   -->
<!-- ========================================================= -->
<div class="modal fade" id="uploadTestModal" tabindex="-1" aria-labelledby="uploadTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-0 shadow-lg">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="uploadTestModalLabel">
                    <i class="bi bi-cloud-arrow-up-fill text-emerald"></i>
                    <span>Upload Topic Assessment Result / Certificate</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UploadTestResult" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Intern Name <span class="text-danger">*</span></label>
                            <input type="text" name="InternName" class="form-control" placeholder="e.g. Rahul Sharma" required list="internNameListUpload" />
                            <datalist id="internNameListUpload">
                                @foreach (var m in members)
                                {
                                    <option value="@m.Name">@m.Role - @m.Domain</option>
                                }
                            </datalist>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Intern Email</label>
                            <input type="email" name="InternEmail" class="form-control" placeholder="intern@company.com" />
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold small">Topic / Module Title <span class="text-danger">*</span></label>
                            <input type="text" name="TopicTitle" class="form-control" placeholder="e.g. Entity Framework Core Relational Modeling" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small">Track Domain <span class="text-danger">*</span></label>
                            <select name="Track" class="form-select">
                                <option value="Backend .NET / C#">Backend .NET / C#</option>
                                <option value="SQL & Database Design">SQL &amp; Database Design</option>
                                <option value="Frontend & UI/UX">Frontend &amp; UI/UX</option>
                                <option value="Git, DevOps & Cloud">Git, DevOps &amp; Cloud</option>
                                <option value="Software Architecture">Software Architecture</option>
                                <option value="QA & Testing">QA &amp; Testing</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Score Obtained <span class="text-danger">*</span></label>
                            <input type="number" name="Score" class="form-control" value="5" min="0" max="1000" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Total Maximum Marks / Questions <span class="text-danger">*</span></label>
                            <input type="number" name="TotalQuestions" class="form-control" value="5" min="1" max="1000" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">
                                <i class="bi bi-file-earmark-arrow-up-fill text-emerald me-1"></i> Upload Certificate / Score Screenshot (Optional)
                            </label>
                            <input type="file" name="certificateFile" class="form-control" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx" />
                            <small class="text-muted extra-small">Upload PDF certificate or test scorecard screenshot.</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Mentor Remarks / Assessment Feedback</label>
                            <textarea name="FeedbackNotes" class="form-control" rows="3" placeholder="e.g. Scored 100% on EF Core navigation properties and migration rollback testing..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald px-4 fw-bold">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Test Scorecard
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ADD INTERN / MENTOR (ADMIN ONLY) -->
<div class="modal fade" id="addMemberModal" tabindex="-1" aria-labelledby="addMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-0 shadow-lg">
            <div class="modal-header border-secondary border-opacity-25 bg-body-tertiary">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger text-white rounded-pill px-2.5 py-1 font-monospace">
                        <i class="bi bi-shield-shaded me-1"></i>Admin Only
                    </span>
                    <h5 class="modal-title fw-bold text-body mb-0" id="addMemberModalLabel">
                        <i class="bi bi-person-plus-fill text-emerald me-1"></i>
                        <span>Register Internship Member / Mentor</span>
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddMember" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. Rahul Sharma" required maxlength="150" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Email Address</label>
                            <input type="email" name="Email" class="form-control" placeholder="e.g. rahul@auxinz.io" maxlength="150" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Academy Role <span class="text-danger">*</span></label>
                            <select name="Role" class="form-select">
                                <option value="Intern">Intern</option>
                                <option value="Graduate Trainee">Graduate Trainee</option>
                                <option value="Technical Mentor">Technical Mentor</option>
                                <option value="Senior Lead">Senior Lead Developer</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Domain / Specialization Track <span class="text-danger">*</span></label>
                            <select name="Domain" class="form-select">
                                <option value="Backend .NET / C#">Backend .NET / C#</option>
                                <option value="Frontend & UI/UX">Frontend &amp; UI/UX</option>
                                <option value="SQL & Database Design">SQL &amp; Database Design</option>
                                <option value="Full Stack Architecture">Full Stack Architecture</option>
                                <option value="Git & DevOps">Git, CI/CD &amp; DevOps</option>
                                <option value="QA & Testing">QA &amp; Automation Testing</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Assigned Mentor (for Interns)</label>
                            <select name="MentorName" class="form-select">
                                <option value="">-- Select Assigned Mentor --</option>
                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.Name">@emp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Joining Date</label>
                            <input type="date" name="JoinedDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Notes / Initial Project Focus</label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="e.g. Focus on ASP.NET Core controllers, entity framework models, and frontend integration..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-royal-gold px-4">
                        <i class="bi bi-person-check-fill me-1"></i> Register Member
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ASK A DOUBT -->
<div class="modal fade" id="askDoubtModal" tabindex="-1" aria-labelledby="askDoubtModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-0 shadow-lg">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="askDoubtModalLabel">
                    <i class="bi bi-question-diamond-fill text-warning"></i>
                    <span>Raise a Technical Doubt / Ask Mentors</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AskDoubt" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Your Name / Intern Handle <span class="text-danger">*</span></label>
                            <input type="text" name="InternName" class="form-control" placeholder="e.g. Alex Rivera" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Domain / Technology Track <span class="text-danger">*</span></label>
                            <select name="Domain" class="form-select">
                                <option value=".NET / C#">.NET / C# Backend</option>
                                <option value="ASP.NET MVC">ASP.NET MVC &amp; Razor</option>
                                <option value="SQL Server / EF Core">SQL Server &amp; EF Core</option>
                                <option value="JavaScript / Frontend">JavaScript &amp; Modern UI/UX</option>
                                <option value="Git / GitHub Workflow">Git &amp; Version Control</option>
                                <option value="System Architecture">System Architecture &amp; Clean Code</option>
                                <option value="Debugging & Error">Debugging &amp; Runtime Error</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Urgency Level</label>
                            <select name="Urgency" class="form-select">
                                <option value="Normal">Normal (Conceptual / Study Doubt)</option>
                                <option value="Help Needed Today">Help Needed Today</option>
                                <option value="Blocker / Critical">Blocker / Critical Task Blocker</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Upload Error Screenshot / Diagram</label>
                            <input type="file" name="screenshotFile" class="form-control" accept="image/*" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Doubt Summary / Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control" placeholder="e.g. Why is LINQ throwing NullReferenceException on navigation property?" required maxlength="250" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Detailed Description of Problem <span class="text-danger">*</span></label>
                            <textarea name="Description" class="form-control" rows="4" placeholder="Explain what you are trying to achieve, what unexpected behavior is occurring, and what solutions you have already attempted..." required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Code Snippet (Optional)</label>
                            <textarea name="CodeSnippet" class="form-control font-monospace" rows="3" placeholder="// Paste relevant C#, SQL, or JS code here..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-royal-gold px-4">
                        <i class="bi bi-send-fill me-1"></i> Post Doubt to Forum
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ADD STUDY MATERIAL -->
<div class="modal fade" id="addMaterialModal" tabindex="-1" aria-labelledby="addMaterialModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-0 shadow-lg">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="addMaterialModalLabel">
                    <i class="bi bi-journal-plus text-gold"></i>
                    <span>Add New Internship Study Resource</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddMaterial" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold small">Resource Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control" placeholder="e.g. Master Clean Architecture in ASP.NET Core" required maxlength="200" />
                        </div>
