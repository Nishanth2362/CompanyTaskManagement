@model CompanyTaskManagement.Models.Employee
@{
    ViewData["Title"] = "Add Employee (Admin)";
}

<div class="container py-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
            <li class="breadcrumb-item active" aria-current="page">Add Employee (Admin)</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-danger text-white rounded-pill px-3 py-1 font-monospace">
                    <i class="bi bi-shield-shaded me-1"></i>Administrator Only
                </span>
            </div>
            <h1 class="h2 fw-bold mt-2 mb-1">Add New Employee</h1>
            <p class="text-muted mb-0">Register a new team member to assign them to projects, tasks, and mentorship tracks.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Directory
        </a>
    </div>

    <div class="row g-4">
        <!-- Form Column -->
        <div class="col-12 col-lg-7">
            <div class="glass-card p-4 p-md-5 rounded-4 shadow-sm border">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="bi bi-person text-primary"></i></span>
                            <input asp-for="Name" class="form-control" id="inputEmpName" placeholder="e.g. Alex Henderson" required autofocus />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Corporate Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="bi bi-envelope text-info"></i></span>
                            <input asp-for="Email" type="email" class="form-control font-monospace" id="inputEmpEmail" placeholder="e.g. alex.henderson@auxinz.io" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <div class="form-text small">Corporate login and task notification delivery address.</div>
                    </div>

                    <!-- Designation & Department Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Designation" class="form-label fw-bold">Job Title / Designation</label>
                            <input asp-for="Designation" class="form-control" id="inputEmpDesignation" list="designationSuggestions" placeholder="e.g. Software Engineer" />
                            <datalist id="designationSuggestions">
                                <option value="Lead Full Stack Architect"></option>
                                <option value="Senior Full Stack Engineer"></option>
                                <option value="Frontend Developer"></option>
                                <option value="Backend Specialist"></option>
                                <option value="UI/UX Designer"></option>
                                <option value="QA Automation Lead"></option>
                                <option value="DevOps & Cloud Engineer"></option>
                                <option value="Software Engineering Intern"></option>
                                <option value="Frontend UI/UX Intern"></option>
                                <option value="Backend .NET Intern"></option>
                                <option value="QA & Testing Intern"></option>
                                <option value="Product Manager"></option>
                                <option value="Scrum Master"></option>
                                <option value="HR Specialist"></option>
                            </datalist>
                            <span asp-validation-for="Designation" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Department" class="form-label fw-bold">Department</label>
                            <select asp-for="Department" class="form-select" id="selectEmpDept">
                                <option value="Frontend">Frontend</option>
                                <option value="Backend">Backend</option>
                                <option value="UI / UX Designer">UI / UX Designer</option>
                                <option value="Intern">Intern</option>
                                <option value="Tester">Tester</option>
                            </select>
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Phone Number -->
                    <div class="mb-4">
                        <label asp-for="Phone" class="form-label fw-bold">Phone Number (Optional)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="bi bi-telephone text-success"></i></span>
                            <input asp-for="Phone" class="form-control" id="inputEmpPhone" placeholder="+1 (555) 000-0000" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <!-- Submit Actions -->
                    <div class="d-flex align-items-center gap-3 pt-3 border-top">
                        <button type="submit" class="btn btn-royal-gold px-4 py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-check2-circle fs-5"></i>
                            <span>Add Employee to Directory</span>
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Live Card Preview Column -->
        <div class="col-12 col-lg-5">
            <div class="sticky-top" style="top: 90px;">
                <div class="text-muted small fw-bold text-uppercase mb-2">Live Directory Card Preview</div>
                <div class="glass-card p-4 rounded-4 shadow-sm border border-primary border-opacity-25 position-relative">
                    <div class="position-absolute top-0 end-0 m-3">
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">
                            <i class="bi bi-check-circle-fill me-1"></i>Active Member
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar-initial-circle avatar-color-3 shadow-sm" id="previewEmpAvatar" style="width: 58px; height: 58px; font-size: 1.5rem; font-weight: 800;">
                            A
                        </div>
                        <div class="flex-grow-1 min-w-0 pe-4">
                            <h5 class="fw-bold mb-0 text-truncate" id="previewEmpName">Alex Henderson</h5>
                            <span class="text-muted small d-block text-truncate" id="previewEmpDesignation">Software Engineer</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1 font-monospace small" id="previewEmpDept">
                            Engineering
                        </span>
                    </div>

                    <div class="d-flex flex-column gap-2 text-muted small pt-3 border-top">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope text-primary"></i>
                            <span class="text-truncate font-monospace" id="previewEmpEmail">alex.henderson@auxinz.io</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone text-success"></i>
                            <span id="previewEmpPhone">+1 (555) 000-0000</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-warning"></i>
                            <span>Admin Verified Talent Profile</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function updatePreview() {
                const name = $('#inputEmpName').val().trim() || 'Alex Henderson';
                const initial = name.charAt(0).toUpperCase() || 'A';
                const designation = $('#inputEmpDesignation').val().trim() || 'Software Engineer';
                const department = $('#selectEmpDept').val() || 'Engineering';
                let email = $('#inputEmpEmail').val().trim();
                if (!email) {
                    email = name.toLowerCase().replace(/\s+/g, '.') + '@@auxinz.io';
                }
                const phone = $('#inputEmpPhone').val().trim() || '—';

                $('#previewEmpName').text(name);
                $('#previewEmpAvatar').text(initial);
                $('#previewEmpDesignation').text(designation);
                $('#previewEmpDept').text(department);
                $('#previewEmpEmail').text(email);
                $('#previewEmpPhone').text(phone);
            }

            $('#inputEmpName, #inputEmpEmail, #inputEmpDesignation, #selectEmpDept, #inputEmpPhone').on('input change', updatePreview);
            updatePreview();
        });
    </script>
}
