@model CompanyTaskManagement.Models.Employee
@{
    ViewData["Title"] = $"Edit Employee - {Model.Name}";
}

<div class="container py-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit (Admin)</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-danger text-white rounded-pill px-3 py-1 font-monospace">
                    <i class="bi bi-shield-shaded me-1"></i>Administrator Only
                </span>
            </div>
            <h1 class="h2 fw-bold mt-2 mb-1">Edit Employee Profile</h1>
            <p class="text-muted mb-0">Update employee credentials, corporate department, and designation.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Directory
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="glass-card p-4 p-md-5 rounded-4 shadow-sm border">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="bi bi-person text-primary"></i></span>
                            <input asp-for="Name" class="form-control" required />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Corporate Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="bi bi-envelope text-info"></i></span>
                            <input asp-for="Email" type="email" class="form-control font-monospace" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Designation & Department Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Designation" class="form-label fw-bold">Job Title / Designation</label>
                            <input asp-for="Designation" class="form-control" list="designationSuggestions" />
                            <datalist id="designationSuggestions">
                                <option value="Lead Full Stack Architect"></option>
                                <option value="Senior Full Stack Engineer"></option>
                                <option value="Frontend Developer"></option>
                                <option value="Backend Specialist"></option>
                                <option value="UI/UX Designer"></option>
                                <option value="QA Automation Lead"></option>
                                <option value="DevOps & Cloud Engineer"></option>
                                <option value="Product Manager"></option>
                                <option value="Scrum Master"></option>
                                <option value="HR Specialist"></option>
                            </datalist>
                            <span asp-validation-for="Designation" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Department" class="form-label fw-bold">Department</label>
                            <select asp-for="Department" class="form-select">
                                <option value="Frontend">Frontend</option>
                                <option value="Backend">Backend</option>
                                <option value="UI / UX Designer">UI / UX Designer</option>
                                <option value="Intern">Intern</option>
                                <option value="Tester">Tester</option>
                            </select>
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Phone Number -->
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-bold">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="bi bi-telephone text-success"></i></span>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <!-- Active Status Checkbox -->
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch">
                        <label class="form-check-label fw-bold" for="isActiveSwitch">Active Team Member Status</label>
                    </div>

                    <!-- Submit Actions -->
                    <div class="d-flex align-items-center gap-3 pt-3 border-top">
                        <button type="submit" class="btn btn-royal-gold px-4 py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-save me-1"></i>
                            <span>Save Changes</span>
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
