@model CompanyTaskManagement.Models.Employee
@{
    ViewData["Title"] = $"Employee Profile - {Model.Name}";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var initial = !string.IsNullOrEmpty(Model.Name) ? Model.Name.Substring(0, 1).ToUpper() : "?";
    var colorIdx = Math.Abs((Model.Name ?? "").GetHashCode()) % 7;
    var tasks = Model.TaskEmployees?.Select(te => te.Task).Where(t => t != null).ToList() ?? new List<CompanyTaskManagement.Models.TaskItem>();
    var completedTasks = tasks.Count(t => t.Status == CompanyTaskManagement.Models.TaskStatus.Completed);
    var inProgressTasks = tasks.Count(t => t.Status == CompanyTaskManagement.Models.TaskStatus.InProgress);
    var todoTasks = tasks.Count(t => t.Status == CompanyTaskManagement.Models.TaskStatus.ToDo || t.Status == CompanyTaskManagement.Models.TaskStatus.InReview);
    var completionRate = tasks.Count > 0 ? (int)Math.Round((double)completedTasks / tasks.Count * 100) : 0;
}

<div class="container py-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Hero Card Profile -->
    <div class="glass-card p-4 p-md-5 rounded-4 shadow-sm mb-4 border position-relative overflow-hidden">
        <div class="row align-items-center g-4">
            <div class="col-12 col-md-auto text-center text-md-start">
                <div class="avatar-initial-circle avatar-color-@colorIdx shadow mx-auto" style="width: 85px; height: 85px; font-size: 2.2rem; font-weight: 800;">
                    @initial
                </div>
            </div>
            <div class="col-12 col-md">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h1 class="h2 fw-bold mb-0">@Model.Name</h1>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 font-monospace small">
                        @(Model.Department ?? "Engineering")
                    </span>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">
                            <i class="bi bi-check-circle-fill me-1"></i>Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-muted border rounded-pill px-2.5 py-1 small">
                            Inactive
                        </span>
                    }
                </div>
                <p class="text-muted fs-6 mb-2">@(Model.Designation ?? "Software Engineer")</p>
                
                <div class="d-flex flex-wrap gap-3 text-muted small">
                    <div><i class="bi bi-envelope text-primary me-1"></i>@(Model.Email ?? $"{Model.Name?.ToLower().Replace(" ", ".") ?? "employee"}@auxinz.io")</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <div><i class="bi bi-telephone text-success me-1"></i>@Model.Phone</div>
                    }
                    <div><i class="bi bi-calendar-check text-info me-1"></i>Joined @Model.CreatedAt.ToString("MMM yyyy")</div>
                </div>
            </div>
            <div class="col-12 col-md-auto text-end">
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                    @if (isAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-royal-gold">
                            <i class="bi bi-pencil-square me-1"></i> Edit Profile (Admin)
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Task Performance Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="glass-card stat-card p-3 rounded-4 h-100 border-start border-4 border-primary">
                <div class="text-muted small fw-bold text-uppercase">Total Assigned Tasks</div>
                <h3 class="fw-bold mb-0 text-primary font-monospace mt-1">@tasks.Count</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card stat-card p-3 rounded-4 h-100 border-start border-4 border-success">
                <div class="text-muted small fw-bold text-uppercase">Completed Tasks</div>
                <h3 class="fw-bold mb-0 text-success font-monospace mt-1">@completedTasks</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card stat-card p-3 rounded-4 h-100 border-start border-4 border-warning">
                <div class="text-muted small fw-bold text-uppercase">In Progress</div>
                <h3 class="fw-bold mb-0 text-warning font-monospace mt-1">@inProgressTasks</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card stat-card p-3 rounded-4 h-100 border-start border-4 border-info">
                <div class="text-muted small fw-bold text-uppercase">Completion Rate</div>
                <h3 class="fw-bold mb-0 text-info font-monospace mt-1">@completionRate%</h3>
            </div>
        </div>
    </div>

    <!-- Assigned Tasks Table -->
    <div class="glass-card p-4 rounded-4 shadow-sm border">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">Assigned Tasks (@tasks.Count)</h4>
            @if (User.Identity?.IsAuthenticated == true || true)
            {
                <a asp-controller="Task" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-grid-1x2-fill me-1"></i> View Main Board
                </a>
            }
        </div>

        @if (!tasks.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-clipboard2-check fs-1 d-block mb-2"></i>
                <h5>No Tasks Assigned</h5>
                <p class="small mb-0">This employee currently has no active or pending tasks assigned.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th>Task Name</th>
                            <th>Project</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Companies</th>
                            <th>Due Date</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in tasks)
                        {
                            var priorityCss = t.Priority == CompanyTaskManagement.Models.TaskPriority.Urgent ? "priority-urgent" :
                                              t.Priority == CompanyTaskManagement.Models.TaskPriority.High ? "priority-high" :
                                              t.Priority == CompanyTaskManagement.Models.TaskPriority.Medium ? "priority-medium" : "priority-low";
                            
                            var statusCss = t.Status == CompanyTaskManagement.Models.TaskStatus.Completed ? "status-completed" :
                                            t.Status == CompanyTaskManagement.Models.TaskStatus.InProgress ? "status-inprogress" :
                                            t.Status == CompanyTaskManagement.Models.TaskStatus.InReview ? "status-inreview" : "status-todo";

                            <tr>
                                <td>
                                    <a asp-controller="Task" asp-action="Details" asp-route-id="@t.Id" class="task-title-link">
                                        @t.TaskName
                                    </a>
                                </td>
                                <td>
                                    @if (t.Project != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 small">
                                            <i class="bi bi-folder-fill me-1"></i>@t.Project.ProjectName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted rounded-pill px-2 py-0.5 small">General</span>
                                    }
                                </td>
                                <td>
                                    <span class="priority-badge @priorityCss">@t.Priority</span>
                                </td>
                                <td>
                                    <span class="status-pill @statusCss">@t.Status</span>
                                </td>
                                <td>
                                    @if (t.TaskCompanies != null && t.TaskCompanies.Any())
                                    {
                                        <span>@string.Join(", ", t.TaskCompanies.Select(tc => tc.Company?.Name))</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @(t.DueDate?.ToString("MMM dd, yyyy") ?? "No Due Date")
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Task" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary" title="View Task Details">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
