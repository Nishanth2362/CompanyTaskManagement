@model IEnumerable<CompanyTaskManagement.Models.Employee>
@{
    ViewData["Title"] = "Employees Directory";
    var currentRole = ViewBag.CurrentRole as CompanyTaskManagement.Models.UserRole? ?? CompanyTaskManagement.Models.UserRole.Employee;
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var selectedDept = ViewBag.SelectedDepartment as string ?? "all";
    var search = ViewBag.Search as string ?? "";
    var totalEmployees = ViewBag.TotalEmployees as int? ?? Model.Count();
    var seniorMentors = ViewBag.SeniorMentors as List<CompanyTaskManagement.Models.Employee> ?? new List<CompanyTaskManagement.Models.Employee>();
}

<!-- Notification Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-shield-lock-fill fs-5 text-danger"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-start align-items-md-center flex-column flex-md-row gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h2 fw-bold mb-0">Employees Directory</h1>
            </div>
            <p class="text-muted mb-0">Enterprise talent pool, team designations, department assignments, workload status, and internship cohort.</p>
        </div>

        <!-- Admin Only Action Buttons -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-royal-gold d-flex align-items-center gap-2 shadow">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Add Employee (Admin)</span>
                </a>
                <button type="button" class="btn btn-emerald d-flex align-items-center gap-2 shadow" data-bs-toggle="modal" data-bs-target="#addInternModal">
                    <i class="bi bi-mortarboard-fill"></i>
                    <span>Add Intern (Admin)</span>
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-2 opacity-75" title="Only Administrator has permission to add new employees" disabled>
                    <i class="bi bi-lock-fill text-danger"></i>
                    <span>Add Employee (Admin Only)</span>
                </button>
                <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-2 opacity-75" title="Only Administrator has permission to add new interns" disabled>
                    <i class="bi bi-lock-fill text-danger"></i>
                    <span>Add Intern (Admin Only)</span>
                </button>
            }
        </div>
    </div>

    <!-- Metrics Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="stat-card h-100 p-3 rounded-4" style="border-left: 4px solid #0284c7 !important;">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <div class="stat-label" style="font-size: 0.72rem;">TOTAL TALENT</div>
                        <div class="stat-number text-sky" style="font-size: 1.6rem;">@totalEmployees</div>
                    </div>
                    <div class="stat-icon stat-icon-sky" style="width: 44px; height: 44px; min-width: 44px; border-radius: 12px; font-size: 1.25rem;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="stat-card h-100 p-3 rounded-4" style="border-left: 4px solid #0ea5e9 !important;">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <div class="stat-label" style="font-size: 0.72rem;">FRONTEND</div>
                        <div class="stat-number text-info" style="font-size: 1.6rem;">@ViewBag.FrontendCount</div>
                    </div>
                    <div class="stat-icon" style="width: 44px; height: 44px; min-width: 44px; border-radius: 12px; font-size: 1.25rem; background: rgba(14, 165, 233, 0.12); color: #0ea5e9; border: 1px solid rgba(14, 165, 233, 0.25);">
                        <i class="bi bi-code-slash"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="stat-card h-100 p-3 rounded-4" style="border-left: 4px solid #6366f1 !important;">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <div class="stat-label" style="font-size: 0.72rem;">BACKEND</div>
                        <div class="stat-number" style="font-size: 1.6rem; color: #6366f1;">@ViewBag.BackendCount</div>
                    </div>
                    <div class="stat-icon" style="width: 44px; height: 44px; min-width: 44px; border-radius: 12px; font-size: 1.25rem; background: rgba(99, 102, 241, 0.12); color: #6366f1; border: 1px solid rgba(99, 102, 241, 0.25);">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="stat-card h-100 p-3 rounded-4" style="border-left: 4px solid #f59e0b !important;">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <div class="stat-label" style="font-size: 0.72rem;">UI / UX DESIGN</div>
                        <div class="stat-number text-gold" style="font-size: 1.6rem;">@ViewBag.DesignCount</div>
                    </div>
                    <div class="stat-icon stat-icon-amber" style="width: 44px; height: 44px; min-width: 44px; border-radius: 12px; font-size: 1.25rem;">
                        <i class="bi bi-palette-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="stat-card h-100 p-3 rounded-4" style="border-left: 4px solid #10b981 !important;">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <div class="stat-label" style="font-size: 0.72rem;">TESTER</div>
                        <div class="stat-number text-emerald" style="font-size: 1.6rem;">@ViewBag.TesterCount</div>
                    </div>
                    <div class="stat-icon stat-icon-emerald" style="width: 44px; height: 44px; min-width: 44px; border-radius: 12px; font-size: 1.25rem;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="stat-card h-100 p-3 rounded-4" style="border-left: 4px solid #8b5cf6 !important;">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <div class="stat-label" style="font-size: 0.72rem;">INTERN</div>
                        <div class="stat-number text-amethyst" style="font-size: 1.6rem; color: #8b5cf6 !important;">@ViewBag.InternsCount</div>
                    </div>
                    <div class="stat-icon stat-icon-amethyst" style="width: 44px; height: 44px; min-width: 44px; border-radius: 12px; font-size: 1.25rem; background: rgba(139, 92, 246, 0.14); color: #8b5cf6; border: 1px solid rgba(139, 92, 246, 0.3);">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar & Search -->
    <div class="glass-card p-3 rounded-4 mb-4 shadow-sm">
        <div class="row g-3 align-items-center">
            <!-- Department Tabs -->
            <div class="col-12 col-lg-7">
                <div class="d-flex flex-wrap gap-1.5">
                    <a asp-action="Index" asp-route-department="all" asp-route-search="@search" 
                       class="btn btn-sm @(selectedDept == "all" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                        All
                    </a>
                    <a asp-action="Index" asp-route-department="Frontend" asp-route-search="@search" 
                       class="btn btn-sm @(selectedDept.Equals("Frontend", StringComparison.OrdinalIgnoreCase) ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                        Frontend
                    </a>
                    <a asp-action="Index" asp-route-department="Backend" asp-route-search="@search" 
                       class="btn btn-sm @(selectedDept.Equals("Backend", StringComparison.OrdinalIgnoreCase) ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                        Backend
                    </a>
                    <a asp-action="Index" asp-route-department="UI / UX Designer" asp-route-search="@search" 
                       class="btn btn-sm @(selectedDept.Equals("UI / UX Designer", StringComparison.OrdinalIgnoreCase) ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                        UI / UX Designer
                    </a>
                    <a asp-action="Index" asp-route-department="Intern" asp-route-search="@search" 
                       class="btn btn-sm @(selectedDept.Equals("Intern", StringComparison.OrdinalIgnoreCase) || selectedDept.Equals("Internship", StringComparison.OrdinalIgnoreCase) ? "btn-royal-gold fw-bold shadow-sm" : "btn-outline-secondary") rounded-pill px-3 d-inline-flex align-items-center gap-1">
                        <i class="bi bi-mortarboard-fill"></i>
                        <span>Intern</span>
                        @if (ViewBag.InternsCount > 0)
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-1.5 ms-0.5">@ViewBag.InternsCount</span>
                        }
                    </a>
                    <a asp-action="Index" asp-route-department="Tester" asp-route-search="@search" 
                       class="btn btn-sm @(selectedDept.Equals("Tester", StringComparison.OrdinalIgnoreCase) ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                        Tester
                    </a>
                </div>
            </div>

            <!-- Search Form -->
            <div class="col-12 col-lg-5">
                <form asp-action="Index" method="get" class="w-100">
                    <input type="hidden" name="department" value="@selectedDept" />
                    <div class="input-group input-group-sm rounded-pill overflow-hidden border shadow-sm bg-body p-0.5">
                        <span class="input-group-text bg-transparent border-0 ps-3 pe-2"><i class="bi bi-search text-primary"></i></span>
                        <input type="text" name="search" value="@search" class="form-control border-0 shadow-none ps-0" placeholder="Search by name, role, email..." />
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <a asp-action="Index" asp-route-department="@selectedDept" class="btn border-0 bg-transparent text-muted pe-2" title="Clear search">
                                <i class="bi bi-x-circle-fill"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary rounded-pill px-3 font-monospace fw-medium">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Employee Cards Grid -->
    @if (!Model.Any())
    {
        <div class="glass-card p-5 rounded-4 text-center">
            <div class="rounded-circle bg-secondary-subtle p-3 d-inline-block mb-3">
                <i class="bi bi-person-x text-muted fs-1"></i>
            </div>
            <h4 class="fw-bold">No Members Found</h4>
            <p class="text-muted mb-3">No team members or interns match your current filter or search criteria.</p>
            @if (isAdmin)
            {
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Create" class="btn btn-royal-gold">
                        <i class="bi bi-person-plus-fill me-1"></i> Add Employee
                    </a>
                    <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#addInternModal">
                        <i class="bi bi-mortarboard-fill me-1"></i> Add Intern
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row g-3">
            @{ int empIdx = 0; }
            @foreach (var emp in Model)
            {
                var initial = !string.IsNullOrEmpty(emp.Name) ? emp.Name.Substring(0, 1).ToUpper() : "?";
                var colorIdx = Math.Abs((emp.Name ?? "").GetHashCode()) % 7;
                var assignedTasksCount = emp.TaskEmployees?.Count ?? 0;
                var isIntern = (emp.Department != null && (emp.Department.Equals("Intern", StringComparison.OrdinalIgnoreCase) || emp.Department.Equals("Internship", StringComparison.OrdinalIgnoreCase))) || 
                               (emp.Designation != null && emp.Designation.ToLower().Contains("intern"));

                var deptColor = isIntern ? "warning" :
                                emp.Department == "Frontend" ? "info" : 
                                emp.Department == "Backend" ? "primary" : 
                                emp.Department == "UI / UX Designer" ? "warning" : 
                                emp.Department == "Tester" ? "success" : "secondary";

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="glass-card p-4 rounded-4 h-100 shadow-sm transition-hover position-relative overflow-hidden">
                        <!-- Top Header -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="avatar-initial-circle avatar-color-@colorIdx shadow-sm" style="width: 52px; height: 52px; font-size: 1.35rem; font-weight: 800;">
                                @initial
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <h5 class="fw-bold mb-0 text-truncate">
                                    <a asp-action="Details" asp-route-id="@emp.Id" class="text-reset text-decoration-none hover-primary">
                                        @emp.Name
                                    </a>
                                </h5>
                                <span class="text-muted small d-block text-truncate">@(emp.Designation ?? "Team Member")</span>
                            </div>

                            @if (isIntern)
                            {
                                <span style="display:inline-flex; align-items:center; gap:0.3rem; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #fff; font-weight: 700; font-size: 0.78rem; padding: 0.3rem 0.75rem; border-radius: 999px; letter-spacing: 0.02em; box-shadow: 0 2px 8px rgba(217,119,6,0.35); white-space: nowrap;">
                                    <i class="bi bi-mortarboard-fill"></i> Intern
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-@deptColor-subtle text-@deptColor border border-@deptColor-subtle rounded-pill px-2.5 py-1 small">
                                    @(emp.Department ?? "General")
                                </span>
                            }
                        </div>

                        <!-- Info Rows -->
                        <div class="d-flex flex-column gap-1.5 mb-3 text-muted small">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-envelope text-primary"></i>
                                <span class="text-truncate font-monospace">@(emp.Email ?? $"{emp.Name?.ToLower().Replace(" ", ".") ?? "employee"}@auxinz.io")</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-list-task text-warning"></i>
                                <span>Assigned to <strong class="text-main">@assignedTasksCount</strong> active task(s)</span>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-person-lines-fill me-1"></i> Profile &amp; Tasks
                            </a>

                            @if (isAdmin)
                            {
                                <div class="d-flex align-items-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-warning" title="Edit Record">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@emp.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove @emp.Name from directory?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Record">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                empIdx++;
            }
        </div>
    }
</div>

<!-- ========================================================= -->
<!-- MODAL: ADD INTERN (ADMIN ONLY)                            -->
<!-- ========================================================= -->
@if (isAdmin)
{
    <div class="modal fade" id="addInternModal" tabindex="-1" aria-labelledby="addInternModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content glass-card border-0 shadow-lg">
                <div class="modal-header border-secondary border-opacity-25 bg-body-tertiary">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger text-white rounded-pill px-2.5 py-1 font-monospace">
                            <i class="bi bi-shield-shaded me-1"></i>Admin Only
                        </span>
                        <h5 class="modal-title fw-bold text-body mb-0" id="addInternModalLabel">
                            <i class="bi bi-mortarboard-fill text-emerald me-1"></i> Register New Intern
                        </h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="AddIntern" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Intern Full Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary border-secondary border-opacity-25">
                                        <i class="bi bi-person text-emerald"></i>
                                    </span>
                                    <input type="text" name="name" class="form-control" placeholder="e.g. Rahul Sharma" required />
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary border-secondary border-opacity-25">
                                        <i class="bi bi-envelope text-primary"></i>
                                    </span>
                                    <input type="email" name="email" class="form-control font-monospace" placeholder="e.g. rahul@auxinz.io" />
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Specialization Domain Track <span class="text-danger">*</span></label>
                                <select name="domain" class="form-select">
                                    <option value="Backend .NET / C#">Backend .NET / C#</option>
                                    <option value="Frontend & UI/UX">Frontend &amp; UI/UX</option>
                                    <option value="SQL & Database Design">SQL &amp; Database Design</option>
                                    <option value="Full Stack Architecture">Full Stack Architecture</option>
                                    <option value="Git & DevOps">Git, CI/CD &amp; DevOps</option>
                                    <option value="QA & Testing">QA &amp; Automation Testing</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Assigned Senior Mentor</label>
                                <select name="mentorName" class="form-select">
                                    <option value="">-- Select Mentor --</option>
                                    @foreach (var mentor in seniorMentors)
                                    {
                                        <option value="@mentor.Name">@mentor.Name (@mentor.Designation)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Phone Number (Optional)</label>
                                <input type="text" name="phone" class="form-control" placeholder="+91 98765 43210" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Joining Date</label>
                                <input type="date" name="joinedDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Notes / Initial Project Focus</label>
                                <textarea name="notes" class="form-control" rows="2" placeholder="e.g. Assigned to ASP.NET Core MVC task management and REST API modules..."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary border-opacity-25 bg-body-tertiary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald px-4 fw-bold">
                            <i class="bi bi-person-check-fill me-1"></i> Register Intern (Admin)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
