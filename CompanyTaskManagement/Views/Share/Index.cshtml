                <button type="button" class="btn btn-primary fw-bold rounded-pill d-flex align-items-center gap-2 px-4"
                        onclick="submitFeedback()" id="submitFeedbackBtn">
                    <i class="bi bi-send-fill"></i> Submit Feedback
