     MODAL: Give Feedback
============================================================ -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-2" style="background: linear-gradient(135deg, #0284c7, #0369a1); color: white;">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="feedbackModalLabel" style="font-family: 'Outfit', sans-serif;">
                    <i class="bi bi-chat-dots-fill text-info"></i>
                    Give Peer Feedback
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3 p-3 rounded-3" style="background: rgba(139,92,246,0.07); border: 1px solid rgba(139,92,246,0.15);">
                    <div class="small text-muted mb-1">Reviewing:</div>
                    <div class="fw-bold text-body small" id="feedbackPostTitle">-</div>
                </div>
                <input type="hidden" id="feedbackPostId" value="" />

                <div class="row g-3">
                    <!-- Colleague Name -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold small">Your Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="fbName" placeholder="e.g. Mujimal" maxlength="100" />
                    </div>

                    <!-- Colleague Role -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold small">Your Role</label>
                        <input type="text" class="form-control" id="fbRole" placeholder="e.g. Frontend Developer" maxlength="100" />
                    </div>

                    <!-- Sentiment -->
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Feedback Type <span class="text-danger">*</span></label>
                        <div class="d-flex flex-wrap gap-2" id="sentimentSelector">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill fw-semibold sentiment-btn" data-value="1">🌟 Impressive</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill fw-semibold sentiment-btn" data-value="2">💡 Suggestion</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill fw-semibold sentiment-btn" data-value="3">🐞 Bug Found</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill fw-semibold sentiment-btn" data-value="4">🚀 Ready to Ship</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill fw-semibold sentiment-btn" data-value="5">🎨 Design Feedback</button>
                        </div>
                        <input type="hidden" id="fbSentiment" value="2" />
                    </div>

                    <!-- Star Rating -->
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Rating</label>
                        <div class="d-flex gap-2" id="starRatingInput">
