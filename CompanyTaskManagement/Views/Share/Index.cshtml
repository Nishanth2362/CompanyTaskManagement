     MODAL: Image Lightbox
============================================================ -->
<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true" style="z-index: 1070;">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1) grayscale(100%) brightness(200%); z-index: 1080;"></button>
            </div>
            <div class="modal-body text-center p-0" style="position: relative;">
                <img id="lightboxImage" src="" class="img-fluid rounded shadow-lg" style="max-height: 85vh;" alt="Enlarged Screenshot" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ====== Lightbox ======
    function openLightbox(url) {
        document.getElementById('lightboxImage').src = url;
        new bootstrap.Modal(document.getElementById('lightboxModal')).show();
    }

    // ====== Category Filter ======
    function setCategory(val) {
        document.getElementById('categoryInput').value = val;
        document.getElementById('filterForm').submit();
    }

    // Search with debounce
    let searchTimer;
    document.getElementById('searchInput').addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => document.getElementById('filterForm').submit(), 600);
    });

    // ====== Like / Upvote ======
    function toggleLike(postId, btn) {
        fetch('/Share/ToggleLike', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
            body: JSON.stringify({ PostId: postId })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById('like-count-' + postId).textContent = data.likesCount;
                btn.classList.toggle('liked', data.liked);
                const icon = btn.querySelector('i');
                if (data.liked) {
                    icon.style.color = '#ef4444';
                    btn.style.color = '#ef4444';
                } else {
                    icon.style.color = '';
                    btn.style.color = '';
                }
            }
        });
    }

    // ====== Toggle Feedback Panel ======
    function toggleFeedbackPanel(postId, btn) {
        const feedbackPanel = document.getElementById('feedback-panel-' + postId);
        const replyPanel = document.getElementById('reply-panel-' + postId);
        const replyBtn = document.getElementById('reply-toggle-' + postId);
        
        if (!feedbackPanel) return;

        const isVisible = feedbackPanel.style.display !== 'none';

        if (isVisible) {
            feedbackPanel.style.display = 'none';
            if (btn) btn.classList.remove('active');
        } else {
            // Close reply panel if open
            if (replyPanel) replyPanel.style.display = 'none';
            if (replyBtn) replyBtn.classList.remove('active');

            feedbackPanel.style.display = 'block';
            if (btn) btn.classList.add('active');
        }
    }

    // ====== Load All Feedbacks via AJAX ======
    function loadAllFeedbacks(postId) {
        fetch('/Share/GetFeedbacks?postId=' + postId)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const list = document.getElementById('feedback-list-' + postId);
                if (data.feedbacks.length === 0) {
                    list.innerHTML = '<div class="text-center py-4 text-muted small"><i class="bi bi-chat-dots fs-4 d-block mb-1 opacity-50"></i>No feedback yet.</div>';
                    return;
                }
                list.innerHTML = data.feedbacks.map(fb => `
                    <div class="feedback-item d-flex gap-2">
                        <div class="feedback-avatar">${fb.authorInitials}</div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                <span class="fw-semibold small">${fb.collegaueName || fb.authorInitials}</span>
                                <span class="badge rounded-pill px-2" style="font-size:0.62rem; background:rgba(139,92,246,0.1); color:#7c3aed;">${fb.colleagueRole || 'Team Member'}</span>
                                <span class="star-rating">${'★'.repeat(fb.rating)}<span class="star-empty">${'★'.repeat(5 - fb.rating)}</span></span>
                            </div>
                            <p class="small mb-0 text-body">${fb.comment}</p>
                            ${fb.screenshotPath ? `<div class="mt-2">
                                                    <a href="javascript:void(0);" onclick="openLightbox('${fb.screenshotPath}')">
                                                        <img src="${fb.screenshotPath}" alt="Screenshot" class="img-fluid rounded border" style="max-height: 120px; object-fit: cover;" />
                                                    </a>
                                                   </div>` : ''}
                            <div class="text-muted" style="font-size:0.65rem;margin-top:4px;">${fb.createdAt}</div>
                        </div>
                    </div>
                `).join('');
            }
        });
    }

    // ====== Open Feedback Modal ======
    function openFeedbackModal(postId, title) {
        document.getElementById('feedbackPostId').value = postId;
        document.getElementById('feedbackPostTitle').textContent = title;
        document.getElementById('fbName').value = '';
        document.getElementById('fbRole').value = '';
        document.getElementById('fbEmail').value = '';
        document.getElementById('fbComment').value = '';
        document.getElementById('fbSentiment').value = '2';
        document.getElementById('fbRating').value = '5';
        // Reset sentiment buttons
        document.querySelectorAll('.sentiment-btn').forEach(b => b.classList.remove('btn-primary', 'active'));
        document.querySelector('.sentiment-btn[data-value="2"]').classList.add('btn-primary', 'active');
        // Reset stars
        updateStarDisplay(5);
        var modal = new bootstrap.Modal(document.getElementById('feedbackModal'));
        modal.show();
    }

    // ====== Sentiment Selector ======
    document.querySelectorAll('.sentiment-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.sentiment-btn').forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-outline-secondary');
            });
            this.classList.remove('btn-outline-secondary');
            this.classList.add('btn-primary', 'active');
            document.getElementById('fbSentiment').value = this.dataset.value;
        });
    });

    // ====== Star Rating ======
    function updateStarDisplay(rating) {
        document.querySelectorAll('.star-btn').forEach(s => {
            s.style.color = parseInt(s.dataset.value) <= rating ? '#f59e0b' : '#d1d5db';
        });
    }

    document.querySelectorAll('.star-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            document.getElementById('fbRating').value = this.dataset.value;
            updateStarDisplay(parseInt(this.dataset.value));
        });
        btn.addEventListener('mouseenter', function () {
            updateStarDisplay(parseInt(this.dataset.value));
        });
        btn.addEventListener('mouseleave', function () {
            updateStarDisplay(parseInt(document.getElementById('fbRating').value));
        });
    });

    // Initialize stars to 5
    updateStarDisplay(5);

    // ====== Submit Feedback ======
    function submitFeedback() {
        const name = document.getElementById('fbName').value.trim();
        const comment = document.getElementById('fbComment').value.trim();
        const postId = parseInt(document.getElementById('feedbackPostId').value);

        if (!name || !comment) {
            alert('Please enter your name and feedback comment.');
            return;
        }

        const btn = document.getElementById('submitFeedbackBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Submitting...';

        const formData = new FormData();
        formData.append('PostId', postId);
        formData.append('ColleagueName', name);
        formData.append('ColleagueEmail', document.getElementById('fbEmail').value.trim());
        formData.append('ColleagueRole', document.getElementById('fbRole').value.trim() || 'Team Member');
        formData.append('Sentiment', document.getElementById('fbSentiment').value);
        formData.append('Rating', document.getElementById('fbRating').value);
        formData.append('Comment', comment);

        const screenshotFile = document.getElementById('fbScreenshot').files[0];
        if (screenshotFile) {
            formData.append('Screenshot', screenshotFile);
        }

        fetch('/Share/AddFeedback', {
            method: 'POST',
            headers: { 'RequestVerificationToken': getAntiForgeryToken() },
            body: formData
        })
        .then(r => r.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send-fill"></i> Submit Feedback';
            if (data.success) {
                // Update feedback count
                const countBadge = document.getElementById('feedback-count-badge-' + postId);
                const panelCount = document.getElementById('panel-feedback-count-' + postId);
                const newCount = data.feedbackCount;
                if (countBadge) countBadge.textContent = newCount;
                if (panelCount) panelCount.textContent = newCount;

                // Append to panel list
                const list = document.getElementById('feedback-list-' + postId);
                if (list) {
                    const noFeedback = list.querySelector('.text-center.py-4');
                    if (noFeedback) noFeedback.remove();

                    const stars = '★'.repeat(formData.get('Rating')) + '<span style="color:#d1d5db">' + '★'.repeat(5 - formData.get('Rating')) + '</span>';
                    
                    let screenshotHtml = '';
                    if (data.screenshotPath) {
                        screenshotHtml = `<div class="mt-2">
                                            <a href="javascript:void(0);" onclick="openLightbox('${data.screenshotPath}')">
                                                <img src="${data.screenshotPath}" alt="Screenshot" class="img-fluid rounded border" style="max-height: 120px; object-fit: cover;" />
                                            </a>
                                          </div>`;
                    }

                    const itemHtml = `
                        <div class="feedback-item d-flex gap-2">
                            <div class="feedback-avatar">${data.authorInitials}</div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <span class="fw-semibold small">${data.authorName}</span>
                                    <span class="badge rounded-pill px-2" style="font-size:0.62rem; background:rgba(139,92,246,0.1); color:#7c3aed;">${data.authorRole}</span>
                                    <span class="star-rating" style="font-size:0.7rem;">${stars}</span>
                                </div>
                                <p class="small mb-0 text-body">${formData.get('Comment')}</p>
                                ${screenshotHtml}
                                <div class="text-muted" style="font-size:0.65rem;margin-top:4px;">${data.createdAt}</div>
                            </div>
                        </div>`;
                    list.insertAdjacentHTML('afterbegin', itemHtml);

                    // Make panel visible
                    const panel = document.getElementById('feedback-panel-' + postId);
                    if (panel) panel.style.display = 'block';
                }

                bootstrap.Modal.getInstance(document.getElementById('feedbackModal')).hide();
                // Clear screenshot input for next time
                document.getElementById('fbScreenshot').value = '';
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send-fill"></i> Submit Feedback';
            alert('An error occurred. Please try again.');
        });
    }

    // ====== Copy Link ======
    function copyLink(url, btn) {
        navigator.clipboard.writeText(url).then(() => {
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Copied!';
            btn.style.color = '#10b981';
            setTimeout(() => {
                btn.innerHTML = original;
                btn.style.color = '';
            }, 2000);
        });
    }

    // ====== Anti-forgery token helper ======
    function getAntiForgeryToken() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        return token ? token.value : '';
    }

    // ======================================================
    // REACTIONS (OK / Not OK / Needs Work / Approved / Has Issues)
    // ======================================================

    const REACTION_ACTIVE_CLASS = { 1: 'active-ok', 2: 'active-notok', 3: 'active-needs', 4: 'active-appr', 5: 'active-issues' };

    function sendReaction(postId, reactionType, btn) {
        // Ask for reactor name if not already stored
        const nameKey = 'shareHub_name';
        let reactorName = sessionStorage.getItem(nameKey);
        if (!reactorName) {
            reactorName = prompt('Enter your name to react:', '');
            if (!reactorName || !reactorName.trim()) return;
            sessionStorage.setItem(nameKey, reactorName.trim());
        }

        fetch('/Share/AddReaction', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
            body: JSON.stringify({ PostId: postId, ReactorName: reactorName.trim(), ReactionType: reactionType })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                // Update all reaction counts for this post
                const countMap = {};
                (data.counts || []).forEach(c => countMap[c.type] = c.count);

                for (let t = 1; t <= 5; t++) {
                    const countEl = document.getElementById(`react-${t}-${postId}`);
                    if (countEl) countEl.textContent = countMap[t] || 0;

                    // Update active state for all sibling buttons
                    const btnEl = document.querySelector(`.reaction-btn[data-post="${postId}"][data-type="${t}"]`);
                    if (btnEl) {
                        Object.values(REACTION_ACTIVE_CLASS).forEach(cls => btnEl.classList.remove(cls));
                    }
                }

                // Highlight the chosen reaction if toggled on
                if (data.toggled) {
                    Object.values(REACTION_ACTIVE_CLASS).forEach(cls => btn.classList.remove(cls));
                    btn.classList.add(REACTION_ACTIVE_CLASS[reactionType]);

                    // Micro-animation
                    btn.style.transform = 'scale(1.15)';
                    setTimeout(() => btn.style.transform = '', 300);
                }
            }
        });
    }

    // ======================================================
    // REPLY / COMMENT THREAD
    // ======================================================

    function toggleReplyPanel(postId, toggleBtn) {
        const replyPanel = document.getElementById(`reply-panel-${postId}`);
        const feedbackPanel = document.getElementById(`feedback-panel-${postId}`);
        const feedbackBtn = document.getElementById(`feedback-toggle-${postId}`);

        if (!replyPanel) return;

        const isVisible = replyPanel.style.display !== 'none';

        if (isVisible) {
            replyPanel.style.display = 'none';
            if (toggleBtn) toggleBtn.classList.remove('active');
        } else {
            // Close feedback panel if open
            if (feedbackPanel) feedbackPanel.style.display = 'none';
            if (feedbackBtn) feedbackBtn.classList.remove('active');

            replyPanel.style.display = 'block';
            if (toggleBtn) toggleBtn.classList.add('active');
            loadReplies(postId);
        }
    }

    function loadReplies(postId) {
        fetch(`/Share/GetReplies?postId=${postId}`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) return;
            const list = document.getElementById(`reply-list-${postId}`);
            if (!list) return;

            // Update count badges
            const count = data.replies.length;
            const badge = document.getElementById(`reply-count-badge-${postId}`);
            const panelBadge = document.getElementById(`panel-reply-count-${postId}`);
            if (badge) badge.textContent = count;
            if (panelBadge) panelBadge.textContent = count;

            if (count === 0) {
                list.innerHTML = `
                    <div class="text-center py-3 text-muted small reply-empty-msg">
                        <i class="bi bi-chat-square-text opacity-50 d-block fs-5 mb-1"></i>
                        No replies yet — be the first to reply!
                    </div>`;
                return;
            }

            list.innerHTML = data.replies.map(r => `
                <div class="reply-item">
                    <div class="reply-avatar">${r.authorInitials}</div>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <span class="fw-semibold small">${r.authorName}</span>
                            <span class="badge rounded-pill px-2" style="font-size:0.6rem; background:rgba(124,58,237,0.1); color:#7c3aed;">${r.authorRole || 'Team Member'}</span>
                            <span class="text-muted ms-auto" style="font-size:0.62rem;">${r.createdAt}</span>
                        </div>
                        <p class="mb-0 text-body" style="font-size:0.8rem; line-height:1.5;">${escapeHtml(r.replyText)}</p>
                    </div>
                </div>
            `).join('');
        });
    }

    function submitReply(postId, btn) {
        const nameEl = document.getElementById(`reply-name-${postId}`);
        const roleEl = document.getElementById(`reply-role-${postId}`);
        const textEl = document.getElementById(`reply-text-${postId}`);

        const name = nameEl?.value.trim();
        const role = roleEl?.value || 'Team Member';
        const text = textEl?.value.trim();

        if (!name) { nameEl?.focus(); nameEl?.classList.add('is-invalid'); return; }
        if (!text) { textEl?.focus(); textEl?.classList.add('is-invalid'); return; }

        nameEl.classList.remove('is-invalid');
        textEl.classList.remove('is-invalid');

        // Store name for session convenience
        sessionStorage.setItem('shareHub_name', name);

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        fetch('/Share/AddReply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
            body: JSON.stringify({ PostId: postId, AuthorName: name, AuthorRole: role, ReplyText: text })
        })
        .then(r => r.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;

            if (data.success) {
                textEl.value = '';

                // Update counts
                const badge = document.getElementById(`reply-count-badge-${postId}`);
                const panelBadge = document.getElementById(`panel-reply-count-${postId}`);
                if (badge) badge.textContent = data.replyCount;
                if (panelBadge) panelBadge.textContent = data.replyCount;

                // Prepend new reply to list
                const list = document.getElementById(`reply-list-${postId}`);
                const empty = list?.querySelector('.reply-empty-msg');
                if (empty) empty.remove();

                const newItem = document.createElement('div');
                newItem.className = 'reply-item';
                newItem.style.background = 'rgba(124,58,237,0.05)';
                newItem.innerHTML = `
                    <div class="reply-avatar">${data.authorInitials}</div>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <span class="fw-semibold small">${data.authorName}</span>
                            <span class="badge rounded-pill px-2" style="font-size:0.6rem; background:rgba(124,58,237,0.1); color:#7c3aed;">${data.authorRole}</span>
                            <span class="text-muted ms-auto" style="font-size:0.62rem;">${data.createdAt}</span>
                        </div>
                        <p class="mb-0 text-body" style="font-size:0.8rem; line-height:1.5;">${escapeHtml(data.replyText)}</p>
                    </div>`;

                if (list) {
                    list.appendChild(newItem);
                    newItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    // Fade in
                    setTimeout(() => newItem.style.background = '', 1500);
                }
            } else {
                alert('Could not submit reply: ' + data.message);
            }
        })
        .catch(() => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            alert('Network error. Please try again.');
        });
    }

    // ======================================================
    // Prefill name in reply boxes from session storage
    // ======================================================
    document.addEventListener('DOMContentLoaded', () => {
        const savedName = sessionStorage.getItem('shareHub_name');
        if (savedName) {
            document.querySelectorAll('[id^="reply-name-"]').forEach(el => {
                if (!el.value) el.value = savedName;
            });
        }
    });

    // Escape HTML helper (prevent XSS in JS-rendered content)
    function escapeHtml(str) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    // ======================================================
    // Copy Google Meet link handler
    // ======================================================
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.copy-meet-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const link = this.getAttribute('data-link');
                if (link) {
                    navigator.clipboard.writeText(link).then(() => {
                        const originalHtml = this.innerHTML;
                        this.innerHTML = '<i class="bi bi-check2 text-success"></i> <span class="text-success fw-bold">Copied!</span>';
                        setTimeout(() => {
                            this.innerHTML = originalHtml;
                        }, 2000);
                    }).catch(() => {
                        prompt('Copy this Google Meet link:', link);
                    });
                }
            });
        });
    });
    // ======================================================
    // IMPORTANT MEETINGS — localStorage-based add/remove
    // ======================================================
    const IMP_KEY = 'auxinzio_imp_meetings';

    function getImpMeetings() {
        try { return JSON.parse(localStorage.getItem(IMP_KEY)) || []; }
        catch { return []; }
    }

    function saveImpMeetings(list) {
        localStorage.setItem(IMP_KEY, JSON.stringify(list));
    }

    function renderImpMeetings() {
        const list = getImpMeetings();
        const container = document.getElementById('impMeetingList');
        if (!container) return;

        if (list.length === 0) {
            container.innerHTML = `
                <div class="imp-empty-state">
                    <i class="bi bi-calendar-x" style="font-size:1.8rem;opacity:0.4;display:block;margin-bottom:0.4rem;"></i>
                    No important meetings yet. Click <strong>Add Meeting</strong> to add one.
                </div>`;
            return;
        }

        container.innerHTML = list.map((m, i) => `
            <div class="imp-meeting-item" id="imp-item-${i}">
                <div class="imp-meeting-icon"><i class="bi bi-camera-video-fill"></i></div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="fw-bold" style="font-size:0.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(m.title)}</div>
                    <div class="text-muted" style="font-size:0.73rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(m.url)}</div>
                </div>
                <div class="d-flex align-items-center gap-1 flex-shrink-0">
                    <a href="${escapeHtml(m.url)}" target="_blank" rel="noopener noreferrer" class="btn-imp-join">
                        <i class="bi bi-box-arrow-up-right"></i> Join
                    </a>
                    <button class="btn btn-sm btn-outline-secondary px-2 py-1" title="Copy link"
                            onclick="copyImpLink(${i})" style="border-radius:7px;font-size:0.75rem;">
                        <i class="bi bi-clipboard" id="imp-copy-icon-${i}"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger px-2 py-1" title="Remove meeting"
                            onclick="removeImpMeeting(${i})" style="border-radius:7px;font-size:0.75rem;">
                        <i class="bi bi-trash3"></i>
                    </button>
                </div>
            </div>`).join('');
    }

    function toggleImpAddForm() {
        const form = document.getElementById('impAddForm');
        const icon = document.getElementById('impAddToggleIcon');
        const text = document.getElementById('impAddToggleText');
        const isOpen = form.style.display !== 'none';
        form.style.display = isOpen ? 'none' : 'block';
        icon.className = isOpen ? 'bi bi-plus-lg' : 'bi bi-x-lg';
        text.textContent = isOpen ? 'Add Meeting' : 'Cancel';
        document.getElementById('impAddError').style.display = 'none';
        if (!isOpen) {
            document.getElementById('impMeetTitle').focus();
        }
    }

    function addImpMeeting() {
        const titleEl = document.getElementById('impMeetTitle');
        const urlEl   = document.getElementById('impMeetUrl');
        const errEl   = document.getElementById('impAddError');
        const title = titleEl.value.trim();
        const url   = urlEl.value.trim();

        errEl.style.display = 'none';
        if (!title) { errEl.textContent = 'Please enter a meeting title.'; errEl.style.display = 'block'; titleEl.focus(); return; }
        if (!url || !/^https?:\/\/.+/.test(url)) { errEl.textContent = 'Please enter a valid meeting URL starting with http(s)://'; errEl.style.display = 'block'; urlEl.focus(); return; }

        const list = getImpMeetings();
        list.push({ title, url, addedAt: new Date().toISOString() });
        saveImpMeetings(list);
        titleEl.value = ''; urlEl.value = '';
        toggleImpAddForm();
        renderImpMeetings();
    }

    function removeImpMeeting(index) {
        const item = document.getElementById(`imp-item-${index}`);
        if (item) {
            item.style.transition = 'opacity 0.25s, transform 0.25s';
            item.style.opacity = '0'; item.style.transform = 'translateX(20px)';
            setTimeout(() => {
                const list = getImpMeetings();
                list.splice(index, 1);
                saveImpMeetings(list);
                renderImpMeetings();
            }, 260);
        }
    }

    function copyImpLink(index) {
        const list = getImpMeetings();
        const url = list[index]?.url;
        if (!url) return;
        navigator.clipboard.writeText(url).then(() => {
            const icon = document.getElementById(`imp-copy-icon-${index}`);
            if (icon) { icon.className = 'bi bi-check2 text-success'; setTimeout(() => { icon.className = 'bi bi-clipboard'; }, 2000); }
        }).catch(() => prompt('Copy this meeting link:', url));
    }

    // ======================================================
    // DAILY MEETING CARDS — Delete & Persist Deletion
    // ======================================================
    function deleteMeetingCard(btn, cardId) {
        if (confirm('Are you sure you want to delete this meeting card?')) {
            const cardCol = document.getElementById(cardId) || btn.closest('.col-12');
            if (cardCol) {
                cardCol.style.transition = 'all 0.3s ease';
                cardCol.style.opacity = '0';
                cardCol.style.transform = 'scale(0.9)';
                setTimeout(() => {
                    cardCol.remove();
                    if (cardId) {
                        const deleted = JSON.parse(localStorage.getItem('auxinzio_deleted_daily_meets') || '[]');
                        if (!deleted.includes(cardId)) {
                            deleted.push(cardId);
                            localStorage.setItem('auxinzio_deleted_daily_meets', JSON.stringify(deleted));
                        }
                    }
                }, 300);
            }
        }
    }

    // Init on load
    document.addEventListener('DOMContentLoaded', () => {
        // Restore deleted daily meeting cards
        const deletedMeets = JSON.parse(localStorage.getItem('auxinzio_deleted_daily_meets') || '[]');
        deletedMeets.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.remove();
        });

        renderImpMeetings();
        // Render custom daily meeting cards
        const customMeets = getCustomDailyMeetings();
        customMeets.forEach(meet => renderCustomMeetingCard(meet));

        // Allow pressing Enter in the title/url inputs to save
        ['impMeetTitle','impMeetUrl'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.addEventListener('keydown', e => { if (e.key === 'Enter') addImpMeeting(); });
        });
    });

    // Custom Daily Meeting Cards
    function getCustomDailyMeetings() {
        return JSON.parse(localStorage.getItem('auxinzio_custom_daily_meets') || '[]');
    }

    function saveCustomDailyMeeting() {
        const title = document.getElementById('customMeetTitle').value.trim();
        const time = document.getElementById('customMeetTime').value.trim() || 'Scheduled Meeting';
        const url = document.getElementById('customMeetUrl').value.trim();
        const desc = document.getElementById('customMeetDesc').value.trim() || 'Team meeting sync and collaborative alignment.';
        const errEl = document.getElementById('customMeetError');

        if (!title || !url) {
            errEl.classList.remove('d-none');
            errEl.textContent = 'Please enter both a Meeting Title and a valid URL.';
            return;
        }
        errEl.classList.add('d-none');

        const newMeeting = {
            id: 'custom-meet-' + Date.now(),
            title: title,
            time: time,
            url: url,
            desc: desc
        };

        const list = getCustomDailyMeetings();
        list.push(newMeeting);
        localStorage.setItem('auxinzio_custom_daily_meets', JSON.stringify(list));

        renderCustomMeetingCard(newMeeting);

        // Reset form & close modal
        document.getElementById('customMeetTitle').value = '';
        document.getElementById('customMeetTime').value = '';
        document.getElementById('customMeetUrl').value = '';
        document.getElementById('customMeetDesc').value = '';

        const modalEl = document.getElementById('addCustomMeetingModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();
    }

    function renderCustomMeetingCard(meet) {
        const container = document.getElementById('dailyMeetingsRow');
        if (!container) return;

        const col = document.createElement('div');
        col.className = 'col-12 col-md-6';
        col.id = meet.id;
        col.innerHTML = `
            <div class="meeting-hub-card p-3 p-xl-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-info bg-opacity-15 text-info border border-info border-opacity-25 px-2.5 py-1 rounded-pill fw-bold" style="font-size: 0.78rem;">
                            <i class="bi bi-camera-video-fill me-1 text-info"></i> Team Sync
                        </span>
                        <span class="meeting-time-pill">
                            <i class="bi bi-clock-fill"></i> ${meet.time}
                        </span>
                    </div>
                    <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <span>${meet.title}</span>
                    </h5>
                    <p class="text-muted small mb-3">
                        ${meet.desc}
                    </p>
                </div>
                <div class="pt-3 border-top border-secondary border-opacity-25 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <a href="${meet.url}" target="_blank" rel="noopener noreferrer" class="btn btn-meet-join d-inline-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-camera-video-fill"></i>
                        <span>Join Meeting</span>
                    </a>
                    <div class="d-flex align-items-center gap-1.5">
                        <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 px-3 py-1.5 copy-meet-btn" data-link="${meet.url}" title="Copy Google Meet Link">
                            <i class="bi bi-clipboard me-1"></i>
                            <span>Copy Link</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1.5 px-2.5 py-1.5" onclick="removeCustomMeetingCard('${meet.id}')" title="Delete Meeting Card">
                            <i class="bi bi-trash3-fill"></i>
                            <span>Delete</span>
                        </button>
                    </div>
                </div>
            </div>
        `;
        container.appendChild(col);
    }

    function removeCustomMeetingCard(id) {
        if (confirm('Are you sure you want to remove this meeting card?')) {
            const el = document.getElementById(id);
            if (el) {
                el.style.transition = 'all 0.3s ease';
                el.style.opacity = '0';
                el.style.transform = 'scale(0.9)';
                setTimeout(() => {
                    el.remove();
                    const list = getCustomDailyMeetings().filter(m => m.id !== id);
                    localStorage.setItem('auxinzio_custom_daily_meets', JSON.stringify(list));
                }, 300);
            }
        }
    }

</script>

<!-- Modal: Add Custom Meeting Link -->
<div class="modal fade" id="addCustomMeetingModal" tabindex="-1" aria-labelledby="addCustomMeetingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 text-white p-4" style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-white bg-opacity-20 d-flex align-items-center justify-content-center text-white" style="width: 42px; height: 42px;">
                        <i class="bi bi-camera-video-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="addCustomMeetingModalLabel">Add Meeting Link</h5>
                        <div class="small opacity-85">Create a new meeting card for your team</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Meeting Title <span class="text-danger">*</span></label>
                    <input type="text" id="customMeetTitle" class="form-control rounded-3" placeholder="e.g., Afternoon Sprint Sync, Design Review..." required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Meeting Time <span class="text-muted">(optional)</span></label>
                    <input type="text" id="customMeetTime" class="form-control rounded-3" placeholder="e.g., 2:30 PM – 3:00 PM" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Google Meet / Video Link <span class="text-danger">*</span></label>
                    <input type="url" id="customMeetUrl" class="form-control rounded-3" placeholder="https://meet.google.com/..." required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Description / Purpose <span class="text-muted">(optional)</span></label>
                    <textarea id="customMeetDesc" class="form-control rounded-3" rows="2" placeholder="Brief description of the meeting alignment..."></textarea>
                </div>
                <div id="customMeetError" class="alert alert-danger small py-2 mb-0 d-none"></div>
            </div>
            <div class="modal-footer border-0 bg-body-tertiary p-3 px-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn text-white rounded-pill px-4 fw-bold shadow-sm" style="background: linear-gradient(135deg, #0ea5e9, #0284c7); border: none;" onclick="saveCustomDailyMeeting()">
                    <i class="bi bi-check-circle-fill me-1"></i> Add Meeting Link
                </button>
            </div>
        </div>
    </div>
</div>
}
