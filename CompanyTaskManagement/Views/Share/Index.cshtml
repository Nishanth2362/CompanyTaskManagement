     MODAL: Share a New Post / Link
============================================================ -->
<div class="modal fade" id="sharePostModal" tabindex="-1" aria-labelledby="sharePostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 18px; overflow: hidden;">

            <!-- Header -->
            <div class="modal-header border-0 py-3 px-4"
                 style="background: linear-gradient(135deg, #0284c7, #0369a1); color: white;">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2 m-0"
                    id="sharePostModalLabel" style="font-family: 'Outfit', sans-serif; font-size: 1rem;">
                    <i class="bi bi-share-fill text-warning"></i>
                    Share with Your Colleagues
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" asp-action="Create" asp-controller="Share" id="sharePostForm">
                @Html.AntiForgeryToken()

                <!-- Scrollable body with fixed max-height -->
                <div class="modal-body px-4 pt-3 pb-0"
                     style="max-height: 65vh; overflow-y: auto; overflow-x: hidden;">
                    <div class="row g-2">

                        <!-- Title -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small mb-1">
                                Post Title <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="Title" class="form-control form-control-sm"
                                   id="postTitleInput"
                                   placeholder="e.g. Auxinzio Task App – Staging link for review"
                                   maxlength="200" required />
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small mb-1">
                                What are you sharing? <span class="text-danger">*</span>
                            </label>
                            <textarea name="Description" class="form-control form-control-sm"
                                      rows="2" id="postDescInput" required
                                      placeholder="Describe it briefly and mention what feedback you need..."></textarea>
                        </div>

                        <!-- Live URL + Repo side by side -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small mb-1">🌐 Live URL / Demo Link</label>
                            <input type="url" name="LiveUrl" class="form-control form-control-sm font-monospace"
                                   placeholder="https://demo.auxinz.io" id="postLiveUrlInput" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small mb-1">🔗 Repository (optional)</label>
                            <input type="url" name="RepositoryUrl" class="form-control form-control-sm font-monospace"
                                   placeholder="https://github.com/org/repo" />
                        </div>

                        <!-- Category + Tags side by side -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small mb-1">Category <span class="text-danger">*</span></label>
                            <select name="Category" class="form-select form-select-sm" required>
                                @foreach (PostCategory cat in Enum.GetValues(typeof(PostCategory)))
                                {
                                    <option value="@((int)cat)">@CategoryLabel(cat)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small mb-1">Tags <span class="text-muted">(comma-separated)</span></label>
                            <input type="text" name="Tags" class="form-control form-control-sm"
                                   placeholder="e.g. ASP.NET, AI, Vue" maxlength="200" />
                        </div>

                        <!-- Divider -->
                        <div class="col-12"><hr class="my-1 opacity-25" /></div>
                        <div class="col-12">
                            <span class="fw-semibold small text-muted">
                                <i class="bi bi-person-fill me-1"></i>Your Information
                            </span>
                        </div>

                        <!-- Name + Email + Role in one row -->
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small mb-1">Your Name <span class="text-danger">*</span></label>
                            <input type="text" name="AuthorName" class="form-control form-control-sm"
                                   placeholder="e.g. Karthikeyan" maxlength="100" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small mb-1">Email (optional)</label>
                            <input type="email" name="AuthorEmail" class="form-control form-control-sm font-monospace"
                                   placeholder="karthikeyan@auxinz.io" maxlength="150" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small mb-1">Your Role <span class="text-danger">*</span></label>
                            <select name="AuthorDepartment" class="form-select form-select-sm" required>
                                <option value="" disabled selected>Select role...</option>
                                <option value="Frontend Developer">🎨 Frontend Developer</option>
                                <option value="Backend Developer">⚙️ Backend Developer</option>
                                <option value="Full Stack Developer">🔗 Full Stack Developer</option>
                                <option value="UI / UX Designer">🖌️ UI / UX Designer</option>
                                <option value="DevOps Engineer">☁️ DevOps Engineer</option>
                                <option value="QA Engineer">🧪 QA / Test Engineer</option>
                                <option value="Mobile Developer">📱 Mobile Developer</option>
                                <option value="Project Manager">📋 Project Manager</option>
                                <option value="HR Manager">👤 HR Manager</option>
                                <option value="Intern">🎓 Intern</option>
                            </select>
                        </div>

                    </div>
                </div>

                <!-- ✅ SUBMIT FOOTER — always pinned at bottom, outside scroll area -->
                <div class="px-4 py-3 d-flex align-items-center justify-content-between gap-3"
                     style="border-top: 1px solid rgba(124,58,237,0.18);
                            background: linear-gradient(135deg,rgba(124,58,237,0.06),rgba(59,130,246,0.04));">
                    <span class="small text-muted d-none d-sm-flex align-items-center gap-1">
                        <i class="bi bi-people-fill text-primary"></i>
                        Visible to <strong class="ms-1">all colleagues</strong>
                    </span>
                    <div class="d-flex gap-2 ms-auto">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit"
                                id="submitShareBtn"
                                class="btn fw-bold rounded-pill px-4 py-2 d-flex align-items-center gap-2"
                                style="background: linear-gradient(135deg,#7c3aed,#3b82f6);
                                       color: white; border: none; font-size: 0.95rem;
                                       box-shadow: 0 4px 18px rgba(124,58,237,0.4);">
                            <i class="bi bi-send-fill"></i>
                            Post to Group
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>


