                            {
                                <button type="button" class="btn p-0 star-btn" data-value="@i"
                                        style="font-size: 1.6rem; color: #d1d5db; background: none; border: none; line-height: 1; cursor: pointer;">★</button>
                            }
                        </div>
                        <input type="hidden" id="fbRating" value="5" />
                    </div>

                    <!-- Comment -->
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Your Feedback Comment <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="fbComment" rows="4"
                                  placeholder="Share your honest thoughts — what works, what could be improved, any bugs, or features you'd love to see..."></textarea>
                    </div>

                    <!-- Screenshot Upload (Optional) -->
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Attach Screenshot <span class="text-muted">(optional)</span></label>
                        <input type="file" class="form-control form-control-sm" id="fbScreenshot" accept="image/*" />
