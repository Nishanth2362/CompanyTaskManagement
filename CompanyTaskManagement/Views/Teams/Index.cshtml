<!-- 8. Grant Extra Time & Leader Suggestion Modal -->
<div class="modal fade" id="grantExtraTimeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header py-3 px-4 text-white" style="background: linear-gradient(135deg, #1e1b4b, #2563eb);">
                <h5 class="modal-header-title fw-bold mb-0 text-white"><i class="bi bi-clock-history me-2"></i> Team Leader: Grant Extra Time &amp; Suggestion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="GrantExtraTime" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskId" id="extraTimeTaskId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Task Title:</label>
                        <div id="extraTimeTaskTitle" class="fw-bold text-primary fs-6 mb-2">-</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">New Extended End Time / Date</label>
                        <input type="datetime-local" name="newEndDate" id="extraTimeEndDateInput" class="form-control border-primary border-opacity-50" />
                        <small class="text-muted d-block mt-1" style="font-size:0.75rem;"><i class="bi bi-info-circle me-1"></i> Setting a future end time will extend task deadline and allow employee to resume work.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-primary">Team Leader Suggestion / Guidance / Feedback</label>
                        <textarea name="leaderSuggestion" id="extraTimeSuggestionInput" class="form-control border-primary border-opacity-50" rows="4" placeholder="Provide helpful suggestion, guidance, technical tips, or resolution steps for the employee..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-body-tertiary px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4"><i class="bi bi-check-circle-fill me-1"></i> Save Extra Time &amp; Suggestion</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const leaderMembersMap = @Html.Raw(leaderMembersJson);
    const allEmployeesList = @Html.Raw(allEmployeesJson);

    function openProvideJustificationModal(taskId, title, reason) {
        document.getElementById('justificationTaskId').value = taskId;
        document.getElementById('justificationTaskTitle').textContent = title;
        document.getElementById('justificationReasonInput').value = reason || '';
        new bootstrap.Modal(document.getElementById('provideJustificationModal')).show();
    }

    function openGrantExtraTimeModal(taskId, title, currentEndDate, suggestion) {
        document.getElementById('extraTimeTaskId').value = taskId;
        document.getElementById('extraTimeTaskTitle').textContent = title;
        document.getElementById('extraTimeEndDateInput').value = currentEndDate || '';
        document.getElementById('extraTimeSuggestionInput').value = suggestion || '';
        new bootstrap.Modal(document.getElementById('grantExtraTimeModal')).show();
    }

    function onReviewLeaderChanged() {
        const leaderSelect = document.getElementById('reviewLeaderSelect');
        const empSelect = document.getElementById('reviewEmployeeSelect');
        const selectedLeaderId = parseInt(leaderSelect.value) || 0;

        empSelect.innerHTML = '';

        if (!selectedLeaderId) {
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = '-- Select Team Leader First --';
            empSelect.appendChild(opt);
            empSelect.disabled = true;
            return;
        }

        const members = leaderMembersMap[selectedLeaderId];

        if (members && members.length > 0) {
            empSelect.disabled = false;
            const defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.textContent = '-- Select Team Member / Employee --';
            empSelect.appendChild(defaultOpt);

            members.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m.id;
                opt.textContent = `${m.name} (${m.designation} - ${m.department})`;
                empSelect.appendChild(opt);
            });
        } else {
            empSelect.disabled = false;
            const defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.textContent = '-- Select Employee --';
            empSelect.appendChild(defaultOpt);

            allEmployeesList.forEach(e => {
                if (e.id !== selectedLeaderId) {
                    const opt = document.createElement('option');
                    opt.value = e.id;
                    opt.textContent = `${e.name} (${e.designation} - ${e.department})`;
                    empSelect.appendChild(opt);
                }
            });
        }
    }

    function openAssignLeaderModal(teamId, teamName, currentLeaderId) {
        document.getElementById('assignLeaderTeamId').value = teamId;
        document.getElementById('assignLeaderTeamName').textContent = teamName;
        if (currentLeaderId > 0) {
            document.getElementById('assignLeaderSelect').value = currentLeaderId;
        }
        new bootstrap.Modal(document.getElementById('assignLeaderModal')).show();
    }

    function openManageMembersModal(teamId, teamName) {
        document.getElementById('manageMembersTeamId').value = teamId;
        document.getElementById('manageMembersTeamName').textContent = teamName;
        new bootstrap.Modal(document.getElementById('manageMembersModal')).show();
    }

    function openAssignTaskModal(teamId, teamName, leaderId, members) {
        document.getElementById('assignTaskTeamId').value = teamId;
        document.getElementById('assignTaskLeaderId').value = leaderId;

        const select = document.getElementById('assignTaskEmployeeSelect');
        select.innerHTML = '';

        if (!members || members.length === 0) {
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = '-- No members allocated to this team yet (Allocate employees first) --';
            select.appendChild(opt);
            select.disabled = true;
        } else {
            select.disabled = false;
            const defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.textContent = '-- Select Team Member --';
            select.appendChild(defaultOpt);

            members.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m.id;
                opt.textContent = `${m.name} (${m.designation})`;
                select.appendChild(opt);
            });
        }

        const durationSelect = document.getElementById('assignTaskDurationSelect');
        if (durationSelect) {
            durationSelect.value = 'Full Day';
            autoFillShiftTimes('Full Day');
        }

        new bootstrap.Modal(document.getElementById('assignTaskModal')).show();
    }

    function autoFillShiftTimes(duration) {
        const startDateInput = document.querySelector('#assignTaskModal input[name="startDate"]');
        const endDateInput = document.querySelector('#assignTaskModal input[name="endDate"]');
        if (!startDateInput || !endDateInput) return;

        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const datePrefix = `${year}-${month}-${day}`;

        if (duration === 'First Half') {
            startDateInput.value = `${datePrefix}T09:00`;
            endDateInput.value = `${datePrefix}T13:30`;
        } else if (duration === 'Second Half') {
            startDateInput.value = `${datePrefix}T13:30`;
            endDateInput.value = `${datePrefix}T18:00`;
        } else {
            startDateInput.value = `${datePrefix}T09:00`;
            endDateInput.value = `${datePrefix}T18:00`;
        }
    }

    function openUpdateStatusModal(taskId, title, status, reason) {
        document.getElementById('updateStatusTaskId').value = taskId;
        document.getElementById('updateStatusTaskTitle').textContent = title;
        document.getElementById('statusSelect').value = status;
        document.getElementById('incompleteReasonInput').value = reason || '';
        toggleIncompleteReasonBox();
        new bootstrap.Modal(document.getElementById('updateStatusModal')).show();
    }

    function toggleIncompleteReasonBox() {
        const statusVal = document.getElementById('statusSelect').value;
        const container = document.getElementById('incompleteReasonContainer');
        const input = document.getElementById('incompleteReasonInput');
        // 3 is NotCompleted
        if (statusVal === '3') {
            container.style.display = 'block';
            input.setAttribute('required', 'required');
        } else {
            container.style.display = 'none';
            input.removeAttribute('required');
        }
    }

    function openReviewLeaderModal(leaderId, leaderName) {
        document.getElementById('reviewTaskId').value = '';
        if (leaderId > 0) {
            const leaderSelect = document.getElementById('reviewLeaderSelect');
            leaderSelect.value = leaderId;
            onReviewLeaderChanged();
        }
        new bootstrap.Modal(document.getElementById('addLeaderReviewModal')).show();
    }

    function openReviewTaskModal(leaderId, employeeId, taskId, taskTitle) {
        document.getElementById('reviewTaskId').value = taskId;
        const leaderSelect = document.getElementById('reviewLeaderSelect');
        if (leaderId > 0) {
            leaderSelect.value = leaderId;
            onReviewLeaderChanged();
        }
        const empSelect = document.getElementById('reviewEmployeeSelect');
        if (employeeId > 0) {
            empSelect.value = employeeId;
        }
        const commentsBox = document.querySelector('#addLeaderReviewModal textarea[name="comments"]');
        if (commentsBox) {
            commentsBox.value = `Great performance on completing task: "${taskTitle}". Outstanding craftsmanship and timely delivery!`;
        }
        new bootstrap.Modal(document.getElementById('addLeaderReviewModal')).show();
    }
</script>
}
