                <h5 class="modal-header-title fw-bold mb-0 text-white"><i class="bi bi-award-fill text-warning me-2"></i> Review Employee & Give Appreciation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddLeaderReview" method="post">
