@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <div class="mb-3 text-danger fs-1">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h3 class="fw-bold text-dark">Access Denied</h3>
                <p class="text-muted">You do not have the required permissions or administrative privileges to access this resource.</p>
                <div class="mt-3">
                    <a href="/Task" class="btn btn-primary px-4 me-2">Back to Tasks</a>
                    <a href="/Account/Login" class="btn btn-outline-secondary px-4">Switch User</a>
                </div>
            </div>
        </div>
    </div>
</div>
