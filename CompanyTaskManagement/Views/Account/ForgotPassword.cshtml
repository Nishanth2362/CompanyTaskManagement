@model CompanyTaskManagement.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password — Auxinz.io Tasks";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Icons -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* ---------- High-End Sky Blue Design System Tokens ---------- */
        :root {
            --bg-body: #0284C7;
            --bg-surface: #0369A1;
            --bg-card: rgba(10, 25, 47, 0.85);
            --border-glass: rgba(255, 255, 255, 0.22);
            --border-hover: rgba(255, 255, 255, 0.6);
            --brand-primary: #0284C7;
            --brand-indigo: #0369A1;
            --brand-cyan: #38BDF8;
            --brand-violet: #6366F1;
            --text-title: #FFFFFF;
            --text-body: #E0F2FE;
            --text-muted: #BAE6FD;
            --gradient-brand: linear-gradient(135deg, #FFFFFF 0%, #BAE6FD 60%, #E0F2FE 100%);
            --gradient-button: linear-gradient(135deg, #0284C7 0%, #0369A1 50%, #1D4ED8 100%);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            min-height: 100%;
            height: 100%;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, #0369A1 0%, #0284C7 35%, #0EA5E9 70%, #38BDF8 100%);
            background-attachment: fixed;
            color: #F8FAFC;
            overflow-x: hidden;
        }

        /* ====== SPLIT SCREEN CONTAINER ====== */
        .layout {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            min-height: 100vh;
            width: 100vw;
            position: relative;
        }

        .ambient-glow-1 {
            position: absolute;
            top: -120px;
            left: -100px;
            width: 650px;
            height: 650px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.22) 0%, transparent 70%);
            pointer-events: none;
            filter: blur(40px);
            z-index: 0;
        }

        .ambient-glow-2 {
            position: absolute;
            bottom: -150px;
            right: 10%;
            width: 700px;
            height: 700px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(186, 230, 253, 0.28) 0%, transparent 70%);
            pointer-events: none;
            filter: blur(50px);
            z-index: 0;
        }

        /* ====== LEFT PANEL ====== */
        .left {
            position: relative;
            background: linear-gradient(160deg, rgba(3, 105, 161, 0.35) 0%, rgba(2, 132, 199, 0.08) 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            padding: 64px 80px;
            overflow: hidden;
            border-right: 1px solid rgba(255, 255, 255, 0.15);
            z-index: 1;
        }

        .left::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255, 255, 255, 0.22) 1.2px, transparent 1.2px);
            background-size: 32px 32px;
            mask-image: radial-gradient(ellipse 90% 90% at 30% 50%, black 0%, transparent 85%);
            pointer-events: none;
        }

        .left-content {
            position: relative;
            z-index: 2;
            max-width: 540px;
        }

        .badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 7px 18px 7px 12px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.35);
            border-radius: 100px;
            font-size: 12.5px;
            font-weight: 700;
            color: #FFFFFF;
            letter-spacing: 0.03em;
            margin-bottom: 28px;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .badge-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #FFFFFF;
            box-shadow: 0 0 10px #FFFFFF;
            animation: pulse-ring 2s ease infinite;
        }

        .headline {
            font-size: clamp(38px, 3.8vw, 54px);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.03em;
            color: #FFFFFF;
            text-shadow: 0 2px 14px rgba(3, 105, 161, 0.35);
            margin-bottom: 18px;
        }

        .headline span {
            background: linear-gradient(135deg, #FFFFFF 0%, #BAE6FD 60%, #E0F2FE 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .subtext {
            font-size: 16px;
            font-weight: 450;
            color: rgba(255, 255, 255, 0.92);
            line-height: 1.65;
            margin-bottom: 36px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 13.5px;
            font-weight: 600;
            color: #FFFFFF;
        }

        .feature-icon-box {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.20);
            border: 1px solid rgba(255, 255, 255, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 15px;
            flex-shrink: 0;
            backdrop-filter: blur(8px);
        }

        /* ====== RIGHT PANEL ====== */
        .right {
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-y: auto;
            padding: 48px 32px;
            z-index: 1;
        }

        /* Premium Porcelain Glass Card */
        .reset-card {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 450px;
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.85);
            border-radius: 24px;
            padding: 44px 40px;
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            box-shadow: 0 25px 60px -15px rgba(2, 60, 115, 0.35),
                        0 10px 25px -5px rgba(0, 0, 0, 0.06),
                        0 0 0 1px rgba(255, 255, 255, 0.9);
            animation: floatUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
            margin: auto;
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 24px;
        }

        .brand-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 800;
            color: #FFFFFF !important;
            box-shadow: 0 8px 20px -4px rgba(2, 132, 199, 0.45);
            flex-shrink: 0;
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

        .brand-text {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #0F172A;
            display: flex;
            align-items: center;
        }

        .brand-text span.brand-dot-io {
            color: #0284C7;
        }

        .brand-tag {
            font-size: 12.5px;
            font-weight: 600;
            color: #0284C7;
            background: #E0F2FE;
            padding: 2px 9px;
            border-radius: 6px;
            margin-left: 8px;
            letter-spacing: 0.02em;
        }

        .card-title {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.025em;
            color: #0F172A;
            margin-bottom: 6px;
        }

        .card-subtitle {
            font-size: 14.5px;
            color: #64748B;
            margin-bottom: 26px;
            font-weight: 450;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label-custom {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            color: #334155;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin-bottom: 7px;
        }

        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            display: flex;
            align-items: center;
            pointer-events: none;
            transition: color 0.2s ease;
            z-index: 3;
            font-size: 16px;
        }

        .form-control-custom {
            width: 100%;
            background: #F8FAFC !important;
            border: 1.5px solid #E2E8F0 !important;
            border-radius: 12px !important;
            padding: 13px 14px 13px 44px !important;
            font-family: inherit !important;
            font-size: 14.5px !important;
            color: #0F172A !important;
            font-weight: 500 !important;
            outline: none !important;
            transition: all 0.2s ease !important;
        }

        .form-control-custom::placeholder {
            color: #94A3B8 !important;
            font-weight: 400;
        }

        .form-control-custom:focus {
            border-color: #0284C7 !important;
            background: #FFFFFF !important;
            box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.14) !important;
        }

        .input-wrap:focus-within .input-icon {
            color: #0284C7;
        }

        .toggle-pw {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #94A3B8;
            display: flex;
            align-items: center;
            padding: 4px;
            border-radius: 6px;
            transition: color 0.2s;
            z-index: 3;
        }

        .toggle-pw:hover {
            color: #0F172A;
        }

        .btn-submit {
            width: 100%;
            padding: 13.5px 24px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%);
            color: #FFFFFF;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.01em;
            cursor: pointer;
            box-shadow: 0 10px 25px -4px rgba(2, 132, 199, 0.45);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 10px;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px -4px rgba(2, 132, 199, 0.58);
            color: #FFFFFF;
        }

        .card-footer-box {
            text-align: center;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #F1F5F9;
            font-size: 13.5px;
            color: #64748B;
        }

        .card-footer-box a {
            color: #0284C7;
            text-decoration: none;
            font-weight: 700;
            transition: color 0.2s;
        }

        .card-footer-box a:hover {
            color: #0369A1;
            text-decoration: underline;
        }

        .copyright-text {
            margin-top: 18px;
            text-align: center;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.85);
        }

        .copyright-text a {
            color: #FFFFFF;
            text-decoration: none;
        }

        .copyright-text a:hover {
            color: #E0F2FE;
        }

        @@keyframes pulse-ring {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 0 8px #38BDF8;
            }
            50% {
                transform: scale(1.15);
                box-shadow: 0 0 16px #38BDF8;
            }
        }

        @@keyframes floatUp {
            from {
                opacity: 0;
                transform: translateY(24px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@media (max-width: 1024px) {
            .layout {
                grid-template-columns: 1fr;
            }
            .left {
                display: none;
            }
            .right {
                min-height: 100vh;
                padding: 40px 20px;
            }
            .reset-card {
                padding: 36px 28px;
            }
        }
    </style>
</head>
<body>

    <div class="layout">
        <div class="ambient-glow-1"></div>
        <div class="ambient-glow-2"></div>

        <!-- ====== LEFT PANEL ====== -->
        <div class="left">
            <div class="left-content">

                <div class="badge-pill">
                    <span class="badge-dot"></span>
                    Auxinz.io Security Guard
                </div>

                <h1 class="headline">
                    Recover Your<br>
                    <span>Corporate Access.</span>
                </h1>

                <p class="subtext">
                    Reset your password securely using PBKDF2 encryption and regain instant access to your tasks and team assignments on Auxinz.io.
                </p>

                <!-- Features Grid -->
                <div class="features-grid">
                    <div class="feature-item">
                        <div class="feature-icon-box">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        Salted Hash Security
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon-box">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        Instant Update
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon-box">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        Zero Admin Intervention
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon-box">
                            <i class="bi bi-cpu-fill"></i>
                        </div>
                        Session Guarded
                    </div>
                </div>

            </div>
        </div>

        <!-- ====== RIGHT PANEL (RESET CARD) ====== -->
        <div class="right">
            <div class="reset-card">

                <!-- Brand Header -->
                <div class="brand-header">
                    <div class="brand-icon">A</div>
                    <div>
                        <div class="brand-text">Auxinz<span class="brand-dot-io">.io</span> <span class="brand-tag">Tasks</span></div>
                    </div>
                </div>

                <h2 class="card-title">Forgot Password?</h2>
                <p class="card-subtitle">Enter your corporate email and choose your new password</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 mb-3 small d-flex align-items-center" style="background: #FEF2F2; border: 1px solid #FCA5A5; color: #991B1B; border-radius: 12px;">
                        <div>
                            <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Reset Failed</div>
                            @Html.ValidationSummary(false, "", new { @class = "mb-0 ps-3" })
                        </div>
                    </div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="forgotForm">

                    <!-- Corporate Email -->
                    <div class="form-group">
                        <label class="form-label-custom">Corporate Email *</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <i class="bi bi-envelope-at"></i>
                            </span>
                            <input asp-for="Email" class="form-control-custom" placeholder="name@auxinz.io" autocomplete="email" autofocus required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- New Password -->
                    <div class="form-group">
                        <label class="form-label-custom">New Password * (Min 6 chars)</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="NewPassword" type="password" class="form-control-custom" placeholder="••••••••" autocomplete="new-password" id="newPasswordInput" required />
                            <button class="toggle-pw" id="toggleNewPwBtn" type="button" title="Toggle password visibility">
                                <i class="bi bi-eye" id="eyeIconNew"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <!-- Confirm New Password -->
                    <div class="form-group">
                        <label class="form-label-custom">Confirm New Password *</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control-custom" placeholder="••••••••" autocomplete="new-password" id="confirmNewPasswordInput" required />
                            <button class="toggle-pw" id="toggleConfirmPwBtn" type="button" title="Toggle password visibility">
                                <i class="bi bi-eye" id="eyeIconConfirm"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-submit" id="btnResetPassword">
                        <i class="bi bi-arrow-repeat fs-5"></i>
                        Update Password &amp; Proceed to Login
                    </button>

                </form>

                <div class="card-footer-box">
                    Remember your password? <a href="/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i>Back to Sign In</a>
                </div>

                <div class="copyright-text">
                    &copy; 2026 - <a href="https://amoebatronix.com/" target="_blank">Amoebatronix Private Limited.</a> All rights reserved
                </div>

            </div>
        </div>

    </div>

    <script>
        function attachToggle(btnId, inputId, iconId) {
            const btn = document.getElementById(btnId);
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (btn && input && icon) {
                btn.addEventListener('click', function () {
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
                });
            }
        }

        attachToggle('toggleNewPwBtn', 'newPasswordInput', 'eyeIconNew');
        attachToggle('toggleConfirmPwBtn', 'confirmNewPasswordInput', 'eyeIconConfirm');
    </script>
</body>
</html>
