@model IEnumerable<CompanyTaskManagement.Models.Project>
@inject CompanyTaskManagement.Services.IUserSessionService UserSession

@{
    ViewData["Title"] = "Projects Portfolio";
    var projectList = Model?.ToList() ?? new List<CompanyTaskManagement.Models.Project>();
    var isAdmin = UserSession.IsAdmin();
    var isHr = UserSession.IsHr();
    var isEmployee = UserSession.IsEmployee();
    var selectedStatus = ViewBag.SelectedStatus as string ?? "all";
    var search = ViewBag.Search as string ?? "";
}

<!-- Notification Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div class="fw-semibold">@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
        <div class="fw-semibold">@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header & Actions -->
<!-- Page Header & Actions -->
<!-- Page Hero Banner Header -->
<div class="card border-0 shadow-lg rounded-4 overflow-hidden position-relative mb-4" 
     style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 45%, #0284c7 100%); color: white; border: 1px solid rgba(56, 189, 248, 0.25) !important; box-shadow: 0 20px 40px -12px rgba(2, 132, 199, 0.3) !important;">
    
    <!-- Top Glowing Accent Bar -->
    <div style="height: 3.5px; background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 50%, #38bdf8 100%); width: 100%;"></div>

    <!-- Glowing Ambient Light Overlays -->
    <div style="position: absolute; right: -40px; top: -40px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(56, 189, 248, 0.22) 0%, transparent 70%); border-radius: 50%; pointer-events: none; z-index: 1;"></div>
    <div style="position: absolute; left: -60px; bottom: -60px; width: 280px; height: 280px; background: radial-gradient(circle, rgba(245, 158, 11, 0.18) 0%, transparent 70%); border-radius: 50%; pointer-events: none; z-index: 1;"></div>
    <i class="bi bi-kanban position-absolute text-white" style="font-size: 13rem; right: 2rem; bottom: -3rem; opacity: 0.05; pointer-events: none; z-index: 1;"></i>

    <div class="card-body p-4 p-lg-4.5 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge rounded-pill fw-bold px-3 py-1.5 shadow-sm" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #0f172a; font-size: 0.76rem; letter-spacing: 0.03em;">
                        <i class="bi bi-shield-check-fill me-1"></i>Auxinzio Portfolio Hub
                    </span>
                    <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.22); color: #e0f2fe; font-size: 0.76rem; backdrop-filter: blur(8px);">
                        <i class="bi bi-diagram-3-fill me-1 text-sky-light"></i> Enterprise Deliverables &amp; Milestones
                    </span>
                </div>
                <h2 class="fw-extrabold text-white mb-2" style="font-family: 'Outfit', sans-serif; font-size: 2.1rem; letter-spacing: -0.02em; line-height: 1.2;">
                    Projects Portfolio
                </h2>
                <p class="text-white opacity-85 mb-0" style="font-size: 0.94rem; line-height: 1.55; max-width: 680px;">
                    High-level management of enterprise deliverables, milestones, client accounts, budget allocations, and lead assignments.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end d-flex flex-wrap gap-2 justify-content-lg-end">
                @if (isAdmin)
                {
                    <a asp-action="Create" class="btn rounded-pill fw-bold px-4 py-2.5 shadow-lg border-0 d-inline-flex align-items-center gap-2 transition-all" style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); color: #0f172a; font-size: 0.9rem; box-shadow: 0 8px 20px rgba(245, 158, 11, 0.35) !important;" onmouseenter="this.style.transform='translateY(-2px)'" onmouseleave="this.style.transform=''">
                        <i class="bi bi-plus-circle-fill fs-5"></i>
                        <span>Add Project (Admin)</span>
                    </a>
                }
                else
                {
                    <div class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-25 px-3.5 py-2.5 rounded-pill d-inline-flex align-items-center gap-2" style="backdrop-filter: blur(8px); font-size: 0.85rem;">
                        <i class="bi bi-lock-fill text-warning fs-6"></i>
                        <span>Creation Restricted to Admin</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Executive Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 position-relative overflow-hidden h-100" 
             style="background: linear-gradient(135deg, rgba(2, 132, 199, 0.08) 0%, rgba(224, 242, 254, 0.45) 100%); border: 1px solid rgba(2, 132, 199, 0.25) !important; padding: 0.95rem 1.15rem;">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-white flex-shrink-0" 
                         style="width: 38px; height: 38px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); font-size: 1.05rem;">
                        <i class="bi bi-kanban-fill"></i>
                    </div>
                    <div>
                        <div class="fw-extrabold font-monospace text-dark" style="font-size: 1.5rem; line-height: 1;">@ViewBag.TotalProjects</div>
                        <div class="fw-bold text-uppercase text-secondary" style="font-size: 0.65rem; letter-spacing: 0.03em; margin-top: 3px;">TOTAL PROJECTS</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 position-relative overflow-hidden h-100" 
             style="background: linear-gradient(135deg, rgba(147, 51, 234, 0.08) 0%, rgba(243, 232, 255, 0.45) 100%); border: 1px solid rgba(147, 51, 234, 0.25) !important; padding: 0.95rem 1.15rem;">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-white flex-shrink-0" 
                         style="width: 38px; height: 38px; background: linear-gradient(135deg, #9333ea 0%, #6b21a8 100%); font-size: 1.05rem;">
                        <i class="bi bi-gear-wide-connected"></i>
                    </div>
                    <div>
                        <div class="fw-extrabold font-monospace text-dark" style="font-size: 1.5rem; line-height: 1;">@ViewBag.InProgressCount</div>
                        <div class="fw-bold text-uppercase text-secondary" style="font-size: 0.65rem; letter-spacing: 0.03em; margin-top: 3px;">IN ACTIVE EXECUTION</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 position-relative overflow-hidden h-100" 
             style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.08) 0%, rgba(220, 252, 231, 0.45) 100%); border: 1px solid rgba(34, 197, 94, 0.25) !important; padding: 0.95rem 1.15rem;">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-white flex-shrink-0" 
                         style="width: 38px; height: 38px; background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); font-size: 1.05rem;">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div>
                        <div class="fw-extrabold font-monospace text-dark" style="font-size: 1.5rem; line-height: 1;">@ViewBag.CompletedCount</div>
                        <div class="fw-bold text-uppercase text-secondary" style="font-size: 0.65rem; letter-spacing: 0.03em; margin-top: 3px;">DELIVERED &amp; COMPLETE</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 position-relative overflow-hidden h-100" 
             style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(254, 243, 199, 0.45) 100%); border: 1px solid rgba(245, 158, 11, 0.25) !important; padding: 0.95rem 1.15rem;">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-white flex-shrink-0" 
                         style="width: 38px; height: 38px; background: linear-gradient(135deg, #d97706 0%, #b45309 100%); font-size: 1.05rem;">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="fw-extrabold font-monospace text-dark text-truncate" style="font-size: 1.35rem; line-height: 1;" title="₹@(((decimal)ViewBag.TotalBudget).ToString("N0"))">₹@(((decimal)ViewBag.TotalBudget).ToString("N0"))</div>
                        <div class="fw-bold text-uppercase text-secondary" style="font-size: 0.65rem; letter-spacing: 0.03em; margin-top: 3px;">PORTFOLIO BUDGET</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Interactive Filter & Search Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4 p-3 glass-card" style="border: 1px solid rgba(2, 132, 199, 0.18) !important;">
    <form method="get" asp-action="Index" class="row g-2.5 align-items-center">
        <div class="col-12 col-lg-8">
            <div class="d-flex flex-wrap gap-1.5 align-items-center">
                <a asp-action="Index" asp-route-status="all" asp-route-search="@search" class="btn btn-sm @(selectedStatus == "all" ? "btn-primary shadow-sm fw-bold" : "btn-light border text-secondary") rounded-pill px-3 py-1.5" style="font-size: 0.82rem;">
                    All (@ViewBag.TotalProjects)
                </a>
                <a asp-action="Index" asp-route-status="In Progress" asp-route-search="@search" class="btn btn-sm @(selectedStatus == "in progress" ? "btn-info text-white shadow-sm fw-bold" : "btn-light border text-secondary") rounded-pill px-3 py-1.5" style="font-size: 0.82rem;">
                    <i class="bi bi-play-circle me-1"></i> In Progress (@ViewBag.InProgressCount)
                </a>
                <a asp-action="Index" asp-route-status="Planning" asp-route-search="@search" class="btn btn-sm @(selectedStatus == "planning" ? "btn-primary text-white shadow-sm fw-bold" : "btn-light border text-secondary") rounded-pill px-3 py-1.5" style="font-size: 0.82rem;">
                    <i class="bi bi-compass me-1"></i> Planning (@ViewBag.PlanningCount)
                </a>
                <a asp-action="Index" asp-route-status="Completed" asp-route-search="@search" class="btn btn-sm @(selectedStatus == "completed" ? "btn-success shadow-sm fw-bold" : "btn-light border text-secondary") rounded-pill px-3 py-1.5" style="font-size: 0.82rem;">
                    <i class="bi bi-check-circle-fill me-1"></i> Completed (@ViewBag.CompletedCount)
                </a>
                <a asp-action="Index" asp-route-status="On Hold" asp-route-search="@search" class="btn btn-sm @(selectedStatus == "on hold" ? "btn-warning text-dark shadow-sm fw-bold" : "btn-light border text-secondary") rounded-pill px-3 py-1.5" style="font-size: 0.82rem;">
                    <i class="bi bi-pause-circle me-1"></i> On Hold (@ViewBag.OnHoldCount)
                </a>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="input-group input-group-sm rounded-pill overflow-hidden border shadow-sm bg-body p-0.5">
                <input type="hidden" name="status" value="@selectedStatus" />
                <span class="input-group-text bg-transparent border-0 ps-3 pe-2"><i class="bi bi-search text-primary"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-0 shadow-none ps-0" placeholder="Search project, client..." />
                <button class="btn btn-primary rounded-pill px-3.5 fw-bold" type="submit">Search</button>
            </div>
        </div>
    </form>
</div>

<!-- Projects Grid -->
@if (!projectList.Any())
{
    <div class="glass-card p-5 text-center rounded-4 shadow-sm border">
        <i class="bi bi-kanban text-muted display-4 mb-3"></i>
        <h5 class="fw-bold">No Projects Found</h5>
        <p class="text-muted mb-3">No project matching the selected filters was found in the portfolio.</p>
        @if (isAdmin)
        {
            <div>
                <a asp-action="Create" class="btn btn-royal-gold px-4 py-2">
                    <i class="bi bi-plus-circle me-1"></i> Create First Project
                </a>
            </div>
        }
    </div>
}
else
{
    var taskStats = ViewBag.ProjectTaskStats as Dictionary<int, (int Total, int Completed)>;

    <div class="row g-4">
        @foreach (var p in projectList)
        {
            var statusSlug = (p.Status ?? "In Progress").ToLower().Replace(" ", "-");
            var accentClass = statusSlug switch {
                "in-progress" => "accent-in-progress",
                "planning" => "accent-planning",
                "completed" => "accent-completed",
                _ => "accent-on-hold"
            };

            var statusBadgeClass = statusSlug switch {
                "completed" => "status-completed",
                "in-progress" => "status-inprogress",
                "planning" => "status-inreview",
                _ => "status-todo"
            };

            var priorityClass = p.Priority == "Critical" ? "priority-urgent" :
                                p.Priority == "High" ? "priority-high" :
                                p.Priority == "Medium" ? "priority-medium" : "priority-low";

            var totalTasks = 0;
            var completedTasks = 0;
            if (taskStats != null && taskStats.ContainsKey(p.Id))
            {
                totalTasks = taskStats[p.Id].Total;
                completedTasks = taskStats[p.Id].Completed;
            }

            <div class="col-12 col-md-6 col-lg-4">
                <div class="project-card-premium h-100">
                    <!-- Status Top Accent Stripe -->
                    <div class="project-card-top-accent @accentClass"></div>

                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <!-- Top Header: Company Pill, Priority & Status Badges -->
                        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                            <span class="company-badge-chip shadow-2xs">
                                <i class="bi bi-buildings text-sky"></i>
                                <span>@(string.IsNullOrWhiteSpace(p.ClientCompany) ? "Internal / Global" : p.ClientCompany)</span>
                            </span>
                            <div class="d-flex align-items-center gap-1.5">
                                <span class="priority-badge @priorityClass">@p.Priority</span>
                                <span class="status-pill @statusBadgeClass">@p.Status</span>
                            </div>
                        </div>

                        <!-- Project Title & Description -->
                        <h4 class="fw-bold mb-2">
                            <a asp-action="Details" asp-route-id="@p.Id" class="task-title-link fs-5 text-decoration-none">
                                <i class="bi bi-folder2-open text-sky me-2 opacity-90"></i>@p.ProjectName
                            </a>
                        </h4>

                        <p class="text-secondary small mb-3 flex-grow-1" style="line-height: 1.6; font-size: 0.88rem;">
                            @(string.IsNullOrWhiteSpace(p.Description) ? "No detailed project brief provided." : p.Description)
                        </p>

                        @if (totalTasks > 0)
                        {
                            var pct = (int)Math.Round((double)completedTasks * 100 / totalTasks);
                            <div class="mb-3.5">
                                <div class="d-flex justify-content-between align-items-center mb-1.5" style="font-size: 0.8rem;">
                                    <span class="text-muted fw-bold d-inline-flex align-items-center gap-1.5">
                                        <i class="bi bi-check2-all text-sky fs-6"></i> Task Progress
                                    </span>
                                    <span class="fw-bold text-sky font-monospace">@completedTasks/@totalTasks (@pct%)</span>
                                </div>
                                <div class="progress" style="height: 7px; background-color: var(--bg-surface-secondary); border-radius: 10px;">
                                    <div class="progress-bar bg-sky rounded-pill" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }

                        <!-- Project Metadata Grid (Spacious, High-Contrast & Beautiful Fonts) -->
                        <div class="project-meta-grid mb-4">
                            <div class="row g-3">
                                <!-- Lead Manager -->
                                <div class="col-6">
                                    <span class="project-meta-label">Lead Manager</span>
                                    <div class="project-meta-value text-truncate d-flex align-items-center">
                                        <i class="bi bi-person-circle text-sky fs-6 me-2 flex-shrink-0"></i>
                                        <span class="text-truncate">@(string.IsNullOrWhiteSpace(p.LeadManagerName) ? "Unassigned" : p.LeadManagerName)</span>
                                    </div>
                                </div>

                                <!-- Budget Allocation -->
                                <div class="col-6">
                                    <span class="project-meta-label">Budget Allocation</span>
                                    <div class="project-meta-value text-gold d-flex align-items-center">
                                        @if (p.Budget.HasValue)
                                        {
                                            <i class="bi bi-currency-rupee text-gold fs-6 me-1 flex-shrink-0"></i>
                                            <span class="fw-extrabold">@p.Budget.Value.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fw-semibold" style="font-size: 0.82rem;">Flexible / TBD</span>
                                        }
                                    </div>
                                </div>

                                <!-- Target Deadline -->
                                <div class="col-6">
                                    <span class="project-meta-label">Target Deadline</span>
                                    <div class="project-meta-value text-truncate d-flex align-items-center">
                                        <i class="bi bi-calendar-event text-amber me-2 flex-shrink-0"></i>
                                        <span class="text-truncate">@(p.TargetEndDate.HasValue ? p.TargetEndDate.Value.ToString("MMM dd, yyyy") : "Open Ended")</span>
                                    </div>
                                </div>

                                <!-- Created Date -->
                                <div class="col-6">
                                    <span class="project-meta-label">Created Date</span>
                                    <div class="project-meta-value text-secondary text-truncate d-flex align-items-center">
                                        <i class="bi bi-clock-history text-muted me-2 flex-shrink-0"></i>
                                        <span class="text-truncate">@p.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer Controls -->
                        <div class="d-flex align-items-center justify-content-between pt-3 mt-3 border-top border-secondary border-opacity-15 mt-auto">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn-project-overview text-decoration-none">
                                <span>View Project Hub</span>
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                            @if (isAdmin)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-action-custom rounded-circle" title="Edit Project">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete project \'@p.ProjectName\'?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-action-custom text-danger rounded-circle" title="Delete Project">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
