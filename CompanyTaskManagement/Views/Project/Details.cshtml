@model CompanyTaskManagement.Models.Project
@inject CompanyTaskManagement.Services.IUserSessionService UserSession

@{
    ViewData["Title"] = Model.ProjectName + " - Overview";
    var isAdmin = UserSession.IsAdmin();

    var statusBadge = Model.Status == "Completed" ? "badge-emerald" :
                      Model.Status == "In Progress" ? "bg-info text-white" :
                      Model.Status == "Planning" ? "bg-primary text-white" : "bg-warning text-dark";

    var priorityClass = Model.Priority == "Critical" ? "priority-urgent" :
                        Model.Priority == "High" ? "priority-high" :
                        Model.Priority == "Medium" ? "priority-medium" : "priority-low";
}

<!-- Page Header Navigation -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="h3 fw-bold mb-0">@Model.ProjectName</h1>
            <span class="badge @statusBadge rounded-pill px-3 py-1">@Model.Status</span>
        </div>
        <p class="text-muted mb-0">Client Portfolio: <strong>@(string.IsNullOrWhiteSpace(Model.ClientCompany) ? "Internal Initiative" : Model.ClientCompany)</strong></p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 px-3">
            <i class="bi bi-arrow-left"></i>
            <span>All Projects</span>
        </a>

        @if (isAdmin)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-1 px-3">
                <i class="bi bi-pencil-square"></i>
                <span>Edit Project</span>
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Scope & Overview -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm glass-card p-4 mb-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-file-text-fill text-gold"></i>
                <span>Project Scope &amp; Objectives</span>
            </h5>
            <div class="p-3 rounded-3 bg-secondary-subtle bg-opacity-25" style="white-space: pre-line; line-height: 1.65;">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed scope description entered yet." : Model.Description)
            </div>
        </div>

        <!-- Quick Links to Tasks -->
        <div class="card border-0 shadow-sm glass-card p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-list-task text-primary"></i>
                    <span>Cross-Company Tasks</span>
                </h5>
                <a asp-controller="Task" asp-action="Index" class="btn btn-sm btn-outline-primary">
                    <span>Explore Task Dashboard</span>
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <p class="text-muted small mb-0">
                To create and assign individual sprint deliverables, work tickets, or employee logs under this initiative, use the <strong>Tasks Dashboard</strong>.
            </p>
        </div>
    </div>

    <!-- Right Column: Metadata & Details -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm glass-card p-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill text-info"></i>
                <span>Project Specification</span>
            </h5>

            <ul class="list-group list-group-flush bg-transparent">
                <li class="list-group-item bg-transparent px-0 py-2.5 d-flex justify-content-between align-items-center border-secondary border-opacity-10">
                    <span class="text-muted small">Priority:</span>
                    <span class="priority-badge @priorityClass">@Model.Priority</span>
                </li>
                <li class="list-group-item bg-transparent px-0 py-2.5 d-flex justify-content-between align-items-center border-secondary border-opacity-10">
                    <span class="text-muted small">Client / Account:</span>
                    <span class="fw-bold text-main">@(string.IsNullOrWhiteSpace(Model.ClientCompany) ? "Global" : Model.ClientCompany)</span>
                </li>
                <li class="list-group-item bg-transparent px-0 py-2.5 d-flex justify-content-between align-items-center border-secondary border-opacity-10">
                    <span class="text-muted small">Lead Project Manager:</span>
                    <span class="fw-bold text-primary">
                        <i class="bi bi-person-badge-fill me-1"></i>@(string.IsNullOrWhiteSpace(Model.LeadManagerName) ? "Unassigned" : Model.LeadManagerName)
                    </span>
                </li>
                <li class="list-group-item bg-transparent px-0 py-2.5 d-flex justify-content-between align-items-center border-secondary border-opacity-10">
                    <span class="text-muted small">Start Date:</span>
                    <span class="fw-semibold text-main">@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("MMM dd, yyyy") : "TBD")</span>
                </li>
                <li class="list-group-item bg-transparent px-0 py-2.5 d-flex justify-content-between align-items-center border-secondary border-opacity-10">
                    <span class="text-muted small">Target End Date:</span>
                    <span class="fw-semibold text-warning">@(Model.TargetEndDate.HasValue ? Model.TargetEndDate.Value.ToString("MMM dd, yyyy") : "Open Ended")</span>
                </li>
                <li class="list-group-item bg-transparent px-0 py-2.5 d-flex justify-content-between align-items-center border-secondary border-opacity-10">
                    <span class="text-muted small">Budget:</span>
                    <span class="fw-bold text-gold fs-5">@(Model.Budget.HasValue ? "₹" + Model.Budget.Value.ToString("N0") : "TBD")</span>
                </li>
                <li class="list-group-item bg-transparent px-0 py-2.5 d-flex justify-content-between align-items-center border-secondary border-opacity-10">
                    <span class="text-muted small">Created Date:</span>
                    <span class="text-muted small">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                </li>
            </ul>
        </div>
    </div>
</div>
