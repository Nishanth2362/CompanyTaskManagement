<!-- Export Tasksheet Modal -->
<div class="modal fade" id="exportTasksheetModal" tabindex="-1" aria-labelledby="exportTasksheetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 shadow-lg">
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-inline-flex align-items-center justify-content-center bg-emerald-subtle text-emerald rounded-circle" style="width: 40px; height: 40px;">
                        <i class="bi bi-file-earmark-excel-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="exportTasksheetModalLabel">Export Tasksheet</h5>
                        <small class="text-muted">Export date range details or total tasksheet</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ExportDailyTasksheet" method="get" id="exportTasksheetForm">
                <div class="modal-body py-4">
                    <div class="alert alert-info-subtle border-0 mb-4 p-3 rounded-3 d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill text-info fs-5 mt-0.5"></i>
                        <small class="text-body">
                            Select a <strong>Start Date</strong> and <strong>End Date</strong> to export required date-range details. If left blank, the <strong>total tasksheet</strong> will be exported.
                        </small>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="exportStartDate" class="form-label fw-semibold text-secondary">Start Date</label>
                            <input type="date" id="exportStartDate" name="startDate" class="form-control form-control-modern" />
                        </div>
                        <div class="col-md-6">
                            <label for="exportEndDate" class="form-label fw-semibold text-secondary">End Date</label>
                            <input type="date" id="exportEndDate" name="endDate" class="form-control form-control-modern" />
                        </div>
                        <div class="col-12">
                            <label for="exportFilterSelect" class="form-label fw-semibold text-secondary">Status Filter</label>
                            <select id="exportFilterSelect" name="filter" class="form-select form-select-modern">
                                <option value="all" selected>All Tasks (Total Tasksheet)</option>
                                <option value="today">Today's Tasks</option>
                                <option value="inprogress">In Progress Tasks</option>
                                <option value="overdue">Overdue Tasks</option>
                                <option value="completed">Completed Tasks</option>
                                <option value="urgent">Urgent / High Priority</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25 pt-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" id="clearExportDatesBtn">
                        <i class="bi bi-x-circle me-1"></i> Clear Dates
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-emerald d-inline-flex align-items-center gap-2 rounded-3">
                            <i class="bi bi-download"></i> Export Tasksheet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document.body).ready(function () {
            let activeTaskModalId = null;

            // Clear Dates button in Export Tasksheet Modal
            $('#clearExportDatesBtn').on('click', function () {
                $('#exportStartDate').val('');
                $('#exportEndDate').val('');
            });

            // Populate Company & Employee filter dropdowns dynamically
            const companiesSet = new Set();
            const employeesSet = new Set();

            $('.task-row-item, .task-card-item').each(function () {
                const comps = $(this).data('companies');
                const emps = $(this).data('employees');

                if (comps) {
                    comps.split(',').forEach(c => {
                        const trimmed = c.trim();
                        if (trimmed) companiesSet.add(trimmed);
                    });
                }
                if (emps) {
                    emps.split(',').forEach(e => {
                        const trimmed = e.trim();
                        if (trimmed) employeesSet.add(trimmed);
                    });
                }
            });

            Array.from(companiesSet).sort().forEach(c => {
                $('#companyFilterSelect').append(new Option(c, c));
            });

            Array.from(employeesSet).sort().forEach(e => {
                $('#employeeFilterSelect').append(new Option(e, e));
            });

            // ----------------------------------------------------
            // View Mode Switcher (Table vs Grid vs Kanban)
            // ----------------------------------------------------
            $('#tableViewBtn').on('click', function () {
                $('.view-toggle-btn-group .btn').removeClass('active');
                $(this).addClass('active');
                $('#taskTableView').removeClass('d-none');
                $('#taskGridView, #taskKanbanView').addClass('d-none');
                filterTasks();
            });

            $('#gridViewBtn').on('click', function () {
                $('.view-toggle-btn-group .btn').removeClass('active');
                $(this).addClass('active');
                $('#taskGridView').removeClass('d-none');
                $('#taskTableView, #taskKanbanView').addClass('d-none');
                filterTasks();
            });

            $('#kanbanViewBtn').on('click', function () {
                $('.view-toggle-btn-group .btn').removeClass('active');
                $(this).addClass('active');
                $('#taskKanbanView').removeClass('d-none');
                $('#taskTableView, #taskGridView').addClass('d-none');
                filterTasks();
            });

            // ----------------------------------------------------
            // Filter & Pagination Engine (10 items per page)
            // ----------------------------------------------------
            let currentPage = 1;
            let pageSize = 10;

            function filterTasks(resetPage = false) {
                if (resetPage) {
                    currentPage = 1;
                }

                const tabFilter = ($('.unified-filter-tabs .filter-tab-btn.active').data('filter') || 'all').toString().toLowerCase();
                const searchTerm = $('#taskSearchInput').val().toLowerCase().trim();
                const companyFilter = $('#companyFilterSelect').val().toLowerCase();
                const employeeFilter = $('#employeeFilterSelect').val().toLowerCase();
                const priorityFilter = $('#priorityFilterSelect').val().toLowerCase();
                const statusFilter = $('#statusFilterSelect').val().toLowerCase();

                const matchedRowElements = [];
                const matchedCardElements = [];

                $('.task-row-item').each(function () {
                    const name = ($(this).data('task-name') || '').toString().toLowerCase();
                    const desc = ($(this).data('task-desc') || '').toString().toLowerCase();
                    const priority = ($(this).data('priority') || '').toString().toLowerCase();
                    const status = ($(this).data('status') || '').toString().toLowerCase();
                    const companies = ($(this).data('companies') || '').toString().toLowerCase();
                    const employees = ($(this).data('employees') || '').toString().toLowerCase();
                    const isToday = String($(this).data('istoday')) === 'true';
                    const isOverdue = String($(this).data('isoverdue')) === 'true';

                    let matchesTab = true;
                    if (tabFilter === 'today') {
                        matchesTab = isToday;
                    } else if (tabFilter === 'inprogress') {
                        matchesTab = (status === 'inprogress');
                    } else if (tabFilter === 'overdue' || tabFilter === 'incomplete') {
                        matchesTab = isOverdue;
                    } else if (tabFilter === 'completed') {
                        matchesTab = (status === 'completed');
                    } else if (tabFilter === 'urgent') {
                        matchesTab = (priority === 'urgent' || priority === 'high');
                    }

                    const matchesSearch = !searchTerm || name.includes(searchTerm) || desc.includes(searchTerm) || companies.includes(searchTerm) || employees.includes(searchTerm);
                    const matchesCompany = !companyFilter || companies.includes(companyFilter);
                    const matchesEmployee = !employeeFilter || employees.includes(employeeFilter);
                    const matchesPriority = !priorityFilter || priority === priorityFilter;
                    const matchesStatus = !statusFilter || status === statusFilter;

                    if (matchesSearch && matchesCompany && matchesEmployee && matchesPriority && matchesStatus && matchesTab) {
                        matchedRowElements.push(this);
                    } else {
                        $(this).addClass('d-none');
                    }
                });

                $('.task-card-item').each(function () {
                    const name = ($(this).data('task-name') || '').toString().toLowerCase();
                    const desc = ($(this).data('task-desc') || '').toString().toLowerCase();
                    const priority = ($(this).data('priority') || '').toString().toLowerCase();
                    const status = ($(this).data('status') || '').toString().toLowerCase();
                    const companies = ($(this).data('companies') || '').toString().toLowerCase();
                    const employees = ($(this).data('employees') || '').toString().toLowerCase();
                    const isToday = String($(this).data('istoday')) === 'true';
                    const isOverdue = String($(this).data('isoverdue')) === 'true';

                    let matchesTab = true;
                    if (tabFilter === 'today') {
                        matchesTab = isToday;
                    } else if (tabFilter === 'inprogress') {
                        matchesTab = (status === 'inprogress');
                    } else if (tabFilter === 'overdue' || tabFilter === 'incomplete') {
                        matchesTab = isOverdue;
                    } else if (tabFilter === 'completed') {
                        matchesTab = (status === 'completed');
                    } else if (tabFilter === 'urgent') {
                        matchesTab = (priority === 'urgent' || priority === 'high');
                    }

                    const matchesSearch = !searchTerm || name.includes(searchTerm) || desc.includes(searchTerm) || companies.includes(searchTerm) || employees.includes(searchTerm);
                    const matchesCompany = !companyFilter || companies.includes(companyFilter);
                    const matchesEmployee = !employeeFilter || employees.includes(employeeFilter);
                    const matchesPriority = !priorityFilter || priority === priorityFilter;
                    const matchesStatus = !statusFilter || status === statusFilter;

                    if (matchesSearch && matchesCompany && matchesEmployee && matchesPriority && matchesStatus && matchesTab) {
                        matchedCardElements.push(this);
                    } else {
                        $(this).addClass('d-none');
                    }
                });

                const totalMatched = matchedRowElements.length;
                const totalPages = Math.ceil(totalMatched / pageSize) || 1;

                if (currentPage > totalPages) {
                    currentPage = totalPages;
                }
                if (currentPage < 1) {
                    currentPage = 1;
                }

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = Math.min(startIndex + pageSize, totalMatched);

                // Paginate Table Rows
                matchedRowElements.forEach((el, index) => {
                    if (index >= startIndex && index < endIndex) {
                        $(el).removeClass('d-none');
                    } else {
                        $(el).addClass('d-none');
                    }
                });

                // Paginate Mobile Card Items
                matchedCardElements.forEach((el, index) => {
                    if (index >= startIndex && index < endIndex) {
                        $(el).removeClass('d-none');
                    } else {
                        $(el).addClass('d-none');
                    }
                });

                // Update Pagination Info Bar
                if (totalMatched === 0) {
                    $('#paginationInfoStart, #mobilePaginationInfoStart').text(0);
                    $('#paginationInfoEnd, #mobilePaginationInfoEnd').text(0);
                    $('#paginationInfoTotal, #mobilePaginationInfoTotal').text(0);
                    $('#taskPaginationBar, #taskMobilePaginationBar').addClass('d-none');
                    $('#noSearchResultsAlert').removeClass('d-none');
                } else {
                    $('#paginationInfoStart, #mobilePaginationInfoStart').text(startIndex + 1);
                    $('#paginationInfoEnd, #mobilePaginationInfoEnd').text(endIndex);
                    $('#paginationInfoTotal, #mobilePaginationInfoTotal').text(totalMatched);
                    $('#taskPaginationBar, #taskMobilePaginationBar').removeClass('d-none');
                    $('#noSearchResultsAlert').addClass('d-none');
                }

                renderPaginationControls(totalPages);

                if (searchTerm || companyFilter || employeeFilter || priorityFilter || statusFilter || tabFilter !== 'all') {
                    $('#searchClearBtn').show();
                } else {
                    $('#searchClearBtn').hide();
                }
            }

            function renderPaginationControls(totalPages) {
                const nav = $('#taskPaginationNav').empty();
                const mobileNav = $('#taskMobilePaginationNav').empty();

                if (totalPages <= 1) {
                    return;
                }

                function buildButtons(targetNav) {
                    // Prev Button
                    targetNav.append(`
                        <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                            <button class="page-link" data-page="${currentPage - 1}" aria-label="Previous">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </li>
                    `);

                    // Page Numbers
                    let startPage = Math.max(1, currentPage - 2);
                    let endPage = Math.min(totalPages, currentPage + 2);

                    if (startPage > 1) {
                        targetNav.append(`<li class="page-item"><button class="page-link" data-page="1">1</button></li>`);
                        if (startPage > 2) {
                            targetNav.append(`<li class="page-item disabled"><span class="page-link">…</span></li>`);
                        }
                    }

                    for (let p = startPage; p <= endPage; p++) {
                        targetNav.append(`
                            <li class="page-item ${p === currentPage ? 'active' : ''}">
                                <button class="page-link" data-page="${p}">${p}</button>
                            </li>
                        `);
                    }

                    if (endPage < totalPages) {
                        if (endPage < totalPages - 1) {
                            targetNav.append(`<li class="page-item disabled"><span class="page-link">…</span></li>`);
                        }
                        targetNav.append(`<li class="page-item"><button class="page-link" data-page="${totalPages}">${totalPages}</button></li>`);
                    }

                    // Next Button
                    targetNav.append(`
                        <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                            <button class="page-link" data-page="${currentPage + 1}" aria-label="Next">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                    `);
                }

                buildButtons(nav);
                buildButtons(mobileNav);
            }

            $(document).on('click', '#taskPaginationNav .page-link, #taskMobilePaginationNav .page-link', function (e) {
                e.preventDefault();
                const page = parseInt($(this).data('page'));
                if (!isNaN(page) && page !== currentPage) {
                    currentPage = page;
                    filterTasks(false);
                    // Smooth scroll to top of table
                    const tableEl = document.getElementById('taskTableView');
                    if (tableEl && window.innerWidth >= 768) {
                        tableEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }
            });

            $('#pageSizeSelect').on('change', function () {
                pageSize = parseInt($(this).val()) || 10;
                currentPage = 1;
                filterTasks(true);
            });

            $('.unified-filter-tabs').on('click', '.filter-tab-btn', function (e) {
                e.preventDefault();
                $('.filter-tab-btn').removeClass('active');
                $(this).addClass('active');
                filterTasks(true);
            });

            $('#taskSearchInput').on('keyup input', function () { filterTasks(true); });
            $('#companyFilterSelect, #employeeFilterSelect, #priorityFilterSelect, #statusFilterSelect').on('change', function () { filterTasks(true); });

            $('#searchClearBtn, #resetFilterBtn').on('click', function () {
                $('#taskSearchInput').val('');
                $('#companyFilterSelect').val('');
                $('#employeeFilterSelect').val('');
                $('#priorityFilterSelect').val('');
                $('#statusFilterSelect').val('');
                $('.filter-tab-btn').removeClass('active');
                $('#filterTabAll').addClass('active');
                filterTasks(true);
            });

            // Initial pagination run
            filterTasks(true);

            // ----------------------------------------------------
            // Quick AJAX Status Change
            // ----------------------------------------------------
            $(document).on('change', '.js-quick-status', function () {
                const taskId = $(this).data('task-id');
                const newStatus = $(this).val();
                updateTaskStatus(taskId, newStatus);
            });

            $(document).on('click', '.js-move-status', function () {
                const taskId = $(this).data('task-id');
                const targetStatusInt = $(this).data('target-status');
                const statusNames = ["ToDo", "InProgress", "InReview", "Completed"];
                if (targetStatusInt >= 0 && targetStatusInt < statusNames.length) {
                    updateTaskStatus(taskId, statusNames[targetStatusInt]);
                }
            });

            function updateTaskStatus(taskId, statusStr) {
                $.ajax({
                    url: '/Task/QuickUpdateStatus',
                    type: 'POST',
                    data: { id: taskId, status: statusStr },
                    success: function (res) {
                        if (res.success) {
                            showToast(res.message);
                            window.location.reload();
                        }
                    }
                });
            }

            // ----------------------------------------------------
            // HTML5 Interactive Drag and Drop Kanban Board
            // ----------------------------------------------------
            let draggedTaskCard = null;

            $(document).on('dragstart', '.kanban-card', function (e) {
                draggedTaskCard = this;
                $(this).addClass('dragging');
                if (e.originalEvent.dataTransfer) {
                    e.originalEvent.dataTransfer.effectAllowed = 'move';
                    e.originalEvent.dataTransfer.setData('text/plain', $(this).data('task-id'));
                }
            });

            $(document).on('dragend', '.kanban-card', function () {
                $(this).removeClass('dragging');
                $('.kanban-column').removeClass('drag-over');
                draggedTaskCard = null;
            });

            $('.kanban-column').on('dragover', function (e) {
                e.preventDefault();
                if (e.originalEvent.dataTransfer) {
                    e.originalEvent.dataTransfer.dropEffect = 'move';
                }
                $(this).addClass('drag-over');
            });

            $('.kanban-column').on('dragleave', function () {
                $(this).removeClass('drag-over');
            });

            $('.kanban-column').on('drop', function (e) {
                e.preventDefault();
                $(this).removeClass('drag-over');
                const newStatusStr = $(this).data('kanban-status');
                if (draggedTaskCard && newStatusStr) {
                    const taskId = $(draggedTaskCard).data('task-id');
                    const currentStatus = $(draggedTaskCard).data('status');

                    if (currentStatus !== newStatusStr) {
                        const targetList = $(this).find('.kanban-card-list');
                        $(draggedTaskCard).detach().appendTo(targetList);
                        $(draggedTaskCard).attr('data-status', newStatusStr).data('status', newStatusStr);
                        updateTaskStatus(taskId, newStatusStr);
                    }
                }
            });

            // ----------------------------------------------------
            // Quick Error Reporting & Screenshot Upload Modal
            // ----------------------------------------------------
            $(document).on('click', '.open-error-report-btn', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                const delayReason = $(this).data('delayreason') || '';
                const errorDetails = $(this).data('errordetails') || '';
                const screenshot = $(this).data('errorscreenshot') || '';

                $('#quickErrorTaskId').val(id);
                $('#reportErrorTaskTitle').text(`#${String(id).padStart(3, '0')} - ${name}`);
                $('#quickDelayReason').val(delayReason);
                $('#quickErrorDetails').val(errorDetails);
                $('#quickScreenshotFile').val('');

                if (screenshot) {
                    $('#quickScreenshotPreviewImg').attr('src', screenshot);
                    $('#quickScreenshotPreviewContainer').removeClass('d-none');
                } else {
                    $('#quickScreenshotPreviewContainer').addClass('d-none');
                }

                const errModal = new bootstrap.Modal(document.getElementById('reportErrorModal'));
                errModal.show();
            });

            $('#quickScreenshotFile').on('change', function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $('#quickScreenshotPreviewImg').attr('src', e.target.result);
                        $('#quickScreenshotPreviewContainer').removeClass('d-none');
                    }
                    reader.readAsDataURL(file);
                }
            });

            $('#quickErrorForm').on('submit', function (e) {
                e.preventDefault();
                const formData = new FormData(this);
                const btn = $('#saveQuickErrorBtn');
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Saving...');

                $.ajax({
                    url: '/Task/QuickUploadErrorLog',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (res) {
                        bootstrap.Modal.getInstance(document.getElementById('reportErrorModal')).hide();
                        if (res.success) {
                            showToast(res.message);
                            window.location.reload();
                        } else {
                            showToast(res.message || 'Error saving report.');
                        }
                    },
                    complete: function () {
                        btn.prop('disabled', false).html('<i class="bi bi-upload me-1"></i>Upload & Save Report');
                    }
                });
            });

            // ----------------------------------------------------
            // HR Escalation Modal & Email Redirection
            // ----------------------------------------------------
            function openEmailComposer(targetEmail, overdueTasksList, forceMailto = false) {
                const email = targetEmail || 'hr@auxinz.io';
                const subject = `[URGENT] Overdue Tasks Escalation Report - AUXINZ.io`;
                
                let body = `Dear HR Team,\n\n`;
                body += `This is an urgent escalation regarding overdue tasks requiring management attention.\n\n`;
                
                const count = overdueTasksList ? overdueTasksList.length : 0;
                body += `Total Overdue Tasks: ${count}\n\n`;
                
                if (count > 0) {
                    body += `Top Overdue Tasks:\n`;
                    const limit = Math.min(count, 3);
                    for (let i = 0; i < limit; i++) {
                        const t = overdueTasksList[i];
                        body += `• ${t.name} (Due: ${t.dueDate || 'Overdue'})\n`;
                    }
                    if (count > limit) {
                        body += `... and ${count - limit} more overdue task(s).\n`;
                    }
                    body += `\n`;
                }

                body += `View details on Tasksheet Portal: ${window.location.origin}/\n\n`;
                body += `Best regards,\nTask Management Automation`;

                const encEmail = encodeURIComponent(email);
                const encSubject = encodeURIComponent(subject);
                const encBody = encodeURIComponent(body);

                const mailtoUrl = `mailto:${encEmail}?subject=${encSubject}&body=${encBody}`;

                if (forceMailto) {
                    window.location.href = mailtoUrl;
                } else {
                    const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&tf=1&to=${encEmail}&su=${encSubject}&body=${encBody}`;
                    try {
                        const win = window.open(gmailUrl, '_blank');
                        if (!win || win.closed || typeof win.closed === 'undefined') {
                            window.location.href = mailtoUrl;
                        }
                    } catch (e) {
                        window.location.href = mailtoUrl;
                    }
                }
            }

            let cachedOverdueTasks = [];

            $('#openHrModalBtn, #openModalFromDropdownBtn').on('click', function (e) {
                e.preventDefault();
                const hrModal = new bootstrap.Modal(document.getElementById('hrEscalationModal'));
                $('#hrModalLoading').removeClass('d-none');
                $('#hrModalEmpty, #hrModalContent').addClass('d-none');
                $('#sendHrEmailBtn, #redirectToGmailBtn').prop('disabled', true);

                hrModal.show();

                $.ajax({
                    url: '/Task/GetOverdueTaskPreview',
                    type: 'GET',
                    success: function (res) {
                        $('#hrModalLoading').addClass('d-none');
                        cachedOverdueTasks = res.tasks || [];
                        if (res.count === 0) {
                            $('#hrModalEmpty').removeClass('d-none');
                            $('#sendHrEmailBtn').prop('disabled', true);
                            $('#redirectToGmailBtn').prop('disabled', false);
                        } else {
                            $('#hrModalContent').removeClass('d-none');
                            $('#sendHrEmailBtn, #redirectToGmailBtn').prop('disabled', false);
                            $('#hrOverdueCount').text(res.count);

                            const listContainer = $('#hrOverdueList').empty();
                            res.tasks.forEach(t => {
                                listContainer.append(`
                                    <div class="p-3 bg-dark-subtle rounded-3 border border-danger border-opacity-50">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="text-white">#${String(t.id).padStart(3, '0')} - ${t.name}</strong>
                                            <span class="badge bg-danger">${t.priority}</span>
                                        </div>
                                        <small class="text-white-50 d-block">Assigned: ${t.employees || 'Unassigned'} | Companies: ${t.companies || 'None'}</small>
                                        <small class="text-danger fw-bold"><i class="bi bi-calendar-event me-1"></i>Due Date: ${t.dueDate} (${t.status})</small>
                                        ${t.delayReason ? `<div class="mt-1 small text-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i>Delay: ${t.delayReason}</div>` : ''}
                                    </div>
                                `);
                            });
                        }
                    }
                });
            });

            // Redirect to Gmail button in Modal
            $('#redirectToGmailBtn').on('click', function () {
                const targetEmail = $('#hrDestinationEmailInput').val() || 'hr@auxinz.io';
                openEmailComposer(targetEmail, cachedOverdueTasks, false);
            });

            // Direct Compose in Gmail from Header dropdown
            $('#directGmailRedirectBtn').on('click', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '/Task/GetOverdueTaskPreview',
                    type: 'GET',
                    success: function (res) {
                        openEmailComposer('hr@auxinz.io', res.tasks || [], false);
                    },
                    error: function () {
                        openEmailComposer('hr@auxinz.io', [], false);
                    }
                });
            });

            // Direct Open Default Mail App from Header dropdown
            $('#directMailtoRedirectBtn').on('click', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '/Task/GetOverdueTaskPreview',
                    type: 'GET',
                    success: function (res) {
                        openEmailComposer('hr@auxinz.io', res.tasks || [], true);
                    },
                    error: function () {
                        openEmailComposer('hr@auxinz.io', [], true);
                    }
                });
            });

            $('#sendHrEmailBtn').on('click', function () {
                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Sending Email...');

                $.ajax({
                    url: '/Task/SendOverdueHrNotification',
                    type: 'POST',
                    success: function (res) {
                        bootstrap.Modal.getInstance(document.getElementById('hrEscalationModal')).hide();
                        if (res.success) {
                            showToast(res.message);
                        } else {
                            showToast(res.message || 'Failed to send email.');
                        }
                    },
                    complete: function () {
                        btn.prop('disabled', false).html('<i class="bi bi-send-fill me-1"></i>Send Email Notification to HR');
                    }
                });
            });

            // ----------------------------------------------------
            // Quick View Modal
            // ----------------------------------------------------
            $(document).on('click', '.quick-view-btn', function () {
                activeTaskModalId = $(this).data('id');
                const name = $(this).data('name');
                const desc = $(this).data('desc') || 'No description provided.';
                const priority = $(this).data('priority');
                const status = $(this).data('status');
                const duedate = $(this).data('duedate');
                const delayReason = $(this).data('delayreason');
                const errorDetails = $(this).data('errordetails');
                const screenshot = $(this).data('errorscreenshot');
                const companies = $(this).data('companies') || '';
                const employees = $(this).data('employees') || '';

                $('#modalTaskId').text('#' + String(activeTaskModalId).padStart(3, '0'));
                $('#modalTaskPriority').text(priority);
                $('#modalTaskPriority').attr('class', 'priority-badge priority-' + String(priority).toLowerCase());
                $('#modalTaskName').text(name);
                $('#modalTaskDesc').text(desc);
                $('#modalTaskDueDate').html('<i class="bi bi-calendar-event me-1"></i> ' + duedate);
                $('#modalTaskStatusSelect').val(status);

                if (delayReason || errorDetails || screenshot) {
                    $('#modalErrorContainer').removeClass('d-none');
                    $('#modalDelayReason').text(delayReason ? 'Delay Reason: ' + delayReason : '');
                    $('#modalErrorDetails').text(errorDetails ? 'Error Details: ' + errorDetails : '');

                    if (screenshot) {
                        $('#modalScreenshotImg').attr('src', screenshot);
                        $('#modalScreenshotWrapper').removeClass('d-none');
                    } else {
                        $('#modalScreenshotWrapper').addClass('d-none');
                    }
                } else {
                    $('#modalErrorContainer').addClass('d-none');
                }

                $('#modalEditLink').attr('href', '/Task/Edit/' + activeTaskModalId);
                $('#modalDetailsLink').attr('href', '/Task/Details/' + activeTaskModalId);

                const compContainer = $('#modalTaskCompanies').empty();
                if (companies) {
                    companies.split(',').forEach(c => {
                        compContainer.append(`<span class="company-badge-chip"><i class="bi bi-buildings"></i> ${c.trim()}</span>`);
                    });
                } else {
                    compContainer.append('<span class="empty-badge-pill">No companies</span>');
                }

                const empContainer = $('#modalTaskEmployees').empty();
                if (employees) {
                    employees.split(',').forEach(e => {
                        const trimmed = e.trim();
                        const initial = trimmed ? trimmed.charAt(0) : '?';
                        empContainer.append(`<span class="employee-badge-chip"><span class="avatar-initial-circle avatar-color-1">${initial}</span> ${trimmed}</span>`);
                    });
                } else {
                    empContainer.append('<span class="empty-badge-pill">No team assigned</span>');
                }

                const quickModal = new bootstrap.Modal(document.getElementById('quickViewModal'));
                quickModal.show();
            });

            $('#modalTaskStatusSelect').on('change', function () {
                if (activeTaskModalId) {
                    updateTaskStatus(activeTaskModalId, $(this).val());
                }
            });

            $('#modalCopySummaryBtn').on('click', function () {
                const title = $('#modalTaskName').text();
                const desc = $('#modalTaskDesc').text();
                navigator.clipboard.writeText(`Task: ${title}\nDescription: ${desc}`);
                showToast('Summary copied to clipboard!');
            });



            function showToast(msg) {
                if ($('#appToast').length) {
                    $('#appToastMessage').text(msg);
                    const toast = new bootstrap.Toast(document.getElementById('appToast'));
                    toast.show();
                }
            }
        });
    </script>
}