                                                                                                // ----------------------------------------------------
                                                                                                // HR Escalation Modal & Email Redirection
                                                                                                // ----------------------------------------------------
                                                                                                function openEmailComposer(targetTo, overdueTasksList, forceMailto = false, targetCc = null, targetBcc = null) {
                                                                                                    const toEmail = targetTo || $('#hrDestinationEmailInput').val() || 'mukesh@auxinz.io';
                                                                                                    const ccEmail = targetCc !== null ? targetCc : ($('#hrCcEmailInput').val() || 'nithin@amoebatronix.com');
                                                                                                    const bccEmail = targetBcc !== null ? targetBcc : ($('#hrBccEmailInput').val() || 'hr@auxinz.io');
                                                                                                    const subject = `[URGENT] Overdue Tasks Escalation Report - AUXINZ.io`;
                
                                                                                                    let body = `Dear HR Team,\n\n`;
                                                                                                    body += `This is an urgent escalation regarding overdue tasks requiring management attention.\n\n`;
                
                                                                                                    const count = overdueTasksList ? overdueTasksList.length : 0;
                                                                                                    body += `Total Overdue Tasks: ${count}\n\n`;
                
                                                                                                    if (count > 0) {
                                                                                                        body += `Top Overdue Tasks:\n`;
                                                                                                        const limit = Math.min(count, 3);
                                                                                                        for (let i = 0; i < limit; i++) {
                                                                                                            const t = overdueTasksList[i];
                                                                                                            body += `• ${t.name} (Due: ${t.dueDate || 'Overdue'})\n`;
                                                                                                        }
                                                                                                        if (count > limit) {
                                                                                                            body += `... and ${count - limit} more overdue task(s).\n`;
                                                                                                        }
                                                                                                        body += `\n`;
                                                                                                    }

                                                                                                    body += `View details on Tasksheet Portal: ${window.location.origin}/\n\n`;
                                                                                                    body += `Best regards,\nTask Management Automation`;

                                                                                                    const encTo = encodeURIComponent(toEmail);
                                                                                                    const encCc = encodeURIComponent(ccEmail);
                                                                                                    const encBcc = encodeURIComponent(bccEmail);
                                                                                                    const encSubject = encodeURIComponent(subject);
                                                                                                    const encBody = encodeURIComponent(body);

                                                                                                    const mailtoUrl = `mailto:${encTo}?cc=${encCc}&bcc=${encBcc}&subject=${encSubject}&body=${encBody}`;

                                                                                                    if (forceMailto) {
                                                                                                        window.location.href = mailtoUrl;
                                                                                                    } else {
                                                                                                        const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&tf=1&to=${encTo}&cc=${encCc}&bcc=${encBcc}&su=${encSubject}&body=${encBody}`;
                                                                                                        try {
                                                                                                            const win = window.open(gmailUrl, '_blank');
                                                                                                            if (!win || win.closed || typeof win.closed === 'undefined') {
                                                                                                                window.location.href = mailtoUrl;
                                                                                                            }
                                                                                                        } catch (e) {
                                                                                                            window.location.href = mailtoUrl;
                                                                                                        }
                                                                                                    }
                                                                                                }

