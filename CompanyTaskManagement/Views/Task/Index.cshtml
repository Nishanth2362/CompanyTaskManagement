                    <div class="col-12 col-md-6">
                        <div class="p-3 bg-dark-subtle rounded-3 h-100 border border-secondary border-opacity-25">
                            <h6 class="fw-bold text-purple small text-uppercase mb-2">
                                <i class="bi bi-people me-1"></i> Assigned Team
                            </h6>
                            <div id="modalTaskEmployees" class="d-flex flex-wrap gap-1">
