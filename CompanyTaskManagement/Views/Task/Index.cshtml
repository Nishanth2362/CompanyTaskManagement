    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-task-id" id="modalTaskId">#000</span>
                    <span class="priority-badge priority-medium" id="modalTaskPriority">Medium</span>
                    <h5 class="modal-title fw-bold mb-0 ms-2" id="quickViewModalLabel">Task Overview</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
