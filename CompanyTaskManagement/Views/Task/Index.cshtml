@model IEnumerable<CompanyTaskManagement.Models.TaskItem>
@inject CompanyTaskManagement.Services.IUserSessionService UserSession

@{
    ViewData["Title"] = "Tasks Dashboard";
    var taskList = Model?.ToList() ?? new List<CompanyTaskManagement.Models.TaskItem>();
    var totalTasks = taskList.Count;
    var inProgressCount = taskList.Count(t => t.Status == CompanyTaskManagement.Models.TaskStatus.InProgress);
    var completedCount = taskList.Count(t => t.Status == CompanyTaskManagement.Models.TaskStatus.Completed);
    var overdueUncompletedCount = taskList.Count(t => t.Status != CompanyTaskManagement.Models.TaskStatus.Completed &&
((t.EndDate.HasValue && t.EndDate.Value <= DateTime.Now) || (t.DueDate.HasValue && (t.DueDate.Value <= DateTime.Now ||
t.DueDate.Value.Date < DateTime.Today)) || !string.IsNullOrEmpty(t.DelayReason)));
    var tasksWithErrorsCount = taskList.Count(t => !string.IsNullOrEmpty(t.ErrorScreenshotPath) ||
!string.IsNullOrEmpty(t.DelayReason) || !string.IsNullOrEmpty(t.ErrorDetails));
    var isCanAssign = UserSession.IsAdminOrHr();
    var isEmployee = UserSession.IsEmployee();
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<!-- Taskboard Custom Style & Full Page Background Image -->
<style>
    body {
        background-image: linear-gradient(180deg, rgba(240, 249, 255, 0.78) 0%, rgba(224, 242, 254, 0.88) 100%), url('@Url.Content("~/images/taskboard-bg.png")') !important;
        background-repeat: no-repeat !important;
        background-position: center bottom !important;
        background-size: cover !important;
        background-attachment: fixed !important;
    }

    [data-bs-theme="dark"] body {
        background-image: linear-gradient(180deg, rgba(15, 23, 42, 0.88) 0%, rgba(12, 42, 74, 0.92) 100%), url('@Url.Content("~/images/taskboard-bg.png")') !important;
        background-repeat: no-repeat !important;
        background-position: center bottom !important;
        background-size: cover !important;
        background-attachment: fixed !important;
    }

    .taskboard-hero-card {
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.92) 0%, rgba(2, 132, 199, 0.92) 50%, rgba(3, 105, 161, 0.94) 100%), url('@Url.Content("~/images/taskboard-bg.png")') center bottom / cover no-repeat;
        border-radius: 16px;
        border: 1px solid rgba(56, 189, 248, 0.4) !important;
        box-shadow: 0 12px 28px -4px rgba(2, 132, 199, 0.25) !important;
    }
</style>

<!-- Taskboard Hero Banner with Skyline Background -->
<div class="taskboard-hero-card mb-4 p-4 p-lg-4.5 text-white position-relative overflow-hidden">
    <!-- Ambient Light Accent -->
    <div
        style="position: absolute; right: -40px; top: -40px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%); border-radius: 50%; pointer-events: none; z-index: 1;">
    </div>

    <div class="row align-items-center g-4 position-relative" style="z-index: 2;">
        <div class="col-12 col-lg-7">
            <div class="d-flex align-items-center gap-2 mb-2.5 flex-wrap">
                <span class="badge rounded-pill fw-bold px-3 py-1.5 shadow-sm"
                      style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); color: #0f172a; font-size: 0.76rem; letter-spacing: 0.03em;">
                    <i class="bi bi-shield-check-fill me-1"></i> Auxinzio Task Hub
                </span>
                <span class="badge rounded-pill px-3 py-1.5 fw-bold"
                      style="background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); color: #ffffff; font-size: 0.76rem; backdrop-filter: blur(8px);">
                    <i class="bi bi-kanban-fill me-1"></i> Task Management &amp; Tracking
                </span>
            </div>
            <h1 class="h2 fw-extrabold text-white mb-2"
                style="font-family: 'Outfit', sans-serif; font-size: 1.95rem; letter-spacing: -0.02em;">
                Task Dashboard
            </h1>
            <p class="text-white opacity-90 mb-0" style="font-size: 0.92rem; line-height: 1.55; max-width: 660px;">
                Manage, organize, and monitor cross-company tasks, priorities, and team assignments across all projects.
            </p>
        </div>

        <div class="col-12 col-lg-5 text-lg-end d-flex flex-wrap gap-3 justify-content-start justify-content-lg-end">
            <!-- Notify HR Escalation Button -->
            <button type="button"
                    class="btn text-white rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 flex-grow-1 flex-sm-grow-0"
                    id="openHrModalBtn" title="Notify HR of Overdue Tasks"
                    style="background: #f43f5e; border: none; font-size: 0.9rem;">
                <i class="bi bi-bell-fill"></i>
                <span>Notify HR</span>
            </button>

            <!-- Unified Export Tasksheet Button -->
            <button type="button"
                    class="btn text-white rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 flex-grow-1 flex-sm-grow-0"
                    data-bs-toggle="modal" data-bs-target="#exportTasksheetModal"
                    title="Export Tasksheet with Optional Date Range"
                    style="background: #10b981; border: none; font-size: 0.9rem;">
                <i class="bi bi-download"></i>
                <span>Export Tasksheet</span>
            </button>

            @if (isCanAssign)
            {
                <!-- Create Task Button (Admin & HR Only) -->
                <a asp-action="Create"
                   class="btn text-dark rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 flex-grow-1 flex-sm-grow-0"
                   style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); border: none; font-size: 0.9rem;">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Create Task</span>
                </a>
            }
        </div>
    </div>
</div>

@if (isEmployee)
{
    <!-- Employee Persona Context Banner -->
    <div class="card border-0 shadow-sm mb-4 p-3 glass-card border-start border-4 border-info">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-info-subtle text-info rounded-circle"
                     style="width: 42px; height: 42px;">
                    <i class="bi bi-person-badge-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">Logged in as Employee: <span
                        class="text-primary">@UserSession.GetCurrentEmployeeName()</span></h6>
                        <small class="text-muted">You can view your assigned tasks and update status / report delays. Task
                            creation and assignment is restricted to Admin & HR.</small>
                        </div>
                    </div>
                    @if (ViewBag.MyTasksCount != null)
                    {
                        <span class="badge bg-primary rounded-pill px-3 py-2 font-monospace">@ViewBag.MyTasksCount Assigned Tasks</span>
                    }
                </div>
            </div>
        }

        <!-- Success Notification Alert -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4"
                 role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @{
            var now = DateTime.Now;
            var sevenDaysAgo = now.AddDays(-7);
            var fourteenDaysAgo = now.AddDays(-14);

            var tasksThisWeek = taskList.Count(t => t.CreatedAt >= sevenDaysAgo);
            var tasksLastWeek = taskList.Count(t => t.CreatedAt >= fourteenDaysAgo && t.CreatedAt < sevenDaysAgo);
            var weeklyDiff = tasksThisWeek - tasksLastWeek;

            var inProgressPct = totalTasks > 0 ? (int)Math.Round((double)inProgressCount * 100 / totalTasks) : 0;
            var completedPct = totalTasks > 0 ? (int)Math.Round((double)completedCount * 100 / totalTasks) : 0;
            var errorsPct = totalTasks > 0 ? (int)Math.Round((double)tasksWithErrorsCount * 100 / totalTasks) : 0;
        }

        <!-- Stat Metric Cards Row -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 position-relative overflow-hidden h-100"
                     style="background: linear-gradient(135deg, rgba(2, 132, 199, 0.08) 0%, rgba(224, 242, 254, 0.45) 100%); border: 1px solid rgba(2, 132, 199, 0.25) !important; padding: 0.95rem 1.15rem;">
                    <div class="d-flex align-items-center justify-content-between mb-2.5">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-white flex-shrink-0"
                                 style="width: 38px; height: 38px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); font-size: 1.05rem;">
                                <i class="bi bi-list-task"></i>
                            </div>
                            <div>
                                <div class="fw-extrabold font-monospace text-dark" style="font-size: 1.5rem; line-height: 1;"
                                     id="statTotalTasks">@totalTasks</div>
                                <div class="fw-bold text-uppercase text-secondary"
                                     style="font-size: 0.65rem; letter-spacing: 0.03em; margin-top: 3px;">TOTAL TASKS</div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-auto pt-1">
                        <small
                            class="fw-bold @(weeklyDiff >= 0 ? "text-success" : "text-danger") d-inline-flex align-items-center gap-1"
                            style="font-size: 0.72rem;" id="statTotalSubtext">
                            @if (weeklyDiff > 0)
                            {
                                <i class="bi bi-arrow-up-short fs-6"></i><span>@weeklyDiff more</span> <span
                                class="text-muted fw-normal ms-0.5">than last week</span>
                            }
                            else if (weeklyDiff < 0)
                            {
                                <i class="bi bi-arrow-down-short fs-6"></i><span>@(Math.Abs(weeklyDiff)) less</span> <span
                                class="text-muted fw-normal ms-0.5">than last week</span>
                            }
                            else
                            {
                                <i class="bi bi-dash fs-6 text-muted"></i><span>@tasksThisWeek added</span> <span
                                class="text-muted fw-normal ms-0.5">this week</span>
                            }
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 position-relative overflow-hidden h-100"
                     style="background: linear-gradient(135deg, rgba(147, 51, 234, 0.08) 0%, rgba(243, 232, 255, 0.45) 100%); border: 1px solid rgba(147, 51, 234, 0.25) !important; padding: 0.95rem 1.15rem;">
                    <div class="d-flex align-items-start justify-content-between gap-2 mb-2.5">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-white flex-shrink-0"
                                 style="width: 38px; height: 38px; background: linear-gradient(135deg, #9333ea 0%, #6b21a8 100%); font-size: 1.05rem;">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div>
                                <div class="fw-extrabold font-monospace text-dark" style="font-size: 1.5rem; line-height: 1;"
                                     id="statInProgressTasks">@inProgressCount</div>
                                <div class="fw-bold text-uppercase text-secondary"
                                     style="font-size: 0.65rem; letter-spacing: 0.03em; margin-top: 3px;">IN PROGRESS</div>
                            </div>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width: 26px; height: 26px; background: rgba(147, 51, 234, 0.12);">
                            <i class="bi bi-clock text-purple" style="color: #9333ea; font-size: 0.75rem;"></i>
                        </div>
                    </div>
                    <div class="mt-auto pt-1">
                        <div class="fw-bold mb-1" style="color: #7e22ce; font-size: 0.72rem;" id="statInProgressText">
                            @inProgressPct% of total tasks</div>
                            <div class="progress overflow-hidden"
                                 style="height: 5px; background: rgba(147, 51, 234, 0.15); border-radius: 999px;">
                                <div class="progress-bar rounded-pill" id="statInProgressBar"
                                     style="width: @inProgressPct%; background: #9333ea;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-3 position-relative overflow-hidden h-100"
                         style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.08) 0%, rgba(220, 252, 231, 0.45) 100%); border: 1px solid rgba(34, 197, 94, 0.25) !important; padding: 0.95rem 1.15rem;">
                        <div class="d-flex align-items-start justify-content-between gap-2 mb-2.5">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-white flex-shrink-0"
                                     style="width: 38px; height: 38px; background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); font-size: 1.1rem;">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <div>
                                    <div class="fw-extrabold font-monospace text-dark" style="font-size: 1.5rem; line-height: 1;"
                                         id="statCompletedTasks">@completedCount</div>
                                    <div class="fw-bold text-uppercase text-secondary"
                                         style="font-size: 0.65rem; letter-spacing: 0.03em; margin-top: 3px;">COMPLETED</div>
                                </div>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width: 26px; height: 26px; background: rgba(34, 197, 94, 0.15);">
                                <i class="bi bi-graph-up-arrow text-success" style="font-size: 0.75rem;"></i>
                            </div>
                        </div>
                        <div class="mt-auto pt-1">
                            <div class="fw-bold text-success mb-1" style="font-size: 0.72rem;" id="statCompletedText">@completedPct%
                                of total tasks</div>
                                <div class="progress overflow-hidden"
                                     style="height: 5px; background: rgba(34, 197, 94, 0.15); border-radius: 999px;">
                                    <div class="progress-bar rounded-pill" id="statCompletedBar"
                                         style="width: @completedPct%; background: #16a34a;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-3 position-relative overflow-hidden h-100"
                             style="background: linear-gradient(135deg, rgba(244, 63, 94, 0.08) 0%, rgba(254, 226, 226, 0.45) 100%); border: 1px solid rgba(244, 63, 94, 0.25) !important; padding: 0.95rem 1.15rem;">
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-2.5">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-white flex-shrink-0"
                                         style="width: 38px; height: 38px; background: linear-gradient(135deg, #e11d48 0%, #be123c 100%); font-size: 1.05rem;">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                    </div>
                                    <div>
                                        <div class="fw-extrabold font-monospace text-dark" style="font-size: 1.5rem; line-height: 1;"
                                             id="statErrorsTasks">@tasksWithErrorsCount</div>
                                        <div class="fw-bold text-uppercase text-secondary"
                                             style="font-size: 0.65rem; letter-spacing: 0.03em; margin-top: 3px;">REPORTED ERRORS</div>
                                    </div>
                                </div>
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 26px; height: 26px; background: rgba(244, 63, 94, 0.15);">
                                    <i class="bi bi-exclamation-circle-fill text-danger" style="font-size: 0.75rem;"></i>
                                </div>
                            </div>
                            <div class="mt-auto pt-1">
                                <div class="fw-bold text-danger mb-1" style="font-size: 0.72rem;" id="statErrorsText">@errorsPct% of
                                    total tasks</div>
                                    <div class="progress overflow-hidden"
                                         style="height: 5px; background: rgba(244, 63, 94, 0.15); border-radius: 999px;">
                                        <div class="progress-bar rounded-pill" id="statErrorsBar"
                                             style="width: @errorsPct%; background: #e11d48;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- UNIFIED INSTANT FILTER COMMAND BAR -->
                    <div class="card border-0 shadow-sm rounded-4 p-3.5 mb-4 glass-card filter-toolbar-card" id="unifiedFilterBar">
                        <!-- Row 1: Search Bar & Calendar Date -->
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
                            <!-- Live Instant Search -->
                            <div class="search-input-group flex-grow-1" style="max-width: 650px; min-width: 280px;">
                                <i class="bi bi-search search-icon-inside fs-5 text-primary"></i>
                                <input type="text" id="taskSearchInput"
                                       class="form-control form-control-lg search-input ps-5 pe-4 rounded-pill shadow-xs"
                                       placeholder="Search tasks by title, description, company, or team member..." autocomplete="off"
                                       style="height: 44px; font-size: 0.92rem; border-color: rgba(2, 132, 199, 0.25);" />
                                <button type="button" id="searchClearBtn" class="search-clear-btn" title="Clear search">
                                    <i class="bi bi-x-circle-fill text-muted"></i>
                                </button>
                            </div>

                            <!-- Today's Date Badge -->
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-body-tertiary border border-secondary border-opacity-15 font-monospace text-secondary shadow-2xs ms-auto"
                                 style="font-size: 0.82rem;">
                                <i class="bi bi-calendar3 text-primary"></i>
                                <span>Today: <strong class="text-dark">@DateTime.Today.ToString("MMM dd, yyyy")</strong></span>
                            </div>
                        </div>

                        <!-- Row 2: Filter Controls & Dropdowns Bar -->
                        <div class="d-flex align-items-center flex-wrap gap-2 mb-3 pt-1">
                            <!-- Filter by Company -->
                            <div class="input-group input-group-sm flex-nowrap" style="min-width: 190px; max-width: 240px; flex: 1;">
                                <span class="input-group-text bg-body-tertiary border-secondary border-opacity-25 text-primary">
                                    <i class="bi bi-building"></i>
                                </span>
                                <select id="companyFilterSelect" class="form-select filter-select fw-semibold">
                                    <option value="">All Companies</option>
                                </select>
                            </div>

                            <!-- Filter by Employee / Assignee -->
                            <div class="input-group input-group-sm flex-nowrap" style="min-width: 210px; max-width: 260px; flex: 1;">
                                <span class="input-group-text bg-body-tertiary border-secondary border-opacity-25 text-info">
                                    <i class="bi bi-people-fill"></i>
                                </span>
                                <select id="employeeFilterSelect" class="form-select filter-select fw-semibold">
                                    <option value="">All Team Members</option>
                                </select>
                            </div>

                            <!-- Filter by Priority -->
                            <div class="input-group input-group-sm flex-nowrap" style="min-width: 140px; max-width: 180px; flex: 1;">
                                <span class="input-group-text bg-body-tertiary border-secondary border-opacity-25 text-danger">
                                    <i class="bi bi-flag-fill"></i>
                                </span>
                                <select id="priorityFilterSelect" class="form-select filter-select fw-semibold">
                                    <option value="">All Priorities</option>
                                    <option value="Urgent">Urgent</option>
                                    <option value="High">High</option>
                                    <option value="Medium">Medium</option>
                                    <option value="Low">Low</option>
                                </select>
                            </div>

                            <!-- Filter by Status -->
                            <div class="input-group input-group-sm flex-nowrap" style="min-width: 140px; max-width: 180px; flex: 1;">
                                <span class="input-group-text bg-body-tertiary border-secondary border-opacity-25 text-warning">
                                    <i class="bi bi-funnel-fill"></i>
                                </span>
                                <select id="statusFilterSelect" class="form-select filter-select fw-semibold">
                                    <option value="">All Statuses</option>
                                    <option value="ToDo">To Do</option>
                                    <option value="InProgress">In Progress</option>
                                    <option value="InReview">In Review</option>
                                    <option value="Completed">Completed</option>
                                </select>
                            </div>

                            <!-- Reset Filters Button -->
                            <button type="button" id="resetFilterBtn"
                                    class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1 shadow-2xs ms-auto"
                                    style="height: 38px; font-size: 0.82rem;" title="Reset all active filters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span>Reset</span>
                            </button>
                        </div>

                        <!-- Row 2: Interactive Live Filter Tabs -->
                        <div class="pt-2 border-top border-secondary border-opacity-15">
                            <div class="unified-filter-tabs w-100" role="tablist" aria-label="Task Dashboard Instant Filters">
                                <button type="button" class="filter-tab-btn @(currentFilter == "all" ? "active" : "")" data-filter="all"
                                        id="filterTabAll">
                                    <i class="bi bi-grid-fill"></i>
                                    <span>All Tasks</span>
                                    <span class="badge filter-badge" id="badgeCountAll">@ViewBag.AllCount</span>
                                </button>
                                <button type="button" class="filter-tab-btn @(currentFilter == "today" ? "active" : "")" data-filter="today"
                                        id="filterTabToday">
                                    <i class="bi bi-calendar-check"></i>
                                    <span>Today's Tasks</span>
                                    <span class="badge filter-badge" id="badgeCountToday">@ViewBag.TodayCount</span>
                                </button>
                                <button type="button" class="filter-tab-btn @(currentFilter == "inprogress" ? "active" : "")"
                                        data-filter="inprogress" id="filterTabInProgress">
                                    <i class="bi bi-clock-history"></i>
                                    <span>In Progress</span>
                                    <span class="badge filter-badge" id="badgeCountInProgress">@ViewBag.InProgressCount</span>
                                </button>
                                <button type="button"
                                        class="filter-tab-btn @(currentFilter == "overdue" || currentFilter == "incomplete" ? "active" : "")"
                                        data-filter="overdue" id="filterTabOverdue">
                                    <i class="bi bi-exclamation-circle"></i>
                                    <span>Overdue / Rolled Over</span>
                                    <span class="badge filter-badge" id="badgeCountOverdue">@ViewBag.OverdueCount</span>
                                </button>
                                <button type="button" class="filter-tab-btn @(currentFilter == "completed" ? "active" : "")"
                                        data-filter="completed" id="filterTabCompleted">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>Completed</span>
                                </button>
                                <button type="button" class="filter-tab-btn @(currentFilter == "urgent" ? "active" : "")"
                                        data-filter="urgent" id="filterTabUrgent">
                                    <i class="bi bi-fire"></i>
                                    <span>High / Urgent</span>
                                    <span class="badge filter-badge" id="badgeCountUrgent">@ViewBag.UrgentCount</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (!taskList.Any())
                    {
                        <!-- Empty State when no tasks exist -->
                        <div class="table-card p-5 text-center">
                            <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3"
                                 style="width: 72px; height: 72px;">
                                <i class="bi bi-clipboard-plus fs-1"></i>
                            </div>
                            <h4 class="fw-bold mb-1">No tasks created yet</h4>
                            <p class="text-muted mb-4 max-w-sm mx-auto">Get started by creating your first company task and assigning team
                                members.</p>
                                <a asp-action="Create" class="btn btn-primary-gradient px-4">
                                    <i class="bi bi-plus-lg me-1"></i> Create First Task
                                </a>
                            </div>
                        }
else
                        {
                            <!-- 1. TABLE VIEW (Desktop & Tablet) -->
                            <div id="taskTableView" class="table-card d-none d-md-block">
                                <div class="table-responsive" style="overflow: visible;">
                                    <table class="table table-custom" id="mainTaskTable">
                                        <thead>
                                            <tr>
                                                <th class="text-center text-nowrap px-1">#</th>
                                                <th>TASK NAME</th>
                                                <th>PROJECT</th>
                                                <th class="text-nowrap text-center">PRIORITY</th>
                                                <th class="text-nowrap text-center">STATUS</th>
                                                <th>EMPLOYEES</th>
                                                <th class="text-nowrap">START TIME</th>
                                                <th class="text-nowrap">END TIME</th>
                                                <th class="text-nowrap text-center">TOTAL</th>
                                                <th class="text-end text-nowrap">ACTIONS</th>
                                            </tr>
                                            </thead>
                                            <tbody id="taskTableBody">
                                                @{
                                                    int rowNum = 1;
                                                }
                                                @foreach (var item in taskList)
                                                {
                                                    var compNames = item.TaskCompanies != null && item.TaskCompanies.Any()
                                                        ? string.Join(", ", item.TaskCompanies.Select(c => c.Company?.Name))
                                                        : "";
                                                    var empNames = item.TaskEmployees != null && item.TaskEmployees.Any()
                                                        ? string.Join(", ", item.TaskEmployees.Select(e => e.Employee?.Name))
                                                        : "";

                                                    var priorityCss = item.Priority == CompanyTaskManagement.Models.TaskPriority.Urgent ? "priority-urgent" :
                                                                      item.Priority == CompanyTaskManagement.Models.TaskPriority.High ? "priority-high" :
                                                                      item.Priority == CompanyTaskManagement.Models.TaskPriority.Medium ? "priority-medium" : "priority-low";

                                                    var isOverdue = item.Status != CompanyTaskManagement.Models.TaskStatus.Completed &&
                                            ((item.EndDate.HasValue && item.EndDate.Value <= DateTime.Now) || (item.DueDate.HasValue &&
                                            (item.DueDate.Value <= DateTime.Now || item.DueDate.Value.Date < DateTime.Today)) ||
                                            !string.IsNullOrEmpty(item.DelayReason));
                                                    var isToday = (item.StartDate.HasValue ? item.StartDate.Value.Date == DateTime.Today :
                                            item.CreatedAt.Date == DateTime.Today);
                                                    var hasErrorLog = !string.IsNullOrEmpty(item.ErrorScreenshotPath) ||
                                            !string.IsNullOrEmpty(item.DelayReason) || !string.IsNullOrEmpty(item.ErrorDetails);

                                                    var startTime = item.StartDate ?? item.CreatedAt;
                                                    var endTime = item.EndDate ?? item.DueDate;
                                                    string totalWorkingStr = "—";
                                                    if (endTime.HasValue)
                                                    {
                                                        var sTime = startTime.TimeOfDay;
                                                        var eTime = endTime.Value.TimeOfDay;
                                                        TimeSpan diff;
                                                        if (endTime.Value.Date == startTime.Date)
                                                        {
                                                            diff = endTime.Value - startTime;
                                                        }
                                                        else
                                                        {
                                                            if (eTime >= sTime)
                                                            {
                                                                diff = eTime - sTime;
                                                            }
                                                            else
                                                            {
                                                                diff = (TimeSpan.FromHours(24) - sTime) + eTime;
                                                            }
                                                        }

                                                        if (diff.TotalMinutes > 0)
                                                        {
                                                            int h = (int)diff.TotalHours;
                                                            int m = diff.Minutes;
                                                            totalWorkingStr = $"{h}:{m:D2}";
                                                        }
                                                        else
                                                        {
                                                            totalWorkingStr = "0:00";
                                                        }
                                                    }

                                                    <tr class="task-row-item align-middle" data-task-id="@item.Id" data-task-name="@item.TaskName"
                                                        data-task-desc="@item.Description" data-priority="@item.Priority" data-status="@item.Status"
                                                        data-progress="@item.Progress" data-duedate="@(item.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-createddate="@item.CreatedAt.ToString("yyyy-MM-dd")"
                                                        data-istoday="@(isToday ? "true" : "false")" data-isoverdue="@(isOverdue ? "true" : "false")"
                                                        data-haserror="@(hasErrorLog ? "true" : "false")" data-delayreason="@item.DelayReason"
                                                        data-errordetails="@item.ErrorDetails" data-errorscreenshot="@item.ErrorScreenshotPath"
                                                        data-companies="@compNames" data-employees="@empNames"
                                                        data-project="@(item.Project?.ProjectName ?? "")">

                                                        <!-- Tasksheet Number with Row Number -->
                                                        <td class="text-center text-nowrap px-1" style="width: 50px; min-width: 46px;">
                                                            <span class="row-number-badge font-monospace">@(rowNum++)</span>
                                                        </td>

                                                        <!-- Task Name & Desc -->
                                                        <td>
                                                            <div class="d-flex align-items-center gap-2">
                                                                <a asp-action="Details" asp-route-id="@item.Id" class="task-title-link">
                                                                    @item.TaskName
                                                                </a>
                                                                @if (hasErrorLog)
                                                                {
                                                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-2"
                                                                          title="Error/Delay reported">
                                                                        <i class="bi bi-exclamation-circle-fill"></i> Issue
                                                                    </span>
                                                                }
                                                            </div>
                                                            <div class="task-desc-truncate" title="@item.Description">
                                                                @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                                            </div>
                                                        </td>

                                                        <!-- Project -->
                                                        <td>
                                                            @if (item.Project != null)
                                                            {
                                                                <span class="project-badge-chip" title="@item.Project.ProjectName">
                                                                    <i class="bi bi-briefcase-fill"></i>
                                                                    <span>@item.Project.ProjectName</span>
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary-subtle text-muted rounded-pill px-2 py-0.5 small">General</span>
                                                            }
                                                        </td>

                                                        <!-- Priority -->
                                                        <td class="text-nowrap text-center" style="min-width: 80px;">
                                                            <span class="priority-badge @priorityCss">
                                                                @if (item.Priority == CompanyTaskManagement.Models.TaskPriority.Urgent)
                                                                {
                                                                    <i class="bi bi-fire text-danger me-1"></i>
                                                                }
                                                                else if (item.Priority == CompanyTaskManagement.Models.TaskPriority.High)
                                                                {
                                                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                                                }
                                                                <span>@item.Priority</span>
                                                            </span>
                                                        </td>

                                                        <!-- Status Selector -->
                                                        <td class="text-nowrap text-center" style="min-width: 100px;">
                                                            <select class="form-select form-select-sm quick-status-select js-quick-status d-inline-block"
                                                                    data-task-id="@item.Id">
                                                                <option value="ToDo"
                                                                        selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.ToDo)">To Do</option>
                                                                <option value="InProgress"
                                                                        selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.InProgress)">In
                                                                    Progress</option>
                                                                    <option value="InReview"
                                                                            selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.InReview)">In Review
                                                                    </option>
                                                                    <option value="Completed"
                                                                            selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.Completed)">Completed
                                                                    </option>
                                                                </select>
                                                            </td>

                                                            <!-- Assigned Employees -->
                                                            <td style="min-width: 120px;">
                                                                <div class="d-flex flex-column gap-1.5">
                                                                    @if (item.TaskEmployees != null && item.TaskEmployees.Any())
                                                                    {
                                                                        <div class="d-flex flex-wrap gap-1">
                                                                            @foreach (var emp in item.TaskEmployees)
                                                                            {
                                                                                var initial = !string.IsNullOrEmpty(emp.Employee?.Name) ? emp.Employee.Name.Substring(0,
                                        1) : "?";
                                                                                var colorIdx = Math.Abs((emp.Employee?.Name ?? "").GetHashCode()) % 7;
                                                                                <span class="employee-badge-chip">
                                                                                    <span class="avatar-initial-circle avatar-color-@colorIdx">@initial</span>
                                                                                    <span>@emp.Employee?.Name</span>
                                                                                </span>
                                                                            }
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div>
                                                                            <span class="empty-badge-pill" style="font-size: 0.72rem;">
                                                                                <i class="bi bi-person-slash me-1 opacity-75"></i>No team assigned
                                                                            </span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </td>

                                                            <!-- Task Start Time -->
                                                            <td class="text-nowrap" style="min-width: 105px;">
                                                                <div class="d-flex align-items-center gap-1.5">
                                                                    <i class="bi bi-clock-fill text-success" style="font-size: 1.05rem;"></i>
                                                                    <span class="fw-bold font-monospace text-body"
                                                                          style="font-size: 0.88rem;">@startTime.ToString("h:mm tt")</span>
                                                                </div>
                                                                <small class="text-muted d-block"
                                                                       style="font-size: 0.72rem; padding-left: 1.45rem;">@startTime.ToString("MMM dd, yyyy")</small>
                                                            </td>

                                                            <!-- Task End Time -->
                                                            <td class="text-nowrap" style="min-width: 105px;">
                                                                @if (endTime.HasValue)
                                                                {
                                                                    <div class="d-flex align-items-center gap-1.5">
                                                                        <i class="bi bi-clock-fill @(isOverdue ? "text-danger" : "text-primary")"
                                                                           style="font-size: 1.05rem;"></i>
                                                                        <span class="fw-bold font-monospace @(isOverdue ? "text-danger" : "text-body")"
                                                                              style="font-size: 0.88rem;">@endTime.Value.ToString("h:mm tt")</span>
                                                                        @if (isOverdue)
                                                                        {
                                                                            <i class="bi bi-exclamation-circle-fill text-danger extra-small" title="Overdue"></i>
                                                                        }
                                                                    </div>
                                                                    <small class="text-muted d-block"
                                                                           style="font-size: 0.72rem; padding-left: 1.45rem;">@endTime.Value.ToString("MMM dd, yyyy")</small>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted small">—</span>
                                                                }
                                                            </td>

                                                            <!-- Total Working -->
                                                            <td class="text-center text-nowrap" style="min-width: 95px;">
                                                                <span class="total-working-badge px-2.5 py-1 shadow-2xs d-inline-flex align-items-center gap-1.5"
                                                                      style="font-size: 0.84rem;">
                                                                    <i class="bi bi-hourglass-split text-warning"></i>
                                                                    <span class="fw-extrabold font-monospace">@totalWorkingStr</span>
                                                                </span>
                                                            </td>

                                                            <!-- Actions -->
                                                            <td class="text-end text-nowrap" style="min-width: 90px;">
                                                                <div class="dropdown d-inline-block">
                                                                    <button class="btn-creative-action dropdown-toggle"
                                                                            type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport"
                                                                            aria-expanded="false" title="Task Actions Menu">
                                                                        <span>Actions</span>
                                                                        <i class="bi bi-chevron-down" style="font-size:0.65rem; opacity:0.75;"></i>
                                                                    </button>
                                                                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border border-secondary border-opacity-25 p-1 rounded-3"
                                                                        style="font-size: 0.84rem; min-width: 190px;">
                                                                        <li>
                                                                            <button type="button"
                                                                                    class="dropdown-item d-flex align-items-center gap-2 py-1.5 open-error-report-btn"
                                                                                    data-id="@item.Id" data-name="@item.TaskName"
                                                                                    data-delayreason="@item.DelayReason" data-errordetails="@item.ErrorDetails"
                                                                                    data-errorscreenshot="@item.ErrorScreenshotPath">
                                                                                <i class="bi bi-bug-fill text-warning fs-6"></i>
                                                                                <span>Report Issue / Delay</span>
                                                                            </button>
                                                                        </li>
                                                                        <li>
                                                                            <a asp-action="Details" asp-route-id="@item.Id"
                                                                               class="dropdown-item d-flex align-items-center gap-2 py-1.5">
                                                                                <i class="bi bi-info-circle-fill text-primary fs-6"></i>
                                                                                <span>View Task Details</span>
                                                                            </a>
                                                                        </li>
                                                                        @if (isCanAssign)
                                                                        {
                                                                            <li><hr class="dropdown-divider my-1"></li>
                                                                            <li>
                                                                                <a asp-action="Edit" asp-route-id="@item.Id"
                                                                                   class="dropdown-item d-flex align-items-center gap-2 py-1.5">
                                                                                    <i class="bi bi-pencil-square text-warning fs-6"></i>
                                                                                    <span>Edit Task</span>
                                                                                </a>
                                                                            </li>
                                                                            <li>
                                                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                                                                      onsubmit="return confirm('Are you sure you want to delete task \'@item.TaskName\'?');">
                                                                                    @Html.AntiForgeryToken()
                                                                                    <button type="submit"
                                                                                            class="dropdown-item d-flex align-items-center gap-2 py-1.5 text-danger">
                                                                                        <i class="bi bi-trash3-fill text-danger fs-6"></i>
                                                                                        <span>Delete Task</span>
                                                                                    </button>
                                                                                </form>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- Modern Pagination Bar for Table -->
                                        <div class="pagination-container d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3"
                                             id="taskPaginationBar">
                                            <div class="d-flex align-items-center gap-2 text-muted small">
                                                <span>Showing</span>
                                                <span class="fw-bold text-main" id="paginationInfoStart">1</span>
                                                <span>to</span>
                                                <span class="fw-bold text-main" id="paginationInfoEnd">10</span>
                                                <span>of</span>
                                                <span
                                                class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1 rounded-pill fw-bold font-monospace"
                                                id="paginationInfoTotal">@taskList.Count</span>
                                                <span>tasks</span>
                                            </div>

                                            <div class="d-flex align-items-center gap-3">
                                                <!-- Page Size Selector -->
                                                <div class="d-flex align-items-center gap-1.5 text-muted small">
                                                    <span class="d-none d-md-inline">Show:</span>
                                                    <select id="pageSizeSelect" class="form-select form-select-sm"
                                                            style="width: auto; min-width: 75px; font-weight: 600;">
                                                        <option value="10" selected>10</option>
                                                        <option value="20">20</option>
                                                        <option value="50">50</option>
                                                        <option value="100">100</option>
                                                    </select>
                                                </div>

                                                <!-- Page Navigation Buttons -->
                                                <nav aria-label="Task table pagination">
                                                    <ul class="pagination pagination-sm pagination-custom mb-0" id="taskPaginationNav">
                                                        <!-- Injected via JS -->
                                                    </ul>
                                                </nav>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 2. MOBILE CARD VIEW (Mobile Screens Only) -->
                                    <div id="taskGridView" class="d-block d-md-none mt-3">
                                        <div class="row g-3" id="taskGridCardsContainer">
                                            @{
                                                int cardNum = 1;
                                            }
                                            @foreach (var item in taskList)
                                            {
                                                var compNames = item.TaskCompanies != null && item.TaskCompanies.Any()
                                                    ? string.Join(", ", item.TaskCompanies.Select(c => c.Company?.Name))
                                                    : "";
                                                var empNames = item.TaskEmployees != null && item.TaskEmployees.Any()
                                                    ? string.Join(", ", item.TaskEmployees.Select(e => e.Employee?.Name))
                                                    : "";

                                                var priorityCss = item.Priority == CompanyTaskManagement.Models.TaskPriority.Urgent ? "priority-urgent" :
                                                                  item.Priority == CompanyTaskManagement.Models.TaskPriority.High ? "priority-high" :
                                                                  item.Priority == CompanyTaskManagement.Models.TaskPriority.Medium ? "priority-medium" : "priority-low";

                                                var isOverdue = item.Status != CompanyTaskManagement.Models.TaskStatus.Completed && ((item.EndDate.HasValue &&
                                        item.EndDate.Value <= DateTime.Now) || (item.DueDate.HasValue && (item.DueDate.Value <= DateTime.Now ||
                                        item.DueDate.Value.Date < DateTime.Today)) || !string.IsNullOrEmpty(item.DelayReason));
                                                var isToday = (item.StartDate.HasValue ? item.StartDate.Value.Date == DateTime.Today : item.CreatedAt.Date ==
                                        DateTime.Today);

                                                <div class="col-12 task-card-item" data-task-id="@item.Id" data-task-name="@item.TaskName"
                                                     data-task-desc="@item.Description" data-priority="@item.Priority" data-status="@item.Status"
                                                     data-progress="@item.Progress" data-duedate="@(item.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                                                     data-createddate="@item.CreatedAt.ToString("yyyy-MM-dd")" data-istoday="@(isToday ? "true" : "false")"
                                                     data-isoverdue="@(isOverdue ? "true" : "false")" data-companies="@compNames" data-employees="@empNames"
                                                     data-project="@(item.Project?.ProjectName ?? "")">

                                                    <div class="task-grid-card">
                                                        <div class="task-grid-header">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="row-number-badge font-monospace fw-bold">Sheet #@(cardNum++)</span>
                                                                <span class="priority-badge @priorityCss">@item.Priority</span>
                                                            </div>
                            
                                                            <select class="form-select form-select-sm quick-status-select js-quick-status"
                                                                    data-task-id="@item.Id" style="width: auto;">
                                                                <option value="ToDo" selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.ToDo)">
                                                                    To Do</option>
                                                                    <option value="InProgress"
                                                                            selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.InProgress)">In Progress
                                                                    </option>
                                                                    <option value="InReview"
                                                                            selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.InReview)">In Review
                                                                    </option>
                                                                    <option value="Completed"
                                                                            selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.Completed)">Completed
                                                                    </option>
                                                                </select>
                                                            </div>

                                                            <a asp-action="Details" asp-route-id="@item.Id" class="task-grid-title text-decoration-none">
                                                                @item.TaskName
                                                            </a>

                                                            @if (item.Project != null)
                                                            {
                                                                <div class="mb-2">
                                                                    <span class="project-badge-chip" title="@item.Project.ProjectName">
                                                                        <i class="bi bi-kanban"></i>
                                                                        <span>@item.Project.ProjectName</span>
                                                                    </span>
                                                                </div>
                                                            }

                                                            <p class="task-grid-desc">
                                                                @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                                                            </p>

                                                            <!-- Start & End Time Schedule & Total Working -->
                                                            <div class="mb-3 p-2.5 rounded-3 bg-secondary-subtle bg-opacity-25 border border-secondary border-opacity-10">
                                                                <div class="row g-2 text-center" style="font-size: 0.78rem;">
                                                                    <div class="col-4 border-end border-secondary border-opacity-15">
                                                                        <span class="d-block text-uppercase fw-bold text-muted" style="font-size: 0.65rem;">Start
                                                                            Time</span>
                                                                            <span class="fw-bold font-monospace text-success">@((item.StartDate ??
                                                                                                                item.CreatedAt).ToString("h:mm tt"))</span>
                                                                            </div>
                                                                            <div class="col-4 border-end border-secondary border-opacity-15">
                                                                                <span class="d-block text-uppercase fw-bold text-muted" style="font-size: 0.65rem;">End
                                                                                    Time</span>
                                                                                    <span class="fw-bold font-monospace @(isOverdue ? "text-danger" : "text-main")">@((item.EndDate
                                                                                                                        ?? item.DueDate)?.ToString("h:mm tt") ?? "—")</span>
                                                                                    </div>
                                                                                    <div class="col-4">
                                                                                        <span class="d-block text-uppercase fw-bold text-muted" style="font-size: 0.65rem;">Total
                                                                                            Working</span>
                                                                                            <span class="total-working-badge px-2 py-0.5" style="font-size: 0.76rem;">
                                                                                                @{
                                                                                                    var mStart = item.StartDate ?? item.CreatedAt;
                                                                                                    var mEnd = item.EndDate ?? item.DueDate;
                                                                                                    string mTotal = "—";
                                                                                                    if (mEnd.HasValue)
                                                                                                    {
                                                                                                        var msTime = mStart.TimeOfDay;
                                                                                                        var meTime = mEnd.Value.TimeOfDay;
                                                                                                        TimeSpan mDiff;
                                                                                                        if (mEnd.Value.Date == mStart.Date)
                                                                                                        {
                                                                                                            mDiff = mEnd.Value - mStart;
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            if (meTime >= msTime)
                                                                                                            {
                                                                                                                mDiff = meTime - msTime;
                                                                                                            }
                                                                                                            else
                                                                                                            {
                                                                                                                mDiff = (TimeSpan.FromHours(24) - msTime) + meTime;
                                                                                                            }
                                                                                                        }

                                                                                                        if (mDiff.TotalMinutes > 0)
                                                                                                        {
                                                                                                            mTotal = $"{(int)mDiff.TotalHours}:{mDiff.Minutes:D2}";
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            mTotal = "0:00";
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                                @mTotal
                                                                                            </span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>

                                                                                <!-- Companies Tags -->
                                                                                <div class="mb-2">
                                                                                    <small class="text-muted d-block mb-1 fw-bold"
                                                                                           style="font-size: 0.72rem; text-transform: uppercase;">Companies</small>
                                                                                    @if (item.TaskCompanies != null && item.TaskCompanies.Any())
                                                                                    {
                                                                                        <div class="d-flex flex-wrap gap-1">
                                                                                            @foreach (var company in item.TaskCompanies)
                                                                                            {
                                                                                                <span class="company-badge-chip">
                                                                                                    <i class="bi bi-buildings"></i>
                                                                                                    <span>@company.Company?.Name</span>
                                                                                                </span>
                                                                                            }
                                                                                        </div>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="empty-badge-pill">No companies</span>
                                                                                    }
                                                                                </div>

                                                                                <!-- Team Members Tags -->
                                                                                <div class="mb-3">
                                                                                    <small class="text-muted d-block mb-1 fw-bold"
                                                                                           style="font-size: 0.72rem; text-transform: uppercase;">Team Members</small>
                                                                                    @if (item.TaskEmployees != null && item.TaskEmployees.Any())
                                                                                    {
                                                                                        <div class="d-flex flex-wrap gap-1">
                                                                                            @foreach (var emp in item.TaskEmployees)
                                                                                            {
                                                                                                var initial = !string.IsNullOrEmpty(emp.Employee?.Name) ? emp.Employee.Name.Substring(0, 1) : "?";
                                                                                                var colorIdx = Math.Abs((emp.Employee?.Name ?? "").GetHashCode()) % 7;
                                                                                                <span class="employee-badge-chip">
                                                                                                    <span class="avatar-initial-circle avatar-color-@colorIdx">@initial</span>
                                                                                                    <span>@emp.Employee?.Name</span>
                                                                                                </span>
                                                                                            }
                                                                                        </div>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="empty-badge-pill">No team assigned</span>
                                                                                    }
                                                                                </div>

                                                                                <!-- Footer Actions -->
                                                                                <div class="task-grid-footer">
                                                                                    <span class="due-date-badge @(isOverdue ? "due-date-overdue" : "")">
                                                                                        <i class="bi bi-calendar-event"></i>
                                                                                        <span>@(item.DueDate.HasValue ? item.DueDate.Value.ToString("MMM dd") : "No Due Date")</span>
                                                                                    </span>

                                                                                    <div class="d-flex gap-1">
                                                                                        <button type="button" class="btn btn-sm btn-outline-warning open-error-report-btn"
                                                                                                title="Report Delay / Error Screenshot" data-id="@item.Id" data-name="@item.TaskName"
