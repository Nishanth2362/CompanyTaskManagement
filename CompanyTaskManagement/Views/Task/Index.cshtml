@model IEnumerable<CompanyTaskManagement.Models.TaskItem>
@inject CompanyTaskManagement.Services.IUserSessionService UserSession

@{
    ViewData["Title"] = "Tasks Dashboard";
    var taskList = Model?.ToList() ?? new List<CompanyTaskManagement.Models.TaskItem>();
    var totalTasks = taskList.Count;
    var inProgressCount = taskList.Count(t => t.Status == CompanyTaskManagement.Models.TaskStatus.InProgress);
    var completedCount = taskList.Count(t => t.Status == CompanyTaskManagement.Models.TaskStatus.Completed);
    var overdueUncompletedCount = taskList.Count(t => t.Status != CompanyTaskManagement.Models.TaskStatus.Completed && ((t.EndDate.HasValue && t.EndDate.Value <= DateTime.Now) || (t.DueDate.HasValue && (t.DueDate.Value <= DateTime.Now || t.DueDate.Value.Date < DateTime.Today)) || !string.IsNullOrEmpty(t.DelayReason)));
    var tasksWithErrorsCount = taskList.Count(t => !string.IsNullOrEmpty(t.ErrorScreenshotPath) || !string.IsNullOrEmpty(t.DelayReason) || !string.IsNullOrEmpty(t.ErrorDetails));
    var isCanAssign = UserSession.IsAdminOrHr();
    var isEmployee = UserSession.IsEmployee();
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<!-- Dashboard Header & Title -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h2 fw-bold mb-0">Task Dashboard</h1>
        </div>
        <p class="text-muted mb-0">Manage, organize, and monitor cross-company tasks, priorities, and team assignments.</p>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <!-- Notify HR Escalation Button -->
        <button type="button" class="btn btn-coral-gradient rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" id="openHrModalBtn" title="Notify HR of Overdue Tasks">
            <i class="bi bi-bell-fill text-white fs-6"></i>
            <span>Notify HR</span>
        </button>

        <!-- Unified Export Tasksheet Button -->
        <button type="button" class="btn btn-emerald rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#exportTasksheetModal" title="Export Tasksheet with Optional Date Range">
            <i class="bi bi-file-earmark-excel-fill text-white fs-6"></i>
            <span>Export Tasksheet</span>
        </button>

        @if (isCanAssign)
        {
            <!-- Create Task Button (Admin & HR Only) -->
            <a asp-action="Create" class="btn btn-royal-gold rounded-pill d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-lg text-white fs-6"></i>
                <span>Create Task</span>
            </a>
        }
    </div>
</div>

@if (isEmployee)
{
    <!-- Employee Persona Context Banner -->
    <div class="card border-0 shadow-sm mb-4 p-3 glass-card border-start border-4 border-info">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-info-subtle text-info rounded-circle" style="width: 42px; height: 42px;">
                    <i class="bi bi-person-badge-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">Logged in as Employee: <span class="text-primary">@UserSession.GetCurrentEmployeeName()</span></h6>
                    <small class="text-muted">You can view your assigned tasks and update status / report delays. Task creation and assignment is restricted to Admin & HR.</small>
                </div>
            </div>
            @if (ViewBag.MyTasksCount != null)
            {
                <span class="badge bg-primary rounded-pill px-3 py-2 font-monospace">@ViewBag.MyTasksCount Assigned Tasks</span>
            }
        </div>
    </div>
}

<!-- Success Notification Alert -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stat Metric Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            <div>
                <div class="stat-number text-gold" id="statTotalTasks">@totalTasks</div>
                <div class="stat-label">TOTAL TASKS</div>
            </div>
            <div class="stat-icon stat-icon-amber">
                <i class="bi bi-journal-check"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            <div>
                <div class="stat-number text-amethyst">@inProgressCount</div>
                <div class="stat-label">IN PROGRESS</div>
            </div>
            <div class="stat-icon stat-icon-amethyst">
                <i class="bi bi-calendar-event-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            <div>
                <div class="stat-number text-emerald">@completedCount</div>
                <div class="stat-label">COMPLETED</div>
            </div>
            <div class="stat-icon stat-icon-emerald">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            <div>
                <div class="stat-number text-coral">@tasksWithErrorsCount</div>
                <div class="stat-label">REPORTED ERRORS / DELAYS</div>
            </div>
            <div class="stat-icon stat-icon-coral">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- UNIFIED INSTANT FILTER COMMAND BAR -->
<div class="filter-toolbar-card mb-4" id="unifiedFilterBar">
    <!-- Top Row: Interactive Live Filter Tabs -->
    <div class="pb-3 border-bottom border-secondary border-opacity-15">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <span class="fw-bold small text-uppercase text-muted d-inline-flex align-items-center">
                <i class="bi bi-funnel-fill text-gold me-1.5"></i> TASK VIEW:
            </span>
            <div class="small text-muted font-monospace d-flex align-items-center gap-2 ms-auto ms-sm-0">
                <i class="bi bi-calendar3 text-primary"></i>
                <span>Today: <strong>@DateTime.Today.ToString("MMM dd, yyyy")</strong></span>
            </div>
        </div>

        <div class="unified-filter-tabs w-100" role="tablist" aria-label="Task Dashboard Instant Filters">
            <button type="button" class="filter-tab-btn @(currentFilter == "all" ? "active" : "")" data-filter="all" id="filterTabAll">
                <i class="bi bi-grid-fill"></i>
                <span>All Tasks</span>
                <span class="badge filter-badge" id="badgeCountAll">@ViewBag.AllCount</span>
            </button>
            <button type="button" class="filter-tab-btn @(currentFilter == "today" ? "active" : "")" data-filter="today" id="filterTabToday">
                <i class="bi bi-calendar-check"></i>
                <span>Today's Tasks</span>
                <span class="badge filter-badge" id="badgeCountToday">@ViewBag.TodayCount</span>
            </button>
            <button type="button" class="filter-tab-btn @(currentFilter == "inprogress" ? "active" : "")" data-filter="inprogress" id="filterTabInProgress">
                <i class="bi bi-clock-history"></i>
                <span>In Progress</span>
                <span class="badge filter-badge" id="badgeCountInProgress">@ViewBag.InProgressCount</span>
            </button>
            <button type="button" class="filter-tab-btn @(currentFilter == "overdue" || currentFilter == "incomplete" ? "active" : "")" data-filter="overdue" id="filterTabOverdue">
                <i class="bi bi-exclamation-circle"></i>
                <span>Overdue / Rolled Over</span>
                <span class="badge filter-badge" id="badgeCountOverdue">@ViewBag.OverdueCount</span>
            </button>
            <button type="button" class="filter-tab-btn @(currentFilter == "completed" ? "active" : "")" data-filter="completed" id="filterTabCompleted">
                <i class="bi bi-check2-circle"></i>
                <span>Completed</span>
                <span class="badge filter-badge" id="badgeCountCompleted">@ViewBag.CompletedCount</span>
            </button>
            <button type="button" class="filter-tab-btn @(currentFilter == "urgent" ? "active" : "")" data-filter="urgent" id="filterTabUrgent">
                <i class="bi bi-fire"></i>
                <span>High / Urgent</span>
                <span class="badge filter-badge" id="badgeCountUrgent">@ViewBag.UrgentCount</span>
            </button>
        </div>
    </div>

    <!-- Bottom Row: Search, Dropdowns, Reset & View Switcher -->
    <div class="row g-2 align-items-center pt-3">
        <!-- Live Instant Search -->
        <div class="col-12 col-md-4 col-lg-3">
            <div class="search-input-group">
                <i class="bi bi-search search-icon-inside"></i>
                <input type="text" id="taskSearchInput" class="form-control search-input" placeholder="Search tasks, descriptions, members..." autocomplete="off" />
                <button type="button" id="searchClearBtn" class="search-clear-btn" title="Clear search">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>
        </div>

        <!-- Filter by Company -->
        <div class="col-12 col-sm-6 col-md-2">
            <select id="companyFilterSelect" class="form-select filter-select">
                <option value="">All Companies</option>
            </select>
        </div>

        <!-- Filter by Employee / Assignee -->
        <div class="col-12 col-sm-6 col-md-2">
            <select id="employeeFilterSelect" class="form-select filter-select">
                <option value="">All Team Members</option>
            </select>
        </div>

        <!-- Filter by Priority -->
        <div class="col-5 col-sm-4 col-md-2 col-lg-1">
            <select id="priorityFilterSelect" class="form-select filter-select">
                <option value="">Priority</option>
                <option value="Urgent">Urgent</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>
        </div>

        <!-- Filter by Status -->
        <div class="col-5 col-sm-4 col-md-2 col-lg-1">
            <select id="statusFilterSelect" class="form-select filter-select">
                <option value="">Status</option>
                <option value="ToDo">To Do</option>
                <option value="InProgress">In Progress</option>
                <option value="InReview">In Review</option>
                <option value="Completed">Completed</option>
            </select>
        </div>

        <!-- Reset Filters Button -->
        <div class="col-2 col-sm-auto d-flex align-items-center justify-content-center">
            <button type="button" id="resetFilterBtn" class="btn btn-sm btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-1" style="height: 38px;" title="Reset all active filters">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span class="d-none d-lg-inline">Reset</span>
            </button>
        </div>
    </div>
</div>

@if (!taskList.Any())
{
    <!-- Empty State when no tasks exist -->
    <div class="table-card p-5 text-center">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 72px; height: 72px;">
            <i class="bi bi-clipboard-plus fs-1"></i>
        </div>
        <h4 class="fw-bold mb-1">No tasks created yet</h4>
        <p class="text-muted mb-4 max-w-sm mx-auto">Get started by creating your first company task and assigning team members.</p>
        <a asp-action="Create" class="btn btn-primary-gradient px-4">
            <i class="bi bi-plus-lg me-1"></i> Create First Task
        </a>
    </div>
}
else
{
    <!-- 1. TABLE VIEW (Desktop & Tablet) -->
    <div id="taskTableView" class="table-card d-none d-md-block">
        <div class="table-responsive">
            <table class="table table-custom" id="mainTaskTable">
                <thead>
                    <tr>
                        <th style="width: 50px; min-width: 46px; max-width: 55px;" class="text-center text-nowrap px-1">TASK #</th>
                        <th style="min-width: 130px;">TASK NAME</th>
                        <th style="min-width: 85px;">PROJECT</th>
                        <th style="min-width: 80px;" class="text-nowrap text-center">PRIORITY</th>
                        <th style="min-width: 100px;" class="text-nowrap text-center">STATUS</th>
                        <th style="min-width: 140px;">EMPLOYEES &amp; COMPANIES</th>
                        <th class="text-nowrap" style="min-width: 105px;">TASK START TIME</th>
                        <th class="text-nowrap" style="min-width: 105px;">TASK END TIME</th>
                        <th class="text-nowrap text-center" style="min-width: 95px;">TOTAL WORKING</th>
                        <th style="min-width: 80px;" class="text-end text-nowrap">ACTIONS</th>
                    </tr>
                </thead>
                <tbody id="taskTableBody">
                    @{ int rowNum = 1; }
                    @foreach (var item in taskList)
                    {
                        var compNames = item.TaskCompanies != null && item.TaskCompanies.Any() 
                            ? string.Join(", ", item.TaskCompanies.Select(c => c.Company?.Name)) 
                            : "";
                        var empNames = item.TaskEmployees != null && item.TaskEmployees.Any() 
                            ? string.Join(", ", item.TaskEmployees.Select(e => e.Employee?.Name)) 
                            : "";

                        var priorityCss = item.Priority == CompanyTaskManagement.Models.TaskPriority.Urgent ? "priority-urgent" :
                                          item.Priority == CompanyTaskManagement.Models.TaskPriority.High ? "priority-high" :
                                          item.Priority == CompanyTaskManagement.Models.TaskPriority.Medium ? "priority-medium" : "priority-low";

                        var isOverdue = item.Status != CompanyTaskManagement.Models.TaskStatus.Completed && ((item.EndDate.HasValue && item.EndDate.Value <= DateTime.Now) || (item.DueDate.HasValue && (item.DueDate.Value <= DateTime.Now || item.DueDate.Value.Date < DateTime.Today)) || !string.IsNullOrEmpty(item.DelayReason));
                        var isToday = (item.StartDate.HasValue ? item.StartDate.Value.Date == DateTime.Today : item.CreatedAt.Date == DateTime.Today);
                        var hasErrorLog = !string.IsNullOrEmpty(item.ErrorScreenshotPath) || !string.IsNullOrEmpty(item.DelayReason) || !string.IsNullOrEmpty(item.ErrorDetails);

                        var startTime = item.StartDate ?? item.CreatedAt;
                        var endTime = item.EndDate ?? item.DueDate;
                        string totalWorkingStr = "—";
                        if (endTime.HasValue)
                        {
                            var sTime = startTime.TimeOfDay;
                            var eTime = endTime.Value.TimeOfDay;
                            TimeSpan diff;
                            if (endTime.Value.Date == startTime.Date)
                            {
                                diff = endTime.Value - startTime;
                            }
                            else
                            {
                                if (eTime >= sTime)
                                {
                                    diff = eTime - sTime;
                                }
                                else
                                {
                                    diff = (TimeSpan.FromHours(24) - sTime) + eTime;
                                }
                            }

                            if (diff.TotalMinutes > 0)
                            {
                                int h = (int)diff.TotalHours;
                                int m = diff.Minutes;
                                totalWorkingStr = $"{h}:{m:D2}";
                            }
                            else
                            {
                                totalWorkingStr = "0:00";
                            }
                        }

                        <tr class="task-row-item align-middle" 
                            data-task-id="@item.Id"
                            data-task-name="@item.TaskName"
                            data-task-desc="@item.Description"
                            data-priority="@item.Priority"
                            data-status="@item.Status"
                            data-progress="@item.Progress"
                            data-duedate="@(item.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                            data-createddate="@item.CreatedAt.ToString("yyyy-MM-dd")"
                            data-istoday="@(isToday ? "true" : "false")"
                            data-isoverdue="@(isOverdue ? "true" : "false")"
                            data-delayreason="@item.DelayReason"
                            data-errordetails="@item.ErrorDetails"
                            data-errorscreenshot="@item.ErrorScreenshotPath"
                            data-companies="@compNames"
                            data-employees="@empNames"
                            data-project="@(item.Project?.ProjectName ?? "")">

                            <!-- Tasksheet Number with Row Number -->
                            <td class="text-center text-nowrap px-1" style="width: 50px; min-width: 46px;">
                                <span class="row-number-badge font-monospace">@(rowNum++)</span>
                            </td>

                            <!-- Task Name & Desc -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="task-title-link">
                                        @item.TaskName
                                    </a>
                                    @if (hasErrorLog)
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2" title="Error/Delay reported">
                                            <i class="bi bi-exclamation-circle-fill"></i> Issue
                                        </span>
                                    }
                                </div>
                                <div class="task-desc-truncate" title="@item.Description">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                </div>
                            </td>

                            <!-- Project -->
                            <td>
                                @if (item.Project != null)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1 text-truncate" style="max-width: 170px; display: inline-block; vertical-align: middle;" title="@item.Project.ProjectName">
                                        <i class="bi bi-briefcase-fill me-1"></i>@item.Project.ProjectName
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-muted rounded-pill px-2 py-0.5 small">General</span>
                                }
                            </td>

                            <!-- Priority -->
                            <td class="text-nowrap text-center" style="min-width: 120px;">
                                <span class="priority-badge @priorityCss">
                                    @if (item.Priority == CompanyTaskManagement.Models.TaskPriority.Urgent)
                                    {
                                        <i class="bi bi-fire text-danger me-1"></i>
                                    }
                                    else if (item.Priority == CompanyTaskManagement.Models.TaskPriority.High)
                                    {
                                        <i class="bi bi-star-fill text-warning me-1"></i>
                                    }
                                    <span>@item.Priority</span>
                                </span>
                            </td>

                            <!-- Status Selector -->
                            <td class="text-nowrap text-center" style="min-width: 100px;">
                                <select class="form-select form-select-sm quick-status-select js-quick-status d-inline-block" data-task-id="@item.Id">
                                    <option value="ToDo" selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.ToDo)">To Do</option>
                                    <option value="InProgress" selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.InProgress)">In Progress</option>
                                    <option value="InReview" selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.InReview)">In Review</option>
                                    <option value="Completed" selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.Completed)">Completed</option>
                                </select>
                            </td>

                            <!-- Combined Employees & Companies -->
                            <td style="min-width: 140px;">
                                <div class="d-flex flex-column gap-1.5">
                                    @if (item.TaskEmployees != null && item.TaskEmployees.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var emp in item.TaskEmployees)
                                            {
                                                var initial = !string.IsNullOrEmpty(emp.Employee?.Name) ? emp.Employee.Name.Substring(0, 1) : "?";
                                                var colorIdx = Math.Abs((emp.Employee?.Name ?? "").GetHashCode()) % 7;
                                                <span class="employee-badge-chip">
                                                    <span class="avatar-initial-circle avatar-color-@colorIdx">@initial</span>
                                                    <span>@emp.Employee?.Name</span>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="empty-badge-pill" style="font-size: 0.72rem;">
                                                <i class="bi bi-person-slash me-1 opacity-75"></i>No team assigned
                                            </span>
                                        </div>
                                    }

                                    @if (item.TaskCompanies != null && item.TaskCompanies.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var company in item.TaskCompanies)
                                            {
                                                <span class="company-badge-chip">
                                                    <i class="bi bi-buildings"></i>
                                                    <span>@company.Company?.Name</span>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>

                            <!-- Task Start Time -->
                            <td class="text-nowrap" style="min-width: 135px;">
                                <div class="d-flex align-items-center gap-1.5">
                                    <i class="bi bi-clock-fill text-success" style="font-size: 1.05rem;"></i>
                                    <span class="fw-bold font-monospace text-body" style="font-size: 0.88rem;">@startTime.ToString("h:mm tt")</span>
                                </div>
                                <small class="text-muted d-block" style="font-size: 0.72rem; padding-left: 1.45rem;">@startTime.ToString("MMM dd, yyyy")</small>
                            </td>

                            <!-- Task End Time -->
                            <td class="text-nowrap" style="min-width: 135px;">
                                @if (endTime.HasValue)
                                {
                                    <div class="d-flex align-items-center gap-1.5">
                                        <i class="bi bi-clock-fill @(isOverdue ? "text-danger" : "text-primary")" style="font-size: 1.05rem;"></i>
                                        <span class="fw-bold font-monospace @(isOverdue ? "text-danger" : "text-body")" style="font-size: 0.88rem;">@endTime.Value.ToString("h:mm tt")</span>
                                        @if (isOverdue)
                                        {
                                            <i class="bi bi-exclamation-circle-fill text-danger extra-small" title="Overdue"></i>
                                        }
                                    </div>
                                    <small class="text-muted d-block" style="font-size: 0.72rem; padding-left: 1.45rem;">@endTime.Value.ToString("MMM dd, yyyy")</small>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <!-- Total Working -->
                            <td class="text-center text-nowrap" style="min-width: 130px;">
                                <span class="total-working-badge px-3 py-1 shadow-2xs d-inline-flex align-items-center gap-1.5" style="font-size: 0.84rem;">
                                    <i class="bi bi-hourglass-split text-warning"></i>
                                    <span class="fw-extrabold font-monospace">⌛ @totalWorkingStr</span>
                                </span>
                            </td>

                            <!-- Actions -->
                            <td class="text-end text-nowrap" style="min-width: 90px;">
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm btn-creative-action dropdown-toggle d-inline-flex align-items-center gap-1 px-3 py-1.5 rounded-pill border shadow-2xs" 
                                            type="button" 
                                            data-bs-toggle="dropdown" 
                                            aria-expanded="false" 
                                            title="Task Actions Menu">
                                        <i class="bi bi-three-dots-vertical text-primary"></i>
                                        <span>Actions</span>
                                        <i class="bi bi-chevron-down small opacity-75"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border border-secondary border-opacity-25 p-1 rounded-3" style="font-size: 0.84rem; min-width: 190px;">
                                        <li>
                                            <button type="button" 
                                                    class="dropdown-item d-flex align-items-center gap-2 py-1.5 open-error-report-btn" 
                                                    data-id="@item.Id"
                                                    data-name="@item.TaskName"
                                                    data-delayreason="@item.DelayReason"
                                                    data-errordetails="@item.ErrorDetails"
                                                    data-errorscreenshot="@item.ErrorScreenshotPath">
                                                <i class="bi bi-bug-fill text-warning fs-6"></i>
                                                <span>Report Issue / Delay</span>
                                            </button>
                                        </li>
                                        <li>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="dropdown-item d-flex align-items-center gap-2 py-1.5">
                                                <i class="bi bi-info-circle-fill text-primary fs-6"></i>
                                                <span>View Task Details</span>
                                            </a>
                                        </li>
                                        @if (isCanAssign)
                                        {
                                            <li><hr class="dropdown-divider my-1"></li>
                                            <li>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item d-flex align-items-center gap-2 py-1.5">
                                                    <i class="bi bi-pencil-square text-warning fs-6"></i>
                                                    <span>Edit Task</span>
                                                </a>
                                            </li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete task \'@item.TaskName\'?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-1.5 text-danger">
                                                        <i class="bi bi-trash3-fill text-danger fs-6"></i>
                                                        <span>Delete Task</span>
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Modern Pagination Bar for Table -->
        <div class="pagination-container d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3" id="taskPaginationBar">
            <div class="d-flex align-items-center gap-2 text-muted small">
                <span>Showing</span>
                <span class="fw-bold text-main" id="paginationInfoStart">1</span>
                <span>to</span>
                <span class="fw-bold text-main" id="paginationInfoEnd">10</span>
                <span>of</span>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1 rounded-pill fw-bold font-monospace" id="paginationInfoTotal">@taskList.Count</span>
                <span>tasks</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- Page Size Selector -->
                <div class="d-flex align-items-center gap-1.5 text-muted small">
                    <span class="d-none d-md-inline">Show:</span>
                    <select id="pageSizeSelect" class="form-select form-select-sm" style="width: auto; min-width: 75px; font-weight: 600;">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>

                <!-- Page Navigation Buttons -->
                <nav aria-label="Task table pagination">
                    <ul class="pagination pagination-sm pagination-custom mb-0" id="taskPaginationNav">
                        <!-- Injected via JS -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- 2. MOBILE CARD VIEW (Mobile Screens Only) -->
    <div id="taskGridView" class="d-block d-md-none mt-3">
        <div class="row g-3" id="taskGridCardsContainer">
            @{ int cardNum = 1; }
            @foreach (var item in taskList)
            {
                var compNames = item.TaskCompanies != null && item.TaskCompanies.Any() 
                    ? string.Join(", ", item.TaskCompanies.Select(c => c.Company?.Name)) 
                    : "";
                var empNames = item.TaskEmployees != null && item.TaskEmployees.Any() 
                    ? string.Join(", ", item.TaskEmployees.Select(e => e.Employee?.Name)) 
                    : "";

                var priorityCss = item.Priority == CompanyTaskManagement.Models.TaskPriority.Urgent ? "priority-urgent" :
                                  item.Priority == CompanyTaskManagement.Models.TaskPriority.High ? "priority-high" :
                                  item.Priority == CompanyTaskManagement.Models.TaskPriority.Medium ? "priority-medium" : "priority-low";

                var isOverdue = item.Status != CompanyTaskManagement.Models.TaskStatus.Completed && ((item.EndDate.HasValue && item.EndDate.Value <= DateTime.Now) || (item.DueDate.HasValue && (item.DueDate.Value <= DateTime.Now || item.DueDate.Value.Date < DateTime.Today)) || !string.IsNullOrEmpty(item.DelayReason));
                var isToday = (item.StartDate.HasValue ? item.StartDate.Value.Date == DateTime.Today : item.CreatedAt.Date == DateTime.Today);

                <div class="col-12 task-card-item"
                     data-task-id="@item.Id"
                     data-task-name="@item.TaskName"
                     data-task-desc="@item.Description"
                     data-priority="@item.Priority"
                     data-status="@item.Status"
                     data-progress="@item.Progress"
                     data-duedate="@(item.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                     data-createddate="@item.CreatedAt.ToString("yyyy-MM-dd")"
                     data-istoday="@(isToday ? "true" : "false")"
                     data-isoverdue="@(isOverdue ? "true" : "false")"
                     data-companies="@compNames"
                     data-employees="@empNames"
                     data-project="@(item.Project?.ProjectName ?? "")">

                    <div class="task-grid-card">
                        <div class="task-grid-header">
                            <div class="d-flex align-items-center gap-2">
                                <span class="row-number-badge font-monospace fw-bold">Sheet #@(cardNum++)</span>
                                <span class="priority-badge @priorityCss">@item.Priority</span>
                            </div>
                            
                            <select class="form-select form-select-sm quick-status-select js-quick-status" data-task-id="@item.Id" style="width: auto;">
                                <option value="ToDo" selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.ToDo)">To Do</option>
                                <option value="InProgress" selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.InProgress)">In Progress</option>
                                <option value="InReview" selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.InReview)">In Review</option>
                                <option value="Completed" selected="@(item.Status == CompanyTaskManagement.Models.TaskStatus.Completed)">Completed</option>
                            </select>
                        </div>

                        <a asp-action="Details" asp-route-id="@item.Id" class="task-grid-title text-decoration-none">
                            @item.TaskName
                        </a>

                        @if (item.Project != null)
                        {
                            <div class="mb-2">
                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1 small">
                                    <i class="bi bi-kanban me-1"></i>@item.Project.ProjectName
                                </span>
                            </div>
                        }

                        <p class="task-grid-desc">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                        </p>

                        <!-- Start & End Time Schedule & Total Working -->
                        <div class="mb-3 p-2.5 rounded-3 bg-secondary-subtle bg-opacity-25 border border-secondary border-opacity-10">
                            <div class="row g-2 text-center" style="font-size: 0.78rem;">
                                <div class="col-4 border-end border-secondary border-opacity-15">
                                    <span class="d-block text-uppercase fw-bold text-muted" style="font-size: 0.65rem;">Start Time</span>
                                    <span class="fw-bold font-monospace text-success">@((item.StartDate ?? item.CreatedAt).ToString("h:mm tt"))</span>
                                </div>
                                <div class="col-4 border-end border-secondary border-opacity-15">
                                    <span class="d-block text-uppercase fw-bold text-muted" style="font-size: 0.65rem;">End Time</span>
                                    <span class="fw-bold font-monospace @(isOverdue ? "text-danger" : "text-main")">@((item.EndDate ?? item.DueDate)?.ToString("h:mm tt") ?? "—")</span>
                                </div>
                                <div class="col-4">
                                    <span class="d-block text-uppercase fw-bold text-muted" style="font-size: 0.65rem;">Total Working</span>
                                    <span class="total-working-badge px-2 py-0.5" style="font-size: 0.76rem;">
                                        @{
                                            var mStart = item.StartDate ?? item.CreatedAt;
                                            var mEnd = item.EndDate ?? item.DueDate;
                                            string mTotal = "—";
                                            if (mEnd.HasValue)
                                            {
                                                var msTime = mStart.TimeOfDay;
                                                var meTime = mEnd.Value.TimeOfDay;
                                                TimeSpan mDiff;
                                                if (mEnd.Value.Date == mStart.Date)
                                                {
                                                    mDiff = mEnd.Value - mStart;
                                                }
                                                else
                                                {
                                                    if (meTime >= msTime)
                                                    {
                                                        mDiff = meTime - msTime;
                                                    }
                                                    else
                                                    {
                                                        mDiff = (TimeSpan.FromHours(24) - msTime) + meTime;
                                                    }
                                                }

                                                if (mDiff.TotalMinutes > 0)
                                                {
                                                    mTotal = $"{(int)mDiff.TotalHours}:{mDiff.Minutes:D2}";
                                                }
                                                else
                                                {
                                                    mTotal = "0:00";
                                                }
                                            }
                                        }
                                        @mTotal
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Companies Tags -->
                        <div class="mb-2">
                            <small class="text-muted d-block mb-1 fw-bold" style="font-size: 0.72rem; text-transform: uppercase;">Companies</small>
                            @if (item.TaskCompanies != null && item.TaskCompanies.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var company in item.TaskCompanies)
                                    {
                                        <span class="company-badge-chip">
                                            <i class="bi bi-buildings"></i>
                                            <span>@company.Company?.Name</span>
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="empty-badge-pill">No companies</span>
                            }
                        </div>

                        <!-- Team Members Tags -->
                        <div class="mb-3">
                            <small class="text-muted d-block mb-1 fw-bold" style="font-size: 0.72rem; text-transform: uppercase;">Team Members</small>
                            @if (item.TaskEmployees != null && item.TaskEmployees.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var emp in item.TaskEmployees)
                                    {
                                        var initial = !string.IsNullOrEmpty(emp.Employee?.Name) ? emp.Employee.Name.Substring(0, 1) : "?";
                                        var colorIdx = Math.Abs((emp.Employee?.Name ?? "").GetHashCode()) % 7;
                                        <span class="employee-badge-chip">
                                            <span class="avatar-initial-circle avatar-color-@colorIdx">@initial</span>
                                            <span>@emp.Employee?.Name</span>
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="empty-badge-pill">No team assigned</span>
                            }
                        </div>

                        <!-- Footer Actions -->
                        <div class="task-grid-footer">
                            <span class="due-date-badge @(isOverdue ? "due-date-overdue" : "")">
                                <i class="bi bi-calendar-event"></i>
                                <span>@(item.DueDate.HasValue ? item.DueDate.Value.ToString("MMM dd") : "No Due Date")</span>
                            </span>

                            <div class="d-flex gap-1">
                                <button type="button" 
                                        class="btn btn-sm btn-outline-warning open-error-report-btn" 
                                        title="Report Delay / Error Screenshot"
                                        data-id="@item.Id"
                                        data-name="@item.TaskName"
                                        data-delayreason="@item.DelayReason"
                                        data-errordetails="@item.ErrorDetails"
                                        data-errorscreenshot="@item.ErrorScreenshotPath">
                                    <i class="bi bi-bug-fill"></i>
                                </button>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                    <i class="bi bi-arrow-right"></i>
                                </a>

                                @if (isCanAssign)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit Task">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Mobile Card View Pagination -->
        <div class="pagination-container d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3 mt-3 rounded-3" id="taskMobilePaginationBar">
            <div class="d-flex align-items-center gap-2 text-muted small">
                <span>Showing</span>
                <span class="fw-bold text-main" id="mobilePaginationInfoStart">1</span>
                <span>to</span>
                <span class="fw-bold text-main" id="mobilePaginationInfoEnd">10</span>
                <span>of</span>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1 rounded-pill fw-bold font-monospace" id="mobilePaginationInfoTotal">@taskList.Count</span>
                <span>tasks</span>
            </div>

            <nav aria-label="Task card pagination">
                <ul class="pagination pagination-sm pagination-custom mb-0" id="taskMobilePaginationNav">
                    <!-- Injected via JS -->
                </ul>
            </nav>
        </div>
    </div>

    <!-- No Search Results Alert Container -->
    <div id="noSearchResultsAlert" class="table-card p-5 text-center d-none mt-3">
        <div class="d-inline-flex align-items-center justify-content-center bg-secondary-subtle text-secondary rounded-circle mb-3" style="width: 60px; height: 60px;">
            <i class="bi bi-search fs-3"></i>
        </div>
        <h5 class="fw-bold mb-1">No matching tasks found</h5>
        <p class="text-muted mb-3">Try adjusting your search terms or clearing the active filters.</p>
        <button type="button" class="btn btn-sm btn-outline-primary" id="resetFilterBtn">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
        </button>
    </div>
}

<!-- Quick View Task Modal -->
