                                                                                    @section Scripts {
                                                                                        <script>
                                                                                            $(document.body).ready(function () {
                                                                                                let activeTaskModalId = null;

                                                                                                // Clear Dates button in Export Tasksheet Modal
                                                                                                $('#clearExportDatesBtn').on('click', function () {
                                                                                                    $('#exportStartDate').val('');
                                                                                                    $('#exportEndDate').val('');
                                                                                                });

                                                                                                // Populate Company & Employee filter dropdowns dynamically
                                                                                                const companiesSet = new Set();
                                                                                                const employeesSet = new Set();

                                                                                                $('.task-row-item, .task-card-item').each(function () {
                                                                                                    const comps = $(this).data('companies');
                                                                                                    const emps = $(this).data('employees');

                                                                                                    if (comps) {
                                                                                                        comps.split(',').forEach(c => {
                                                                                                            const trimmed = c.trim();
                                                                                                            if (trimmed) companiesSet.add(trimmed);
                                                                                                        });
                                                                                                    }
                                                                                                    if (emps) {
                                                                                                        emps.split(',').forEach(e => {
                                                                                                            const trimmed = e.trim();
                                                                                                            if (trimmed) employeesSet.add(trimmed);
                                                                                                        });
                                                                                                    }
                                                                                                });

                                                                                                Array.from(companiesSet).sort().forEach(c => {
                                                                                                    $('#companyFilterSelect').append(new Option(c, c));
                                                                                                });

                                                                                                Array.from(employeesSet).sort().forEach(e => {
                                                                                                    $('#employeeFilterSelect').append(new Option(e, e));
                                                                                                });

                                                                                                // ----------------------------------------------------
                                                                                                // View Mode Switcher (Table vs Grid vs Kanban)
                                                                                                // ----------------------------------------------------
                                                                                                $('#tableViewBtn').on('click', function () {
                                                                                                    $('.view-toggle-btn-group .btn').removeClass('active');
                                                                                                    $(this).addClass('active');
                                                                                                    $('#taskTableView').removeClass('d-none');
                                                                                                    $('#taskGridView, #taskKanbanView').addClass('d-none');
                                                                                                    filterTasks();
                                                                                                });

                                                                                                $('#gridViewBtn').on('click', function () {
                                                                                                    $('.view-toggle-btn-group .btn').removeClass('active');
                                                                                                    $(this).addClass('active');
                                                                                                    $('#taskGridView').removeClass('d-none');
                                                                                                    $('#taskTableView, #taskKanbanView').addClass('d-none');
                                                                                                    filterTasks();
                                                                                                });

                                                                                                $('#kanbanViewBtn').on('click', function () {
                                                                                                    $('.view-toggle-btn-group .btn').removeClass('active');
                                                                                                    $(this).addClass('active');
                                                                                                    $('#taskKanbanView').removeClass('d-none');
                                                                                                    $('#taskTableView, #taskGridView').addClass('d-none');
                                                                                                    filterTasks();
                                                                                                });

                                                                                                // ----------------------------------------------------
                                                                                                // Filter & Pagination Engine (10 items per page)
                                                                                                // ----------------------------------------------------
                                                                                                let currentPage = 1;
                                                                                                let pageSize = 10;

                                                                                                function filterTasks(resetPage = false) {
                                                                                                    if (resetPage) {
                                                                                                        currentPage = 1;
                                                                                                    }

                                                                                                    const tabFilter = ($('.unified-filter-tabs .filter-tab-btn.active').data('filter') || 'all').toString().toLowerCase();
                                                                                                    const searchTerm = $('#taskSearchInput').val().toLowerCase().trim();
                                                                                                    const companyFilter = $('#companyFilterSelect').val().toLowerCase();
                                                                                                    const employeeFilter = $('#employeeFilterSelect').val().toLowerCase();
                                                                                                    const priorityFilter = $('#priorityFilterSelect').val().toLowerCase();
                                                                                                    const statusFilter = $('#statusFilterSelect').val().toLowerCase();

                                                                                                    const matchedRowElements = [];
                                                                                                    const matchedCardElements = [];

                                                                                                    $('.task-row-item').each(function () {
                                                                                                        const name = ($(this).data('task-name') || '').toString().toLowerCase();
                                                                                                        const desc = ($(this).data('task-desc') || '').toString().toLowerCase();
                                                                                                        const priority = ($(this).data('priority') || '').toString().toLowerCase();
                                                                                                        const status = ($(this).data('status') || '').toString().toLowerCase();
                                                                                                        const companies = ($(this).data('companies') || '').toString().toLowerCase();
                                                                                                        const employees = ($(this).data('employees') || '').toString().toLowerCase();
                                                                                                        const isToday = String($(this).data('istoday')) === 'true';
                                                                                                        const isOverdue = String($(this).data('isoverdue')) === 'true';

                                                                                                        let matchesTab = true;
                                                                                                        if (tabFilter === 'today') {
                                                                                                            matchesTab = isToday;
                                                                                                        } else if (tabFilter === 'inprogress') {
                                                                                                            matchesTab = (status === 'inprogress');
                                                                                                        } else if (tabFilter === 'overdue' || tabFilter === 'incomplete') {
                                                                                                            matchesTab = isOverdue;
                                                                                                        } else if (tabFilter === 'completed') {
                                                                                                            matchesTab = (status === 'completed');
                                                                                                        } else if (tabFilter === 'urgent') {
                                                                                                            matchesTab = (priority === 'urgent' || priority === 'high');
                                                                                                        }

                                                                                                        const matchesSearch = !searchTerm || name.includes(searchTerm) || desc.includes(searchTerm) || companies.includes(searchTerm) || employees.includes(searchTerm);
                                                                                                        const matchesCompany = !companyFilter || companies.includes(companyFilter);
                                                                                                        const matchesEmployee = !employeeFilter || employees.includes(employeeFilter);
                                                                                                        const matchesPriority = !priorityFilter || priority === priorityFilter;
                                                                                                        const matchesStatus = !statusFilter || status === statusFilter;

                                                                                                        if (matchesSearch && matchesCompany && matchesEmployee && matchesPriority && matchesStatus && matchesTab) {
                                                                                                            matchedRowElements.push(this);
                                                                                                        } else {
                                                                                                            $(this).addClass('d-none');
                                                                                                        }
                                                                                                    });

                                                                                                    $('.task-card-item').each(function () {
                                                                                                        const name = ($(this).data('task-name') || '').toString().toLowerCase();
                                                                                                        const desc = ($(this).data('task-desc') || '').toString().toLowerCase();
                                                                                                        const priority = ($(this).data('priority') || '').toString().toLowerCase();
                                                                                                        const status = ($(this).data('status') || '').toString().toLowerCase();
                                                                                                        const companies = ($(this).data('companies') || '').toString().toLowerCase();
                                                                                                        const employees = ($(this).data('employees') || '').toString().toLowerCase();
                                                                                                        const isToday = String($(this).data('istoday')) === 'true';
                                                                                                        const isOverdue = String($(this).data('isoverdue')) === 'true';

                                                                                                        let matchesTab = true;
                                                                                                        if (tabFilter === 'today') {
                                                                                                            matchesTab = isToday;
                                                                                                        } else if (tabFilter === 'inprogress') {
                                                                                                            matchesTab = (status === 'inprogress');
                                                                                                        } else if (tabFilter === 'overdue' || tabFilter === 'incomplete') {
                                                                                                            matchesTab = isOverdue;
                                                                                                        } else if (tabFilter === 'completed') {
                                                                                                            matchesTab = (status === 'completed');
                                                                                                        } else if (tabFilter === 'urgent') {
                                                                                                            matchesTab = (priority === 'urgent' || priority === 'high');
                                                                                                        }

                                                                                                        const matchesSearch = !searchTerm || name.includes(searchTerm) || desc.includes(searchTerm) || companies.includes(searchTerm) || employees.includes(searchTerm);
                                                                                                        const matchesCompany = !companyFilter || companies.includes(companyFilter);
                                                                                                        const matchesEmployee = !employeeFilter || employees.includes(employeeFilter);
                                                                                                        const matchesPriority = !priorityFilter || priority === priorityFilter;
                                                                                                        const matchesStatus = !statusFilter || status === statusFilter;

                                                                                                        if (matchesSearch && matchesCompany && matchesEmployee && matchesPriority && matchesStatus && matchesTab) {
                                                                                                            matchedCardElements.push(this);
                                                                                                        } else {
                                                                                                            $(this).addClass('d-none');
                                                                                                        }
                                                                                                    });

                                                                                                    const totalMatched = matchedRowElements.length;
                                                                                                    const totalPages = Math.ceil(totalMatched / pageSize) || 1;

                                                                                                    if (currentPage > totalPages) {
                                                                                                        currentPage = totalPages;
                                                                                                    }
                                                                                                    if (currentPage < 1) {
                                                                                                        currentPage = 1;
                                                                                                    }

                                                                                                    const startIndex = (currentPage - 1) * pageSize;
                                                                                                    const endIndex = Math.min(startIndex + pageSize, totalMatched);

                                                                                                    // Paginate Table Rows
                                                                                                    matchedRowElements.forEach((el, index) => {
                                                                                                        if (index >= startIndex && index < endIndex) {
                                                                                                            $(el).removeClass('d-none');
                                                                                                        } else {
                                                                                                            $(el).addClass('d-none');
                                                                                                        }
                                                                                                    });

                                                                                                    // Paginate Mobile Card Items
                                                                                                    matchedCardElements.forEach((el, index) => {
                                                                                                        if (index >= startIndex && index < endIndex) {
                                                                                                            $(el).removeClass('d-none');
                                                                                                        } else {
                                                                                                            $(el).addClass('d-none');
                                                                                                        }
                                                                                                    });

                                                                                                    // Update Pagination Info Bar
                                                                                                    if (totalMatched === 0) {
                                                                                                        $('#paginationInfoStart, #mobilePaginationInfoStart').text(0);
                                                                                                        $('#paginationInfoEnd, #mobilePaginationInfoEnd').text(0);
                                                                                                        $('#paginationInfoTotal, #mobilePaginationInfoTotal').text(0);
                                                                                                        $('#taskPaginationBar, #taskMobilePaginationBar').addClass('d-none');
                                                                                                        $('#noSearchResultsAlert').removeClass('d-none');
                                                                                                    } else {
                                                                                                        $('#paginationInfoStart, #mobilePaginationInfoStart').text(startIndex + 1);
                                                                                                        $('#paginationInfoEnd, #mobilePaginationInfoEnd').text(endIndex);
                                                                                                        $('#paginationInfoTotal, #mobilePaginationInfoTotal').text(totalMatched);
                                                                                                        $('#taskPaginationBar, #taskMobilePaginationBar').removeClass('d-none');
                                                                                                        $('#noSearchResultsAlert').addClass('d-none');
                                                                                                    }

                                                                                                    renderPaginationControls(totalPages);

                                                                                                    if (searchTerm || companyFilter || employeeFilter || priorityFilter || statusFilter || tabFilter !== 'all') {
                                                                                                        $('#searchClearBtn').show();
                                                                                                    } else {
                                                                                                        $('#searchClearBtn').hide();
                                                                                                    }
                                                                                                }

                                                                                                function renderPaginationControls(totalPages) {
                                                                                                    const nav = $('#taskPaginationNav').empty();
                                                                                                    const mobileNav = $('#taskMobilePaginationNav').empty();

                                                                                                    if (totalPages <= 1) {
                                                                                                        return;
                                                                                                    }

                                                                                                    function buildButtons(targetNav) {
                                                                                                        // Prev Button
                                                                                                        targetNav.append(`
                                                                                                                <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                                                                                                                    <button class="page-link" data-page="${currentPage - 1}" aria-label="Previous">
                                                                                                                        <i class="bi bi-chevron-left"></i>
                                                                                                                    </button>
                                                                                                                </li>
                                                                                                            `);

                                                                                                        // Page Numbers
                                                                                                        let startPage = Math.max(1, currentPage - 2);
                                                                                                        let endPage = Math.min(totalPages, currentPage + 2);

                                                                                                        if (startPage > 1) {
                                                                                                            targetNav.append(`<li class="page-item"><button class="page-link" data-page="1">1</button></li>`);
                                                                                                            if (startPage > 2) {
                                                                                                                targetNav.append(`<li class="page-item disabled"><span class="page-link">…</span></li>`);
                                                                                                            }
                                                                                                        }

                                                                                                        for (let p = startPage; p <= endPage; p++) {
                                                                                                            targetNav.append(`
                                                                                                                    <li class="page-item ${p === currentPage ? 'active' : ''}">
                                                                                                                        <button class="page-link" data-page="${p}">${p}</button>
                                                                                                                    </li>
                                                                                                                `);
                                                                                                        }

                                                                                                        if (endPage < totalPages) {
                                                                                                            if (endPage < totalPages - 1) {
                                                                                                                targetNav.append(`<li class="page-item disabled"><span class="page-link">…</span></li>`);
                                                                                                            }
                                                                                                            targetNav.append(`<li class="page-item"><button class="page-link" data-page="${totalPages}">${totalPages}</button></li>`);
                                                                                                        }

                                                                                                        // Next Button
                                                                                                        targetNav.append(`
                                                                                                                <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                                                                                                                    <button class="page-link" data-page="${currentPage + 1}" aria-label="Next">
                                                                                                                        <i class="bi bi-chevron-right"></i>
                                                                                                                    </button>
                                                                                                                </li>
                                                                                                            `);
                                                                                                    }

                                                                                                    buildButtons(nav);
                                                                                                    buildButtons(mobileNav);
                                                                                                }

