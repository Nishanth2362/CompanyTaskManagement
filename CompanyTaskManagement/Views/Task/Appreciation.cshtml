@model CompanyTaskManagement.View_Model.WeeklyAppreciationPageViewModel
@{
    ViewData["Title"] = "Wall of Fame & Executive Appreciation";
}

<!-- Custom Scoped Styles for Wall of Fame -->
<style>
    /* Hero Banner */
    .fame-hero {
        background: linear-gradient(135deg, #0c4a6e 0%, #0369a1 45%, #0284c7 100%);
        border: 1.5px solid rgba(14, 165, 233, 0.35);
        border-left: 6px solid #f59e0b;
        border-radius: var(--radius-xl);
        position: relative;
        overflow: hidden;
        box-shadow: 0 16px 36px -4px rgba(14, 165, 233, 0.25);
    }
    .fame-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -60px;
        width: 340px;
        height: 340px;
        background: radial-gradient(circle, rgba(251, 191, 36, 0.25) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .fame-hero::after {
        content: '';
        position: absolute;
        bottom: -40px;
        left: 20%;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.25) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    /* Podium & Contributor Card Styles */
    .podium-card {
        background: #ffffff;
        border: 1.5px solid rgba(14, 165, 233, 0.22);
        border-radius: var(--radius-xl);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    [data-bs-theme="dark"] .podium-card {
        background: var(--bg-surface-glass);
        border-color: var(--border-subtle);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.35);
    }
    .podium-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 35px -8px rgba(14, 165, 233, 0.18);
        border-color: #0ea5e9;
    }
    .podium-card-rank-1 {
        border: 2px solid #f59e0b !important;
        background: linear-gradient(180deg, rgba(254, 243, 199, 0.5) 0%, #ffffff 60%) !important;
        box-shadow: 0 12px 28px -6px rgba(245, 158, 11, 0.2) !important;
    }
    .podium-card-rank-2 {
        border: 2px solid #0ea5e9 !important;
        background: linear-gradient(180deg, rgba(224, 242, 254, 0.5) 0%, #ffffff 60%) !important;
        box-shadow: 0 12px 28px -6px rgba(14, 165, 233, 0.2) !important;
    }
    .podium-card-rank-3 {
        border: 2px solid #ea580c !important;
        background: linear-gradient(180deg, rgba(254, 215, 170, 0.45) 0%, #ffffff 60%) !important;
        box-shadow: 0 12px 28px -6px rgba(234, 88, 12, 0.18) !important;
    }

    [data-bs-theme="dark"] .podium-card-rank-1 {
        border: 2px solid #fbbf24 !important;
        background: linear-gradient(180deg, rgba(251, 191, 36, 0.18) 0%, #0f172a 100%) !important;
        box-shadow: 0 12px 28px -6px rgba(251, 191, 36, 0.25) !important;
    }
    [data-bs-theme="dark"] .podium-card-rank-2 {
        border: 2px solid #38bdf8 !important;
        background: linear-gradient(180deg, rgba(56, 189, 248, 0.18) 0%, #0f172a 100%) !important;
        box-shadow: 0 12px 28px -6px rgba(56, 189, 248, 0.25) !important;
    }
    [data-bs-theme="dark"] .podium-card-rank-3 {
        border: 2px solid #f97316 !important;
        background: linear-gradient(180deg, rgba(249, 115, 22, 0.15) 0%, #0f172a 100%) !important;
        box-shadow: 0 12px 28px -6px rgba(249, 115, 22, 0.2) !important;
    }

    [data-bs-theme="dark"] .quote-affirmation-card {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.1) 0%, rgba(15, 23, 42, 0.8) 100%) !important;
        border-color: rgba(251, 191, 36, 0.25) !important;
    }
    [data-bs-theme="dark"] .quote-affirmation-card p {
        color: #f8fafc !important;
    }

    /* Halo Avatar */
    .avatar-halo {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 800;
        box-shadow: 0 4px 10px rgba(14, 165, 233, 0.2);
    }
    .avatar-halo-gold {
        background: linear-gradient(135deg, #fbbf24, #f59e0b, #d97706);
        color: #0f172a;
        border: 3px solid #fef08a;
    }
    .avatar-halo-silver {
        background: linear-gradient(135deg, #38bdf8, #0ea5e9, #0284c7);
        color: #ffffff;
        border: 3px solid #bae6fd;
    }
    .avatar-halo-bronze {
        background: linear-gradient(135deg, #fb923c, #ea580c, #c2410c);
        color: #ffffff;
        border: 3px solid #fed7aa;
    }
    .avatar-halo-emerald {
        background: linear-gradient(135deg, #34d399, #10b981, #059669);
        color: #ffffff;
        border: 3px solid #a7f3d0;
    }
    .avatar-halo-standard {
        background: linear-gradient(135deg, #818cf8, #6366f1, #4f46e5);
        color: #ffffff;
        border: 2px solid rgba(129, 140, 248, 0.4);
    }

    /* Executive Certificate Card Styling */
    .certificate-frame {
        background: #ffffff;
        color: #0f172a;
        border: 1px solid #cbd5e1 !important;
        border-radius: 24px !important;
        position: relative;
        overflow: hidden;
        box-shadow: 0 16px 36px -4px rgba(15, 23, 42, 0.1), 0 6px 12px -2px rgba(0, 0, 0, 0.03);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    [data-bs-theme="dark"] .certificate-frame {
        background: #0f172a;
        color: #f8fafc;
        border: 1px solid #334155 !important;
        box-shadow: 0 20px 45px -8px rgba(0, 0, 0, 0.5);
    }
    .certificate-header-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 55%, #1e1b4b 100%);
        color: #ffffff;
        padding: 1.5rem 2rem;
        border-bottom: 3.5px solid #f59e0b;
    }
    .quality-index-card {
        background: #ffffff;
        border: 2px solid #2563eb;
        box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.15);
    }
    [data-bs-theme="dark"] .quality-index-card {
        background: #1e293b;
        border-color: #60a5fa;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
    }

    /* Daily Wisdom & Inspiration Card */
    .inspiration-banner {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 20px;
        box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.05);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    [data-bs-theme="dark"] .inspiration-banner {
        background: #0f172a;
        border-color: #334155;
        box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.3);
    }

    .wisdom-quote-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 4px solid #f59e0b !important;
        border-radius: 16px;
        padding: 1.2rem;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    [data-bs-theme="dark"] .wisdom-quote-card {
        background: #1e293b;
        border-color: #334155;
        border-left-color: #fbbf24 !important;
    }
    .wisdom-quote-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px -4px rgba(15, 23, 42, 0.08);
        border-color: #cbd5e1;
        border-left-color: #d97706 !important;
    }

    /* Print styling */
    @@media print {
        body * {
            visibility: hidden;
        }
        .print-certificate-container, .print-certificate-container * {
            visibility: visible;
        }
        .print-certificate-container {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            border: 2px solid #0ea5e9 !important;
        }
    }

    /* Audit Stream Pagination & Filtering Styles */
    .audit-page-btn {
        min-width: 34px;
        height: 34px;
        padding: 0 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-sm);
        border: 1px solid rgba(14, 165, 233, 0.25);
        background: var(--bg-surface);
        color: var(--text-main);
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        cursor: pointer;
        user-select: none;
    }
    [data-bs-theme="dark"] .audit-page-btn {
        background: var(--bg-surface-secondary);
        border-color: var(--border-subtle);
        color: var(--text-main);
    }
    .audit-page-btn:hover:not(.disabled):not(.active) {
        background: rgba(14, 165, 233, 0.12);
        border-color: #0ea5e9;
        color: #0284c7;
        transform: translateY(-1px);
    }
    [data-bs-theme="dark"] .audit-page-btn:hover:not(.disabled):not(.active) {
        background: rgba(56, 189, 248, 0.15);
        border-color: #38bdf8;
        color: #38bdf8;
    }
    .audit-page-btn.active {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        border-color: #0284c7;
        color: #ffffff !important;
        box-shadow: 0 3px 10px rgba(14, 165, 233, 0.35);
    }
    .audit-page-btn.disabled {
        opacity: 0.38;
        cursor: not-allowed;
        pointer-events: none;
    }
    .audit-row-fade {
        animation: auditRowFadeIn 0.2s ease-in-out;
    }
    @@keyframes auditRowFadeIn {
        from { opacity: 0; transform: translateY(3px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Premium Rising Engineering Roster Styles */
    .roster-section-wrapper {
        background: var(--bg-surface);
        border: 1.5px solid var(--border-subtle);
        border-radius: var(--radius-xl);
        padding: 1.75rem;
        box-shadow: var(--shadow-sm);
    }
    .roster-card-item {
        background: var(--bg-surface-secondary);
        border: 1.5px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 1.2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.85rem;
        height: 100%;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .roster-card-item:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
        border-color: var(--accent-sky);
    }
    .roster-avatar-box {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        color: #ffffff;
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
        flex-shrink: 0;
    }
    .roster-status-pill {
        background: rgba(16, 185, 129, 0.12);
        color: #059669;
        border: 1px solid rgba(16, 185, 129, 0.3);
        font-weight: 700;
        font-size: 0.76rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    [data-bs-theme="dark"] .roster-status-pill {
        background: rgba(16, 185, 129, 0.18);
        color: #34d399;
        border-color: rgba(16, 185, 129, 0.35);
    }
    .roster-pulse-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #10b981;
        box-shadow: 0 0 8px #10b981;
        display: inline-block;
    }
</style>

<!-- HERO BANNER -->
<div class="fame-hero mb-4 p-4 p-md-5 text-white">
    <div class="row align-items-center g-4 position-relative" style="z-index: 2;">
        <div class="col-12 col-lg-8">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-warning text-dark fw-bold px-3 py-1.5"><i class="bi bi-trophy-fill me-1"></i> Auxinzio Honors</span>
                <span class="badge hero-badge-glass px-3 py-1.5 font-monospace">Growth &amp; Excellence Wall</span>
            </div>
            <h1 class="display-6 fw-extrabold text-white mb-2" style="font-family: 'Outfit', sans-serif;">
                Team Wall of Fame &amp; Growth Honors
            </h1>
            <p class="text-white opacity-90 lead fs-6 mb-0" style="max-width: 680px;">
                Celebrating every milestone, empowering continuous learning, and championing the dedication of every engineer across our company.
            </p>
        </div>

        <div class="col-12 col-lg-4 text-lg-end">
            <div class="d-inline-flex flex-column align-items-lg-end p-3 rounded-4 hero-stat-glass">
                <div class="d-flex align-items-baseline gap-1">
                    <span class="display-5 hero-stat-number">@Model.TotalPerfectTasks</span>
                    <span class="fs-5 hero-stat-denom">/ @Model.TotalCompletedTasks</span>
                </div>
                <div class="hero-stat-caption">Flawless Deliveries This Cycle</div>
            </div>
        </div>
    </div>
</div>

<!-- EXECUTIVE METRIC KPI CARDS -->
<div class="row g-3 mb-4">
    <!-- Perfect Tasks -->
    <div class="col-6 col-md-3">
        <div class="stat-card h-100">
            <div>
                <div class="stat-number text-gold">@Model.TotalPerfectTasks</div>
                <div class="stat-label">Flawless Deliveries</div>
            </div>
            <div class="stat-icon stat-icon-amber">
                <i class="bi bi-patch-check-fill"></i>
            </div>
        </div>
    </div>

    <!-- Completed Tasks -->
    <div class="col-6 col-md-3">
        <div class="stat-card h-100">
            <div>
                <div class="stat-number text-emerald">@Model.TotalCompletedTasks</div>
                <div class="stat-label">Total Sprints Completed</div>
            </div>
            <div class="stat-icon stat-icon-emerald">
                <i class="bi bi-check2-circle"></i>
            </div>
        </div>
    </div>

    <!-- Perfection Rate -->
    <div class="col-6 col-md-3">
        <div class="stat-card h-100">
            <div>
                <div class="stat-number text-gold">@Model.OverallSystemPerfectionRate%</div>
                <div class="stat-label">System Quality Index</div>
            </div>
            <div class="stat-icon stat-icon-amber">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
        </div>
    </div>

    <!-- Tracked Team Members -->
    <div class="col-6 col-md-3">
        <div class="stat-card h-100">
            <div>
                <div class="stat-number text-body">@Model.Leaderboard.Count</div>
                <div class="stat-label">Valued Team Contributors</div>
            </div>
            <div class="stat-icon stat-icon-dark">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- DAILY WISDOM & TEAM INSPIRATION STRIP -->
@if (Model.DailyInspirations != null && Model.DailyInspirations.Any())
{
    <div class="inspiration-banner p-4 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3.5 pb-2.5 border-bottom border-secondary border-opacity-10">
            <div class="d-flex align-items-center gap-2.5">
                <span class="badge text-dark fw-extrabold px-3 py-1.5 rounded-pill shadow-xs" style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); font-size: 0.78rem;">
                    <i class="bi bi-lightbulb-fill me-1.5"></i> Inspiration Pillar
                </span>
                <span class="fw-extrabold text-body fs-6 ms-1 font-heading">Engineering Philosophy &amp; Continuous Growth Wisdom</span>
            </div>
            <div class="small text-muted fw-semibold">
                <i class="bi bi-heart-fill text-danger me-1"></i> Every effort counts &bull; No one is left behind
            </div>
        </div>

        <div class="row g-3">
            @foreach (var quote in Model.DailyInspirations.Take(3))
            {
                <div class="col-12 col-md-4">
                    <div class="wisdom-quote-card h-100 d-flex flex-column justify-content-between">
                        <div class="mb-3">
                            <div class="d-flex align-items-start gap-1.5">
                                <i class="bi bi-quote text-warning fs-4 flex-shrink-0 opacity-75" style="margin-top: -4px;"></i>
                                <p class="text-body fw-medium mb-0" style="font-size: 0.92rem; line-height: 1.6;">
                                    @quote.Quote
                                </p>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2.5 border-top border-secondary border-opacity-15 extra-small">
                            <span class="fw-bold d-inline-flex align-items-center gap-1.5" style="color: #d97706; font-size: 0.8rem;">
                                <i class="bi @quote.Icon"></i>@quote.Category
                            </span>
                            <span class="fw-extrabold text-body-secondary" style="font-size: 0.8rem;">— @quote.Author</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- STAR PERFORMER CERTIFICATE SPOTLIGHT -->
@if (Model.StarPerformer != null)
{
    <div class="certificate-frame mb-5 print-certificate-container">
        <!-- Royal Midnight Header Banner Row -->
        <div class="certificate-header-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="position-relative flex-shrink-0">
                    <img src="~/images/award_insignia.jpg" alt="Innovation Excellence Award" class="rounded-circle shadow" style="width: 76px; height: 76px; object-fit: cover; border: 3px solid #f59e0b; background: #ffffff;" />
                    <span class="position-absolute bottom-0 end-0 badge rounded-circle bg-warning text-dark p-1 shadow-sm border border-white" title="#1 Rank">
                        <i class="bi bi-trophy-fill"></i>
                    </span>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-warning text-dark fw-extrabold rounded-pill px-3 py-1 shadow-xs" style="font-size: 0.75rem;">
                            <i class="bi bi-star-fill me-1"></i> Auxinzio Excellence Award
                        </span>
                        <span class="small text-white-50 fw-semibold"><i class="bi bi-calendar-check me-1"></i>@DateTime.Now.ToString("yyyy - MMMM") Cycle</span>
                    </div>
                    <h2 class="fs-4 fw-extrabold text-white mb-0 tracking-wide">
                        EMPLOYEE OF THE WEEK RECOGNITION
                    </h2>
                </div>
            </div>

            <div>
                <button type="button" onclick="window.print()" class="btn btn-warning rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm border-0 text-dark" style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);">
                    <i class="bi bi-printer-fill fs-6"></i>
                    <span>Print Official Award</span>
                </button>
            </div>
        </div>

        <!-- High-Contrast Crisp Card Body -->
        <div class="p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-12 col-lg-8">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-award-fill text-warning fs-5"></i>
                        <p class="text-primary small text-uppercase fw-extrabold tracking-wider mb-0" style="letter-spacing: 1.2px;">PROUDLY PRESENTED TO:</p>
                    </div>
                    <h1 class="display-4 fw-extrabold mb-3 text-capitalize text-body" style="font-size: 2.75rem; letter-spacing: -0.5px;">
                        @Model.StarPerformer.EmployeeName
                    </h1>
                    <p class="lead fs-6 text-body-secondary mb-4" style="line-height: 1.7; max-width: 720px;">
                        Awarded in formal recognition of exemplary dedication, technical craftsmanship, and outstanding commitment to excellence — successfully completing <strong>@Model.StarPerformer.PerfectTasksCount task(s)</strong> with a 
                        <strong>@Model.StarPerformer.PerfectRate% Quality Score</strong> and zero recorded project delays.
                    </p>

                    <!-- Personal Motivational Affirmation -->
                    @if (!string.IsNullOrEmpty(Model.StarPerformer.MotivationalQuote))
                    {
                        <div class="p-3.5 rounded-3 mb-4 d-flex align-items-center gap-3" style="background: var(--bs-body-bg, #f8fafc); border: 1px solid var(--bs-border-color, #e2e8f0); border-left: 4px solid #f59e0b;">
                            <div class="rounded-circle text-amber d-flex align-items-center justify-content-center flex-shrink-0 shadow-xs" style="width: 42px; height: 42px; background: rgba(245, 158, 11, 0.15); color: #d97706;">
                                <i class="bi bi-quote fs-4"></i>
                            </div>
                            <div>
                                <div class="small fw-semibold text-body fst-italic mb-0.5">"@Model.StarPerformer.MotivationalQuote"</div>
                                <div class="extra-small text-muted">— <strong class="text-body-secondary">@Model.StarPerformer.MotivationalAuthor</strong> &bull; <span class="fw-bold" style="color: #d97706;">@Model.StarPerformer.GrowthMindsetNote</span></div>
                            </div>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2.5 pt-1">
                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-2 fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs" style="font-size: 0.82rem;">
                            <i class="bi bi-check-circle-fill text-success"></i> @Model.StarPerformer.CompletedTasksCount Completed Sprints
                        </span>
                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs" style="font-size: 0.82rem;">
                            <i class="bi bi-star-fill text-warning"></i> @Model.StarPerformer.PerfectTasksCount Flawless Tasks
                        </span>
                        <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs" style="font-size: 0.82rem;">
                            <i class="bi bi-building-fill text-primary"></i> @(Model.StarPerformer.AssignedCompanies.Any() ? string.Join(", ", Model.StarPerformer.AssignedCompanies) : "Enterprise Portfolio")
                        </span>
                    </div>
                </div>

                <div class="col-12 col-lg-4 text-center text-lg-end">
                    <div class="quality-index-card p-4 rounded-4 text-center shadow-md position-relative overflow-hidden d-inline-block" style="min-width: 240px;">
                        <div class="badge bg-primary text-white fw-extrabold px-3 py-1 rounded-pill shadow-xs mb-2" style="font-size: 0.68rem; letter-spacing: 0.8px;">
                            <i class="bi bi-patch-check-fill me-1"></i> VERIFIED ACCURACY
                        </div>
                        <div class="extra-small text-muted text-uppercase fw-bold tracking-wider mb-1" style="letter-spacing: 1px;">Quality Index</div>
                        <div class="display-3 fw-extrabold text-primary mb-0 font-monospace" style="color: #1d4ed8 !important; text-shadow: 0 2px 4px rgba(29, 78, 216, 0.12);">@Model.StarPerformer.PerfectRate%</div>
                        <div class="small fw-bold text-success mt-1 d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-shield-fill-check"></i> Flawless Benchmark
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- WEEKLY CONTRIBUTOR HONORS & WALL OF FAME ROSTER -->
<div class="card border-0 shadow-sm glass-card p-4 p-md-5 mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <h3 class="fw-bold mb-1 d-flex align-items-center gap-2 text-body" style="font-family: 'Outfit', sans-serif;">
                <i class="bi bi-stars text-gold"></i>
                <span>Team Recognition &amp; Growth Wall of Fame</span>
            </h3>
            <p class="text-muted small mb-0">Honoring every team member's persistent effort, learning momentum, and positive contributions.</p>
        </div>
        <a asp-action="Index" class="btn btn-dark-carbon btn-sm d-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Task Dashboard</span>
        </a>
    </div>

    @if (Model.Leaderboard == null || !Model.Leaderboard.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-trophy text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold text-body">Welcoming New Milestones</h5>
            <p class="text-muted">Start creating and working on sprint tasks to see team recognition here.</p>
        </div>
    }
    else
    {
        var activePerformers = Model.Leaderboard.Where(e => e.CompletedTasksCount > 0 || e.Rank <= 3).ToList();
        var risingMembers = Model.Leaderboard.Where(e => e.CompletedTasksCount == 0 && e.Rank > 3).ToList();

        <!-- SECTION 1: TOP SPRINT PERFORMERS & PODIUM HONORS -->
        if (activePerformers.Any())
        {
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-trophy-fill text-gold fs-5"></i>
                    <h3 class="h5 fw-bold mb-0 text-body" style="font-family: 'Outfit', sans-serif;">Top Sprint Performers &amp; Honors</h3>
                    <span class="badge bg-warning bg-opacity-15 text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 extra-small fw-bold">@activePerformers.Count Recognized</span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                @foreach (var emp in activePerformers)
                {
                    var isRank1 = emp.Rank == 1 && emp.PerfectTasksCount > 0;
                    var isRank2 = emp.Rank == 2 && emp.CompletedTasksCount > 0;
                    var isRank3 = emp.Rank == 3 && emp.CompletedTasksCount > 0;

                    var cardClass = isRank1 ? "podium-card-rank-1" :
                                    isRank2 ? "podium-card-rank-2" :
                                    isRank3 ? "podium-card-rank-3" : "";

                    var haloClass = isRank1 ? "avatar-halo-gold" :
                                    isRank2 ? "avatar-halo-silver" :
                                    isRank3 ? "avatar-halo-bronze" : 
                                    (emp.CompletedTasksCount > 0 ? "avatar-halo-standard" : "avatar-halo-emerald");

                    var rankBadgeText = isRank1 ? "🥇 #1 Champion" :
                                        isRank2 ? "🥈 #2 Quality Lead" :
                                        isRank3 ? "🥉 #3 Velocity Lead" : $"🌟 {emp.EncouragementTag}";

                    var rankBadgeStyle = isRank1 ? "badge-royal-gold" :
                                         isRank2 ? "bg-info bg-opacity-25 text-primary border border-info" :
                                         isRank3 ? "bg-warning bg-opacity-25 text-dark border border-warning" : "bg-body-secondary text-body border border-secondary border-opacity-25";

                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="podium-card h-100 p-3 d-flex flex-column justify-content-between @cardClass shadow-sm" style="border-radius: 16px;">
                            <div>
                                <!-- Header Info -->
                                <div class="d-flex justify-content-between align-items-start mb-2.5">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="avatar-halo @haloClass">
                                            @(string.IsNullOrEmpty(emp.EmployeeName) ? "?" : emp.EmployeeName.Substring(0, 1))
                                        </div>
                                        <div>
                                            <h4 class="fs-6 fw-bold mb-0.5 text-body" style="font-family: 'Outfit', sans-serif;">@emp.EmployeeName</h4>
                                            @if (isRank1)
                                            {
                                                <span class="badge bg-warning text-dark fw-bold border border-warning-subtle px-2 py-0.5 rounded-pill" style="font-size: 0.7rem; background-color: #fef3c7; color: #92400e; border: 1px solid #fcd34d;">
                                                    <i class="bi bi-star-fill me-1 text-warning"></i>@emp.AwardTitle
                                                </span>
                                            }
                                            else if (isRank2)
                                            {
                                                <span class="badge bg-info text-dark fw-bold border border-info-subtle px-2 py-0.5 rounded-pill" style="font-size: 0.7rem; background-color: #e0f2fe; color: #0369a1; border: 1px solid #7dd3fc;">
                                                    <i class="bi bi-award-fill me-1 text-info"></i>@emp.AwardTitle
                                                </span>
                                            }
                                            else if (isRank3)
                                            {
                                                <span class="badge bg-warning text-dark fw-bold border border-warning-subtle px-2 py-0.5 rounded-pill" style="font-size: 0.7rem; background-color: #ffedd5; color: #c2410c; border: 1px solid #fdba74;">
                                                    <i class="bi bi-lightning-charge-fill me-1 text-warning"></i>@emp.AwardTitle
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-royal-gold rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                                                    @emp.AwardTitle
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <span class="badge @rankBadgeStyle px-2.5 py-1 rounded-pill fw-bold extra-small shadow-2xs">
                                        @rankBadgeText
                                    </span>
                                </div>

                                <p class="text-secondary extra-small mb-2.5" style="line-height: 1.45;">@emp.AwardDescription</p>

                                <!-- Personalized Motivational Affirmation Box -->
                                @if (!string.IsNullOrEmpty(emp.MotivationalQuote))
                                {
                                    <div class="quote-affirmation-card p-2.5 rounded-3 mb-2.5 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(254, 243, 199, 0.45) 0%, rgba(255, 255, 255, 0.95) 100%); border: 1px solid rgba(245, 158, 11, 0.3); border-left: 3.5px solid #f59e0b; box-shadow: 0 2px 8px rgba(245, 158, 11, 0.06);">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="bi bi-quote text-warning fs-5 flex-shrink-0" style="line-height: 1; opacity: 0.85;"></i>
                                            <div class="w-100">
                                                <p class="mb-1 text-dark fst-italic fw-medium" style="font-size: 0.78rem; line-height: 1.4; letter-spacing: -0.01em;">
                                                    "@emp.MotivationalQuote"
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center extra-small pt-1 border-top border-warning border-opacity-25 mt-1" style="font-size: 0.7rem;">
                                                    <span class="fw-bold" style="color: #d97706;"><i class="bi bi-stars me-1 text-warning"></i>@emp.EncouragementTag</span>
                                                    <span class="fw-bold text-secondary">— @emp.MotivationalAuthor</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Perfection / Velocity Meter -->
                                <div class="p-2.5 rounded-3 mb-2.5" style="background: rgba(15, 23, 42, 0.03); border: 1px solid rgba(148, 163, 184, 0.15);">
                                    <div class="d-flex justify-content-between align-items-center text-muted extra-small fw-bold mb-1">
                                        <span class="text-uppercase letter-spacing-1" style="font-size: 0.68rem;"><i class="bi bi-speedometer2 me-1 text-primary"></i>Sprint Quality &amp; Focus</span>
                                        <span class="fw-bold font-monospace" style="color: #d97706; font-size: 0.8rem;">@(emp.TotalAssignedTasks > 0 ? $"{emp.PerfectRate}%" : "100% Ready")</span>
                                    </div>
                                    <div class="task-progress-track rounded-pill" style="height: 6px; background: rgba(226, 232, 240, 0.8);">
                                        <div class="task-progress-fill rounded-pill" style="width: @(emp.TotalAssignedTasks > 0 ? (emp.PerfectRate > 0 ? emp.PerfectRate : 25) : 100)%; background: linear-gradient(90deg, #f59e0b 0%, #10b981 100%);"></div>
                                    </div>
                                </div>

                                <!-- Tasks List -->
                                <div class="mb-2.5">
                                    @if (emp.PerfectlyCompletedTasks.Any())
                                    {
                                        <div class="extra-small fw-bold text-uppercase text-muted letter-spacing-1 mb-1.5" style="font-size: 0.68rem;">
                                            <i class="bi bi-shield-check text-emerald me-1"></i>Flawlessly Delivered @(emp.PerfectlyCompletedTasks.Count == 1 ? "Task" : "Tasks") (@emp.PerfectlyCompletedTasks.Count):
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var taskName in emp.PerfectlyCompletedTasks.Take(3))
                                            {
                                                <span class="badge bg-white text-dark border border-emerald-subtle rounded-pill px-2 py-1 shadow-2xs d-inline-flex align-items-center gap-1" style="border-color: #a7f3d0 !important; font-weight: 600; font-size: 0.72rem;">
                                                    <i class="bi bi-check-circle-fill text-emerald"></i>
                                                    <span class="text-truncate" style="max-width: 150px;">@taskName</span>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Card Footer with Proper Singular/Plural Grammar -->
                            <div class="pt-2.5 border-top border-secondary border-opacity-20 d-flex align-items-center justify-content-between extra-small text-secondary">
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-check2-all text-emerald"></i>
                                    <span><strong class="text-body font-monospace">@emp.CompletedTasksCount</strong> @(emp.CompletedTasksCount == 1 ? "Task Finished" : "Tasks Finished")</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <span><strong class="text-body font-monospace">@emp.PerfectTasksCount</strong> @(emp.PerfectTasksCount == 1 ? "Flawless Record" : "Flawless Records")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- SECTION 2: RISING ENGINEERING ROSTER (DIRECTORY & ACTIVE SPRINTS) -->
        if (risingMembers.Any())
        {
            <div class="roster-section-wrapper mt-4 mb-5">
                <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between pb-3 mb-4 border-bottom border-secondary border-opacity-15 gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="form-header-icon-box shadow-sm" style="background: linear-gradient(135deg, #0284c7 0%, #7c3aed 100%); width: 46px; height: 46px; border-radius: 12px;">
                            <i class="bi bi-rocket-takeoff-fill fs-5"></i>
                        </div>
                        <div>
                            <h4 class="h5 fw-bold mb-0 text-main" style="font-family: var(--font-heading);">Rising Engineering Roster</h4>
                            <span class="small text-muted fw-semibold">Active Sprint Journey &amp; Skill Growth Directory</span>
                        </div>
                    </div>
                    <div>
                        <span class="badge badge-royal-gold rounded-pill px-3.5 py-2 font-monospace" style="font-size: 0.82rem;">
                            <i class="bi bi-people-fill me-1.5"></i>@risingMembers.Count Team Members Onboarded
                        </span>
                    </div>
                </div>

                <div class="row g-3">
                    @foreach (var emp in risingMembers)
                    {
                        var compText = emp.AssignedCompanies != null && emp.AssignedCompanies.Any() 
                            ? string.Join(", ", emp.AssignedCompanies) 
                            : "Auxinzio Team";

                        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                            <div class="roster-card-item">
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    <div class="roster-avatar-box">
                                        @(string.IsNullOrEmpty(emp.EmployeeName) ? "?" : emp.EmployeeName.Substring(0, 1).ToUpper())
                                    </div>
                                    <span class="roster-status-pill">
                                        <span class="roster-pulse-dot"></span>
                                        <span>Active Sprint</span>
                                    </span>
                                </div>

                                <div>
                                    <h5 class="fw-bold text-main mb-1.5 text-truncate" style="font-size: 0.98rem; font-family: var(--font-heading);" title="@emp.EmployeeName">
                                        @emp.EmployeeName
                                    </h5>
                                    <span class="company-badge-chip text-truncate w-100" title="@compText">
                                        <i class="bi bi-buildings text-sky"></i>
                                        <span class="text-truncate">@compText</span>
                                    </span>
                                </div>

                                <div class="d-flex align-items-center justify-content-between text-muted extra-small pt-2 border-top border-secondary border-opacity-15">
                                    <span><i class="bi bi-lightning-charge-fill text-gold me-1"></i>Sprint Contributor</span>
                                    <span class="font-monospace fw-bold text-emerald">Ready</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- HR MASTER ACTIVITY & AUDIT STREAM -->
<div class="card border-0 shadow-lg glass-card mb-5 overflow-hidden">
    <div class="card-header bg-body-tertiary p-3 p-md-4 border-bottom border-secondary border-opacity-25 d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div>
            <h4 class="fw-bold mb-1 d-flex align-items-center gap-2 text-body" style="font-family: 'Outfit', sans-serif;">
                <i class="bi bi-shield-check text-gold"></i>
                <span>Executive Activity &amp; Audit Stream</span>
            </h4>
            <p class="text-muted small mb-0">Real-time line-by-line audit tracking individual team actions, status progressions, and delay reports.</p>
        </div>

        @if (Model.AllActivityLogs != null && Model.AllActivityLogs.Any())
        {
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Live Search Filter -->
                <div class="input-group input-group-sm rounded-pill overflow-hidden border border-secondary border-opacity-25 shadow-sm bg-body p-0.5" style="min-width: 220px; max-width: 280px;">
                    <span class="input-group-text bg-transparent border-0 ps-3 pe-1"><i class="bi bi-search text-primary"></i></span>
                    <input type="text" id="auditSearchInput" class="form-control bg-transparent border-0 shadow-none ps-1 text-body" placeholder="Search contributor, task, log..." aria-label="Search audit stream" />
                </div>

                <!-- Action Filter Dropdown -->
                <select id="auditActionFilter" class="form-select form-select-sm rounded-pill bg-body border-secondary border-opacity-25 shadow-sm px-3 text-body" style="width: auto; min-width: 150px;">
                    <option value="">All Actions</option>
                    <option value="Task Created">Task Created</option>
                    <option value="Status Changed">Status Changed</option>
                    <option value="Task Edited">Task Edited</option>
                    <option value="Project Delay / Error Logged">Delay / Error Logged</option>
                </select>

                <!-- Page Size Selector -->
                <div class="d-flex align-items-center gap-1.5 bg-body border border-secondary border-opacity-25 rounded-pill px-3 py-1 shadow-sm">
                    <label for="auditPageSize" class="small text-muted mb-0 fw-semibold">Show:</label>
                    <select id="auditPageSize" class="form-select form-select-sm border-0 bg-transparent py-0 ps-1 pe-3 fw-bold text-body shadow-none" style="font-size: 0.82rem; width: auto; cursor: pointer; border-radius: 0 !important;">
                        <option value="5" selected>5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>

                <!-- Total Count Badge -->
                <span class="badge badge-royal-gold rounded-pill px-3 py-2 font-monospace" id="auditTotalCountBadge">
                    @Model.AllActivityLogs.Count Recorded Events
                </span>
            </div>
        }
        else
        {
            <span class="badge badge-royal-gold rounded-pill px-3 py-2 font-monospace">
                0 Recorded Events
            </span>
        }
    </div>

    <div class="card-body p-0">
        @if (Model.AllActivityLogs != null && Model.AllActivityLogs.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                    <thead class="table-custom text-uppercase font-monospace extra-small border-bottom border-secondary border-opacity-25">
                        <tr>
                            <th class="ps-4 py-3">Timestamp</th>
                            <th class="py-3">Contributor</th>
                            <th class="py-3">Task Details</th>
                            <th class="py-3">Action</th>
                            <th class="py-3">Status Transition</th>
                            <th class="py-3">Progress</th>
                            <th class="py-3 pe-4">Delay / Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="auditTableBody">
                        @foreach (var log in Model.AllActivityLogs)
                        {
                            var searchableText = $"{log.LoggedAt:MMM dd yyyy HH:mm:ss} {log.EmployeeName} #{log.TaskId:D3} {log.TaskName} {log.ActionType} {log.OldStatus} {log.NewStatus} {log.Progress}% {log.DelayReason} {log.ErrorDetails}";
                            <tr class="audit-row border-bottom border-secondary border-opacity-10" 
                                data-action="@log.ActionType"
                                data-search="@searchableText">
                                <td class="ps-4 text-muted font-monospace extra-small">
                                    <i class="bi bi-clock me-1 text-gold"></i>@log.LoggedAt.ToString("MMM dd, yyyy HH:mm:ss")
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle-sm" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                             @(!string.IsNullOrEmpty(log.EmployeeName) ? log.EmployeeName.Substring(0, 1) : "?")
                                        </div>
                                        <span class="fw-bold text-body">@log.EmployeeName</span>
                                    </div>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@log.TaskId" class="fw-bold text-gold text-decoration-none">
                                        #@log.TaskId.ToString("D3") - @log.TaskName
                                    </a>
                                </td>
                                <td>
                                    @if (log.ActionType != null && log.ActionType.Contains("Rollover"))
                                    {
                                        <span class="badge bg-amber-subtle text-amber border border-amber-subtle px-2.5 py-1.5 fw-bold rounded-pill shadow-sm" style="background-color: #fef3c7; color: #b45309; border: 1px solid #fcd34d; font-size: 0.78rem;">
                                            <i class="bi bi-arrow-repeat me-1"></i>@log.ActionType
                                        </span>
                                    }
                                    else if (log.ActionType != null && (log.ActionType.Contains("Created") || log.ActionType.Contains("Add")))
                                    {
                                        <span class="badge bg-emerald-subtle text-emerald border border-emerald-subtle px-2.5 py-1.5 fw-bold rounded-pill shadow-sm" style="background-color: #d1fae5; color: #047857; border: 1px solid #6ee7b7; font-size: 0.78rem;">
                                            <i class="bi bi-plus-circle-fill me-1"></i>@log.ActionType
                                        </span>
                                    }
                                    else if (log.ActionType != null && (log.ActionType.Contains("Status") || log.ActionType.Contains("Update")))
                                    {
                                        <span class="badge bg-sky-subtle text-sky border border-sky-subtle px-2.5 py-1.5 fw-bold rounded-pill shadow-sm" style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #7dd3fc; font-size: 0.78rem;">
                                            <i class="bi bi-arrow-left-right me-1"></i>@log.ActionType
                                        </span>
                                    }
                                    else if (log.ActionType != null && log.ActionType.Contains("Progress"))
                                    {
                                        <span class="badge bg-purple-subtle text-purple border border-purple-subtle px-2.5 py-1.5 fw-bold rounded-pill shadow-sm" style="background-color: #f3e8ff; color: #6b21a8; border: 1px solid #d8b4fe; font-size: 0.78rem;">
                                            <i class="bi bi-bar-chart-fill me-1"></i>@log.ActionType
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-royal-gold px-2.5 py-1.5 rounded-pill shadow-sm" style="font-size: 0.78rem;">
                                            @log.ActionType
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.OldStatus) || !string.IsNullOrEmpty(log.NewStatus))
                                    {
                                        <span class="text-muted small">@(log.OldStatus ?? "New")</span>
                                        <i class="bi bi-arrow-right mx-1 text-gold"></i>
                                        <span class="fw-bold text-body small">@(log.NewStatus ?? "Updated")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="task-progress-track flex-grow-1" style="width: 45px; height: 6px;">
                                             <div class="task-progress-fill" style="width: @log.Progress%;"></div>
                                        </div>
                                        <span class="fw-bold text-body font-monospace extra-small">@log.Progress%</span>
                                    </div>
                                </td>
                                <td class="pe-4">
                                    @if (!string.IsNullOrEmpty(log.DelayReason))
                                    {
                                        <div class="text-danger fw-semibold extra-small">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@log.DelayReason
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(log.ErrorDetails))
                                    {
                                        <small class="text-muted d-block extra-small">@log.ErrorDetails</small>
                                    }
                                    @if (string.IsNullOrEmpty(log.DelayReason) && string.IsNullOrEmpty(log.ErrorDetails))
                                    {
                                        <span class="text-emerald extra-small"><i class="bi bi-check2 me-1"></i>Flawless</span>
                                    }
                                </td>
                            </tr>
                        }
                        <!-- No matching search results row -->
                        <tr id="auditNoResultsRow" style="display: none;">
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-search fs-3 text-secondary d-block mb-2"></i>
                                <h6 class="fw-bold text-body mb-1">No Matching Audit Events Found</h6>
                                <p class="small mb-0">Try changing your search keywords or resetting the action filter.</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Card Footer Pagination -->
            <div class="card-footer bg-body-tertiary p-3 border-top border-secondary border-opacity-25 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3" id="auditPaginationFooter">
                <div class="small text-muted font-monospace" id="auditPaginationInfo">
                    Showing <span class="fw-bold text-body" id="auditPageStart">1</span> to <span class="fw-bold text-body" id="auditPageEnd">5</span> of <span class="fw-bold text-body" id="auditPageTotal">@Model.AllActivityLogs.Count</span> recorded events
                </div>

                <nav aria-label="Audit stream navigation">
                    <ul class="pagination pagination-sm mb-0 gap-1" id="auditPaginationNav">
                        <!-- Rendered by JavaScript -->
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-journal-x fs-2 text-secondary d-block mb-2"></i>
                <h6 class="fw-bold text-body">No Activity Logs Recorded Yet</h6>
                <p class="mb-0 small">When tasks are created, updated, or completed, individual activity logs will appear here in real-time.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tableBody = document.getElementById("auditTableBody");
            if (!tableBody) return;

            const rows = Array.from(tableBody.querySelectorAll(".audit-row"));
            const searchInput = document.getElementById("auditSearchInput");
            const actionFilter = document.getElementById("auditActionFilter");
            const pageSizeSelect = document.getElementById("auditPageSize");
            const paginationNav = document.getElementById("auditPaginationNav");
            const pageStartEl = document.getElementById("auditPageStart");
            const pageEndEl = document.getElementById("auditPageEnd");
            const pageTotalEl = document.getElementById("auditPageTotal");
            const totalCountBadge = document.getElementById("auditTotalCountBadge");
            const noResultsRow = document.getElementById("auditNoResultsRow");
            const paginationFooter = document.getElementById("auditPaginationFooter");

            let currentPage = 1;
            let pageSize = parseInt(pageSizeSelect ? pageSizeSelect.value : "5", 10) || 5;
            let filteredRows = [...rows];

            function filterRows() {
                const query = (searchInput ? searchInput.value : "").trim().toLowerCase();
                const action = (actionFilter ? actionFilter.value : "").trim().toLowerCase();

                filteredRows = rows.filter(row => {
                    const text = (row.getAttribute("data-search") || row.textContent).toLowerCase();
                    const rowAction = (row.getAttribute("data-action") || "").toLowerCase();

                    const matchesQuery = !query || text.includes(query);
                    const matchesAction = !action || rowAction.includes(action);

                    return matchesQuery && matchesAction;
                });

                currentPage = 1;
                render();
            }

            function render() {
                const total = filteredRows.length;
                const totalPages = Math.ceil(total / pageSize) || 1;
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = Math.min(startIndex + pageSize, total);

                // Hide all rows first
                rows.forEach(r => r.style.display = "none");

                if (total === 0) {
                    if (noResultsRow) noResultsRow.style.display = "";
                    if (paginationFooter) paginationFooter.style.display = "none";
                    if (totalCountBadge) totalCountBadge.textContent = `0 of ${rows.length} Events`;
                    return;
                } else {
                    if (noResultsRow) noResultsRow.style.display = "none";
                    if (paginationFooter) paginationFooter.style.display = "flex";
                }

                // Display rows for current page with fade effect
                for (let i = startIndex; i < endIndex; i++) {
                    const row = filteredRows[i];
                    row.style.display = "";
                    row.classList.remove("audit-row-fade");
                    void row.offsetWidth; // trigger reflow
                    row.classList.add("audit-row-fade");
                }

                // Update text counters
                if (pageStartEl) pageStartEl.textContent = startIndex + 1;
                if (pageEndEl) pageEndEl.textContent = endIndex;
                if (pageTotalEl) pageTotalEl.textContent = total;
                if (totalCountBadge) {
                    totalCountBadge.textContent = total === rows.length
                        ? `${total} Recorded Events`
                        : `${total} of ${rows.length} Events`;
                }

                // Render pagination buttons
                renderPaginationButtons(totalPages);
            }

            function renderPaginationButtons(totalPages) {
                if (!paginationNav) return;
                paginationNav.innerHTML = "";

                if (totalPages <= 1) {
                    paginationNav.style.display = "none";
                    return;
                }
                paginationNav.style.display = "flex";

                function createBtn(label, pageNum, isDisabled, isActive, title) {
                    const li = document.createElement("li");
                    li.className = "page-item";
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = `audit-page-btn ${isActive ? 'active' : ''} ${isDisabled ? 'disabled' : ''}`;
                    btn.innerHTML = label;
                    if (title) btn.title = title;
                    if (!isDisabled && !isActive) {
                        btn.addEventListener("click", function (e) {
                            e.preventDefault();
                            currentPage = pageNum;
                            render();
                        });
                    }
                    li.appendChild(btn);
                    return li;
                }

                // First & Prev buttons
                paginationNav.appendChild(createBtn('<i class="bi bi-chevron-double-left"></i>', 1, currentPage === 1, false, "First Page"));
                paginationNav.appendChild(createBtn('<i class="bi bi-chevron-left"></i>', currentPage - 1, currentPage === 1, false, "Previous Page"));

                // Dynamic page window
                const maxButtons = 5;
                let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
                let endPage = Math.min(totalPages, startPage + maxButtons - 1);
                if (endPage - startPage + 1 < maxButtons) {
                    startPage = Math.max(1, endPage - maxButtons + 1);
                }

                if (startPage > 1) {
                    paginationNav.appendChild(createBtn("1", 1, false, currentPage === 1));
                    if (startPage > 2) {
                        const ellipsis = document.createElement("li");
                        ellipsis.className = "page-item disabled px-1 d-flex align-items-center text-muted small";
                        ellipsis.innerHTML = "…";
                        paginationNav.appendChild(ellipsis);
                    }
                }

                for (let p = startPage; p <= endPage; p++) {
                    paginationNav.appendChild(createBtn(p.toString(), p, false, p === currentPage));
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        const ellipsis = document.createElement("li");
                        ellipsis.className = "page-item disabled px-1 d-flex align-items-center text-muted small";
                        ellipsis.innerHTML = "…";
                        paginationNav.appendChild(ellipsis);
                    }
                    paginationNav.appendChild(createBtn(totalPages.toString(), totalPages, false, currentPage === totalPages));
                }

                // Next & Last buttons
                paginationNav.appendChild(createBtn('<i class="bi bi-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false, "Next Page"));
                paginationNav.appendChild(createBtn('<i class="bi bi-chevron-double-right"></i>', totalPages, currentPage === totalPages, false, "Last Page"));
            }

            // Bind Event Listeners
            if (searchInput) {
                searchInput.addEventListener("input", filterRows);
            }
            if (actionFilter) {
                actionFilter.addEventListener("change", filterRows);
            }
            if (pageSizeSelect) {
                pageSizeSelect.addEventListener("change", function () {
                    pageSize = parseInt(this.value, 10) || 5;
                    currentPage = 1;
                    render();
                });
            }

            // Initial Render
            filterRows();
        });
    </script>
}
